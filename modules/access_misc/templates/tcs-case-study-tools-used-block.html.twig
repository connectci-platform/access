{#
/**
 * @file
 * Template for the TCS Case Study Tools Used block.
 *
 * Available variables:
 * - tools: Array of tool data with name, logo_url, and link_url.
 * - resources: Array of ACCESS resource data with name and url.
 */
#}

<div class="tcs-tools-used-block">
  <h2 class="h4 text-base px-2 font-semibold leading-5 text-white m-0 bg-md-teal uppercase w-full mb-1 mt-4">Access Tools</h2>
  <div class="tcs-tools-used-block__item  grid grid-cols-2 gap-4 my-3">
    {% for tool in tools %}
        {% if tool.link_url %}
          <a href="{{ tool.link_url }}" target="_blank" rel="noopener noreferrer" class="block">
        {% endif %}
        {% if tool.logo_url %}
          <img
            src="{{ tool.logo_url }}"
            alt="{{ tool.name }}"
            class="tcs-tools-used-block__logo"
          />
        {% else %}
          <span class="tcs-tools-used-block__name">{{ tool.name }}</span>
        {% endif %}
        {% if tool.link_url %}
          </a>
        {% endif %}
    {% endfor %}
  </div>
  <h2 class="h4 text-base px-2 font-semibold leading-5 text-white m-0 bg-md-teal uppercase w-full mb-2 mt-4">Allocation Information</h2>
  {% if resources %}
  <div class="field field--name-field-tcs-access-resource field--type-entity-reference field--label-inline clearfix">
    <div class="field__label">ACCESS Resource</div>
      {% for resource in resources %}{{ loop.first ? '' : ', ' }}<a href="{{ resource.url }}">{{ resource.name }}</a>{% endfor %}
  </div>
  {% endif %}
</div>
