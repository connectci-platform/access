{#
/**
 * @file
 * Theme implementation for webform element help.
 *
 * Uses a proper <button> element instead of <span role="button"> for
 * better accessibility and native keyboard support.
 *
 * Available variables
 * - element: form element
 * - help: Help content.
 * - help_icon: Help icon.
 *
 * @see template_preprocess_webform_element_help()
 *
 * @ingroup themeable
 */
#}
{% apply spaceless %}
{{ attach_library('webform/webform.element.help') }}
{#
  Convert span attributes to button-appropriate attributes.
  Remove role="tooltip" since we're using a button.
  Keep aria-label, data-webform-help, class, and tabindex.
#}
{% set button_attributes = attributes.removeClass('webform-element-help').addClass('webform-element-help') %}
<button type="button"{{ button_attributes.removeAttribute('role') }}><span aria-hidden="true">?</span></button>
{% endapply %}
