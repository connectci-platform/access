/**
 * Clear out cc_rollout roles.
 */
function access_misc_update_10015() {
  $query = \Drupal::database()->delete('user__roles');
  $query->condition('roles_target_id', 'cc_rollout');
  $query->execute();
}

/**
 * Update nodes set to Access to be 'sent to all affiliates' (D8-2015).
 */
function access_misc_update_10016() {
  $connection = \Drupal::database();
  $query = $connection->select('node__field_domain_access', 'nfa');
  $query->fields('nfa', ['entity_id']);
  $query->condition('nfa.field_domain_access_target_id', SiteTools::DOMAIN_ACCESS_SUPPORT);
  $result = $query->execute()->fetchCol();
  foreach ($result as $row) {
    $connection->delete('node__field_domain_access')
      ->condition('entity_id', $row)
      ->execute();
    $connection->update('node__field_domain_all_affiliates')
      ->fields(['field_domain_all_affiliates_value' => 1])
      ->condition('entity_id', $row)
      ->execute();
  }
}

/**
 * Update MATCH and Announcment nodes to amp_cyberinfrastructure_org domain.
 */
function access_misc_update_10017() {
  // Entity lookup all nodes match_engagement nids.
  $match_nids = \Drupal::entityQuery('node')
    ->condition('type', 'match_engagement')
    ->accessCheck(FALSE)
    ->execute();
  $announcment_nids = \Drupal::entityQuery('node')
    ->condition('type', 'access_news')
    ->accessCheck(FALSE)
    ->execute();
  $connection = \Drupal::database();
  $connection->delete('node__field_domain_access')
    ->condition('bundle', 'match_engagement')
    ->execute();
  foreach ($match_nids as $row) {
    $node = \Drupal::entityTypeManager()->getStorage('node')->load($row);
    $revision_id = $node->get('vid')->value;
    $connection->insert('node__field_domain_access')
      ->fields([
        'bundle' => 'match_engagement',
        'deleted' => 0,
        'entity_id' => $row,
        'revision_id' => $revision_id,
        'langcode' => 'en',
        'delta' => 0,
        'field_domain_access_target_id' => SiteTools::DOMAIN_ACCESS_SUPPORT,
      ])
      ->execute();
  }
  $connection->delete('node__field_domain_access')
    ->condition('bundle', 'access_news')
    ->execute();
  foreach ($announcment_nids as $row) {
    $node = \Drupal::entityTypeManager()->getStorage('node')->load($row);
    $revision_id = $node->get('vid')->value;
    $connection->insert('node__field_domain_access')
      ->fields([
        'bundle' => 'access_news',
