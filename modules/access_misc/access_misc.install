 */
function access_misc_update_10013(&$sandbox) {
  // ACCESS Video Learning page node.
  $nid = 5950;
  $format = 'full_no_editor';
  $body = <<<EOT
    <div class="grid grid-cols-1 md--grid-cols-3 ml--grid-cols-4 gap-5">
  <div class="col-1 col-span-3 row-span-2">

    <p class="prose text-dark-teal text-2xl leading-9 mb-10">
      These videos are designed to introduce the ACCESS program which helps
      researchers and educators use national advanced computing systems and
      services. Each playlist contains a number of short videos explaining a
      component of the ACCESS ecosystem. You can watch the whole playlist or
      find an explanation of a single topic.
    </p>

    <section class="border-yellow border-b-8 mb-10">
