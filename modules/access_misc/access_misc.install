/**
 * Delete old regions from users.
 */
function access_misc_update_10029() {
  $old_regions = [
    '324',
    '314',
    '326',
  ];

  foreach ($old_regions as $region_id) {
    $query = \Drupal::database()->delete('user__field_region');
    $query->condition('field_region_target_id', $region_id, '=');
    $result = $query->execute();
  }

}

/**
 * Remove ag taxonomy terms no longer assigned to a node.
 */
function access_misc_update_10030() {
  $query = \Drupal::database()->select('taxonomy_term_data', 't');
  $query->fields('t', ['tid']);
  $query->condition('t.vid', 'affinity_groups');
  $result = $query->execute()->fetchAll();

  foreach ($result as $item) {
    $tid = $item->tid;

    $query = \Drupal::database()->select('node__field_affinity_group', 'nag');
    $query->fields('nag', ['entity_id']);
    $query->condition('nag.field_affinity_group_target_id', $tid);
    $node_match = $query->execute()->fetchField();

    if ($node_match === FALSE) {
      // Entity load tid.
      $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid);
      // Delete term.
      if ($term) {
        $term->delete();
      }
    }
  }
}

/**
 * Move appverse_software tags that match topics to field_appverse_topics.
 */
function access_misc_update_10031(&$sandbox) {
  if (!isset($sandbox['nids'])) {
    $sandbox['nids'] = \Drupal::entityQuery('node')
      ->condition('type', 'appverse_software')
      ->accessCheck(FALSE)
      ->execute();
    $sandbox['total'] = count($sandbox['nids']);
    $sandbox['moved'] = 0;
  }

  // Process 25 nodes per batch.
  $batch = array_splice($sandbox['nids'], 0, 25);

  foreach ($batch as $nid) {
    $node = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
    if ($node) {
      // The presave hook handles the actual tag-to-topic migration.
      $node->save();
    }
  }

  $sandbox['#finished'] = $sandbox['total']
    ? 1 - (count($sandbox['nids']) / $sandbox['total'])
    : 1;

  if ($sandbox['#finished'] >= 1) {
    return t('Processed @total appverse_software nodes for tag-to-topic migration.', [
      '@total' => $sandbox['total'],
    ]);
  }
}

