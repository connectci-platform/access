/**
 * Change field_rp_description from text_long to text_with_summary.
 *
 * Must run as update hook (before config import) because deploy hooks
 * run after config import, which fails on field type changes.
 */
function access_misc_update_10035() {
  $storage = \Drupal::entityTypeManager()->getStorage('field_storage_config');
  $field = $storage->load('node.field_rp_description');
  if ($field && $field->getType() === 'text_long') {
    $field->delete();
    field_purge_batch(100);
    return t('Deleted field_rp_description (text_long) so config import can recreate as text_with_summary.');
  }
  return t('field_rp_description already correct type or does not exist.');
}

/**
 * Backfill field_hide_community_profile = 0 for all users missing the record.
 */
function access_misc_update_10036() {
  // Single-query backfill: looping inserts at scale (~50k users) risks
  // exceeding Pantheon's deploy step time budget. INSERT..SELECT runs in
  // sub-second time regardless of row count.
  \Drupal::database()->query("
    INSERT INTO {user__field_hide_community_profile}
      (bundle, deleted, entity_id, revision_id, langcode, delta, field_hide_community_profile_value)
    SELECT 'user', 0, u.uid, u.uid, 'en', 0, 0
    FROM {users} u
    LEFT JOIN {user__field_hide_community_profile} f ON f.entity_id = u.uid
    WHERE f.entity_id IS NULL
  ");
}

/**
 * Update blocks 222 and 225 body text with new markup.
 */
function access_misc_update_10037() {
  $body_222 = <<<'EOT'
<h2 class="h4 text-base px-2 font-bold leading-5 text-dark-teal m-0 bg-light-teal uppercase w-full mt-1">
    Software
</h2>
EOT;
  update_block_body(222, $body_222, 'full_no_editor');

  $body_225 = <<<'EOT'
<div class="text-2xl text-dark-teal mb-5">
    See how researchers use ACCESS tools like Open OnDemand, Pegasus, XDMoD, and Globus.
</div>
EOT;
  update_block_body(225, $body_225, 'full_no_editor');
}
