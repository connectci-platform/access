use Drupal\user\UserInterface;
use Drupal\user\Entity\User;
use Drupal\views\ViewExecutable;


/**
 * Implements hook_page_attachments().
 */
function access_misc_page_attachments(&$variables) {
  // Adding global library to all pages.
  $variables['#attached']['library'][] = 'access_misc/global';
  // Accessibility fix for webform help tooltips.
  $variables['#attached']['library'][] = 'access_misc/webform_help_a11y';
  // Adding css for non-admin users.
  $user = \Drupal::currentUser();
  $roles = $user->getRoles();
  if (!in_array('administrator', $roles)) {
    $variables['#attached']['library'][] = 'access_misc/nonadmin';
  }

  $current_domain_name = \Drupal::service('access_misc.sitetools')->getDomain();

  $query = \Drupal::database()->select('taxonomy_term__field_region_connected_domain', 't');
  $query->fields('t', ['field_region_connected_domain_value', 'entity_id']);
  $program_id = $query->execute()->fetchAllKeyed(0,1);

  if (array_key_exists($current_domain_name, $program_id)) {
    $variables['#attached']['drupalSettings']['access_misc']['current_menu'] = $program_id[$current_domain_name];
    $variables['#attached']['library'][] = 'access_misc/people_menu';
  }
}

/**
 * Implements hook_entity_view_mode_alter().
 */
function access_misc_entity_view_mode_alter(&$view_mode, Drupal\Core\Entity\EntityInterface $entity, $context) {
  $current_domain_name = \Drupal::service('access_misc.sitetools')->getDomain();

  // Custom view modes for taxonomy terms per domains.
  if ($entity->getEntityTypeId() == 'taxonomy_term' && $entity->bundle() == 'tags' && $view_mode == 'full') {
    if ($current_domain_name == 'access-support') {
      $view_mode = 'taxonomy_term_page_support';
    }
    elseif ($current_domain_name == 'open-ondemand') {
      $view_mode = 'taxonomy_term_page_open_ondemand';
    }
  }
}

/**
 * Implements hook_user_login().
 *
 * Redirect people to the <front> page on successful login
 * unless the current or destination parameter is set.
 * Also, clear any messages to prevent the previous
 * access denied message from showing after login.
 */
function access_misc_user_login(UserInterface $account) {
  // Check if destination is set in url.
  $destination = \Drupal::request()->query->get('destination');
  $current = \Drupal::request()->query->get('current');
  if (!$destination) {
    $current_request = \Drupal::service('request_stack')->getCurrentRequest();
    $url = Url::fromRoute('<front>', [], ['absolute' => 'true'])->toString();
    if ($current) {
      $url = Url::fromUri("internal:$current")->toString();
    }
    $current_request->query->set(
      'destination',
      $url
    );
  }

  // Clear messenger queue.
  \Drupal::messenger()->deleteAll();

  $last_login = $account->getLastAccessedTime();
  if (!$last_login) {
    // Message for first time login.
    \Drupal::messenger()->addMessage(t('Welcome and thanks for joining! Please set your password and complete your profile.'));
  }
}

/**
 * Implements hook_entity_type_build().
 */
function access_misc_entity_type_build(array $entity_types) {
  if (isset($entity_types['registrant'])) {
    $entity_types['registrant']->setHandlerClass('access', 'Drupal\access_misc\AccessRegistrantAccessControlHandler');
  }
}

/**
 * Implements hook_views_pre_render().
 */
function access_misc_views_pre_render(ViewExecutable $view) {
  if ($view->id() == 'infrastructure_news') {
    $view->element['#attached']['library'][] = 'access_misc/add_select';
  }
  if ($view->id() == 'recurring_events_event_series' && $view->getDisplay()->view->element['#display_id'] == 'block_1') {
    if (empty($view->result) && empty($view->getExposedInput())) {
      $view->exposed_widgets = NULL;
    }
  }
  if ($view->id() == 'user_profile') {
    $view->element['#attached']['library'][] = 'cssn/cssn_library';
  }
  if ($view->id() == 'cyberteam_people_facets') {
    $view->element['#attached']['library'][] = 'access_misc/people_directory';
  }
  if ($view->id() == 'affinity_group_search' ||
    $view->id() == 'search_ci_links' ||
    $view->id() == 'events_facet' ||
    $view->id() == 'cyberteam_people_facets' ||
    $view->id() == 'cssn_directory' ||
    $view->id() == 'mentorship_facet_search' ||
    $view->id() == 'ccmnet_members' ||
    $view->id() == 'campus_champions_members' ||
    $view->id() == 'events_facet') {
    $view->element['#attached']['library'][] = 'access_misc/collapsiblock_mobile';
  }
}

/**
 * Implements hook_entity_view_alter().
 */
function access_misc_entity_view_alter(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display) {
  if ($entity->getEntityTypeId() == 'eventinstance') {
    $build['virtual_meeting_link']['#access'] = TRUE;
    $entity_id = $entity->id();
    $series = $entity->getEventSeries();
    $registration_status = $series->get('event_registration')->getValue()[0]['registration'];

    // Get current user id.
    $current_user = \Drupal::currentUser();
    $uid = $current_user->id();

    if ($registration_status) {
      // Entity Query 'registrant' to get all registrants for the event instance.
      $query = \Drupal::entityQuery('registrant')
        ->condition('eventinstance_id', $entity_id)
        ->condition('status', 1)
        ->condition('user_id', $uid)
        ->accessCheck(TRUE);
      $registrants = $query->execute();

      $registrants = empty($registrants) ? TRUE : FALSE;


      if ($registrants) {
        $build['virtual_meeting_link']['#access'] = FALSE;
      }
    }
  }
}

/**
 * Implements hook_views_post_render().
 *
 * Override page title for views of people with interest/expertise tags.
 */
function access_misc_views_post_render(ViewExecutable $view) {
  // Override view /admin/structure/views/view/people_with_interest_tags/edit/page_1 title.
  if (($view->id() == 'people_with_interest_tags' && isset($view->getDisplay()->view->element['#display_id']) && $view->getDisplay()->view->element['#display_id'] == 'page_1') ||
      ($view->id() == 'people_with_expertise_tags' && isset($view->getDisplay()->view->element['#display_id']) && $view->getDisplay()->view->element['#display_id'] == 'page_1')) {
    $path = \Drupal::service('path.current')->getPath();
    $path_args = explode('/', $path);
    $tid = is_numeric($path_args[2]) ? $path_args[2] : FALSE;
    if ($term = term::load($tid)) {
      $title = 'People with interest in ' . $term->get('name')->value;
      if ($view->id() == 'people_with_expertise_tags') {
        $title = 'People with expertise in ' . $term->get('name')->value;
      }
      // Set the view title.
      $view->setTitle($title);
    }
  }
}

/**
 * Implements hook_views_pre_view() for node templates.
 */
function access_misc_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  $current_domain_name = \Drupal::service('access_misc.sitetools')->getDomain();

  $view_element = $view->element;

  // Add domain cache tag to all views.
  if (array_key_exists('#cache', $view_element)) {
    if (array_key_exists('tags', $view_element['#cache'])) {
      // Ensure the domain name is valid before using it as a cache tag
      if (!empty($current_domain_name) && is_string($current_domain_name)) {
        $domain_tag = 'domain:' . $current_domain_name;
        // Avoid duplicate tags
        if (!in_array($domain_tag, $view_element['#cache']['tags'])) {
          $view_element['#cache']['tags'][] = $domain_tag;
        }
      }
    }
  }

  if (
    ($view->id() == 'people_with_expertise_tags' && $view->getDisplay()->view->element['#display_id'] == 'block_1') ||
    ($view->id() == 'people_with_expertise_tags' && $view->getDisplay()->view->element['#display_id'] == 'page_1') ||
    ($view->id() == 'people_with_interest_tags' && $view->getDisplay()->view->element['#display_id'] == 'block_1') ||
    ($view->id() == 'people_with_interest_tags' && $view->getDisplay()->view->element['#display_id'] == 'page_1')
  ) {
    $view_filters = $view->display_handler->getOption('filters');
    $program = \Drupal::service('access_misc.sitetools')->getProgram();

    if (empty($program)) {
      // If no program for the domain, set the filter to not match any program.
      $view_filters['field_region_target_id_1']['operator'] = 'not';
    }
    else {
      $view_filters['field_region_target_id_1']['value'] = $program;
    }

    $view->display_handler->setOption('filters', $view_filters);
  }

  if ($view->id() == 'affinity_group_entity_reference' && $display_id === 'entity_reference_1') {
    $view_filters = $view->display_handler->getOption('filters');
    $domain = \Drupal::service('access_misc.sitetools')->getDomainId();

    $view_filters['field_domain_access_target_id']['value'] = [];
    $view_filters['field_domain_access_target_id']['value'][$domain] = $domain;
    $view->display_handler->setOption('filters', $view_filters);
  }

  if ($view->id() == 'affinity_groups_with_tag' && $display_id === 'block_2') {
    $term = term_lookup_from_path();
    if (!empty($term['tid'])) {
      $footer = \Drupal::service('access_misc.viewstools');
      $footer->setFooter($view, 'All Affinity Groups with this tag', '/tags/' . $term['tid'] . '/affinity-groups', 'block_2');
    }
  }

  if ($view->id() == 'mentorship_status' && $display_id === 'block_1') {
    $term = term_lookup_from_path();
    if (!empty($term['tid'])) {
      $footer = \Drupal::service('access_misc.viewstools');
      $footer->setFooter($view, 'All Mentorships with this tag', 'https://ccmnet.org/mentorships?f[0]=me_tags%3A' . $term['tid'], 'block_1');
    }
  }

  if ($view->id() == 'people_with_expertise_tags' && $display_id === 'block_1') {
    $term = term_lookup_from_path();
    if (!empty($term['tid'])) {
      $footer = \Drupal::service('access_misc.viewstools');
      $footer->setFooter($view, 'more people', '/tags/' . $term['tid'] . '/people-with-expertise', 'block_1');
    }
  }

  if ($view->id() == 'people_with_interest_tags' && $display_id === 'block_1') {
    $term = term_lookup_from_path();
    if (!empty($term['tid'])) {
      $footer = \Drupal::service('access_misc.viewstools');
      $footer->setFooter($view, 'more people', '/tags/' . $term['tid'] . '/people-with-interest', 'block_1');
    }
  }

  if ($view->id() == 'match_engagement_view' && $display_id === 'block_6') {
    $term = term_lookup_from_path();
    if (!empty($term['tid'])) {
      $footer = \Drupal::service('access_misc.viewstools');
      $footer->setFooter($view, 'All Engagements with this tag', '/tag/' . $term['tid'] . '/engagements', 'block_6');
    }
  }

  if ($view->id() == 'resources' && $display_id === 'block_1') {
    $term = term_lookup_from_path();
    if (!empty($term['tid'])) {
      $footer = \Drupal::service('access_misc.viewstools');
      $footer->setFooter($view, 'All Resources with this tag', '/tags/' . $term['tid'] . '/resources', 'block_1');
    }
  }

  if ($view->id() == 'tagged_news_block' && $display_id === 'block_1') {
    $term = term_lookup_from_path();
    if (!empty($term['tid'])) {
      $footer = \Drupal::service('access_misc.viewstools');
      $footer->setFooter($view, 'more', '/announcements?tid=' . $term['tid'], 'block_1');
    }
  }
}

/**
 * Lookup term from path for footer replacements above.
 */
function term_lookup_from_path() {
  $path = Xss::filter(\Drupal::service('path.current')->getPath());
  $path_args = explode('/', $path);
  $tid = NULL;
  $title = NULL;

  if (is_numeric($path_args[3])) {
    $tid = $path_args[3];
    // Lookup term by tid.
    $term = Term::load($tid);
    if ($term) {
      $title = $term->getName();
    }
  }
  return [
    'tid' => $tid,
    'title' => $title,
  ];
}

/**
 * Implements hook_entity_view_alter().
 */
function access_misc_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  switch ($entity->getEntityTypeId()) {
    case 'eventseries':
      $date = '';

      if (array_key_exists('event_instances', $build)) {
        $date = array_key_exists(0, $build['event_instances']) ? $build['event_instances'][0]['#title'] : '';
      }
      if (empty($date)) {
        break;
      }
      $dates = explode(' - ', $date);
      $convert_date = new EventDateConvert($dates[0], $dates[1]);
      if ($convert_date->sameDay ) {
        $build['event_instances'][0]['#title'] = $convert_date->getStart() . " - " . $convert_date->getEnd();
      } else {
        $build['event_instances'][0]['#title'] = $convert_date->getStart() . " to " . $convert_date->getEnd();
      }
      break;

    case 'eventinstance':
      $date = $build['date'][0];
      $convert_date = new EventDateConvert($date['start_date']['#markup'], $date['end_date']['#markup']);

      if (!$convert_date->sameDay ) {
        $build['date'][0]['separator']['#plain_text'] = ' to ';
      }

      $build['date'][0]['start_date']['#markup'] = $convert_date->getStart();
      $build['date'][0]['end_date']['#markup'] = $convert_date->getEnd();
      break;
  }
}

/**
 * Implements hook_preprocess_views_view_field for views-view-field.html.twig.
 */
function access_misc_preprocess_views_view_field(&$variables) {
  $view = $variables['view'];
  $field = $variables['field'];

  // Overwrite affinity_groups into /people page on the
  // /admin/structure/views/view/nect_cc_people/edit/page_1 view.
  if ($view->id() == 'nect_cc_people' && $view->current_display == 'page_1' && $field->options['id'] == 'uid_1') {
    $uid = $variables['output'];
    // Get all 'affinity_group' flags by user.
    $flag_service = \Drupal::service('flag');
    $flag_storage = $flag_service->getFlagById('affinity_group');
    $flagging_storage = \Drupal::entityTypeManager()->getStorage('flagging');
    $flaggings = $flagging_storage->loadByProperties(['uid' => $uid, 'flag_id' => $flag_storage->id()]);
    $affinity_groups = "";
    $n = 0;
    foreach ($flaggings as $flagging) {
      $tid = $flagging->getFlaggableId();
      // Entity query to get affinity_group node that has tid for field_affinity_group.
      if (!empty($tid)) {
        if ($affinity_groups == "") {
          $affinity_groups .= '<div class="small font-weight-bold mt-2">' . t('Affinity Groups') . '</div>';
        }
        if ($n < 3) {
          $entity_query = \Drupal::entityQuery('node')
            ->condition('type', 'affinity_group')
            ->condition('field_affinity_group', $tid)
            ->accessCheck(FALSE)
            ->execute();
          if ($entity_query) {
            $term = Term::load($tid);
            $affinity_group_name = $term->getName();
            $nid = implode($entity_query);
            // Drupal 10 Create link to affinity group node.
            $affinity_groups .= "<a class='small' href='/node/$nid'>$affinity_group_name</a> ";

          }
        }
      $n++;
      }
    }
    $variables['output'] = Markup::create($affinity_groups);
  }

}

/**
 * Implements hook_datalayer_alter()
 *
 * If the user is not anonymous, add hashed user id, account creation
 * date, and Carnegie Code to dataLayer.
 */
function access_misc_datalayer_alter(&$data_layer) {

  if (!\Drupal::currentUser()->isAnonymous()) {

    // Hide the uid field in data layer.
    if (isset($data_layer['userUid'])) {
      unset($data_layer['userUid']);
    }

    // Add hashed user id to data layer for logged in users.
    $userId = \Drupal::currentUser()->id();
    $data_layer['hashedUserId'] = hash('md4', $userId);

    // Add account creation date to data layer for logged in users.
    $account = User::load($userId);

    // Calculate a time-bucket for the age of the user's creation date as follows:
    // 1: under 1 week
    // 2: under 1 month
    // 3: under 3 month
    // 4: under 6 months
    // 5: under 12 months
    // 6: under 24 months
    // 7: over 24 months.
    $created_time = $account->getCreatedTime();
    $current_time = time();
    $delta_time = $current_time - $created_time;
    $delta_weeks = $delta_time / 60 / 60 / 24 / 7;
    if ($delta_weeks < 1) {
      $time_bucket = 1;
    }
    elseif ($delta_weeks < 4) {
      $time_bucket = 2;
    }
    elseif ($delta_weeks < 12) {
      $time_bucket = 3;
    }
    elseif ($delta_weeks < 24) {
      $time_bucket = 4;
    }
    elseif ($delta_weeks < 52) {
      $time_bucket = 5;
    }
    elseif ($delta_weeks < 104) {
      $time_bucket = 6;
    }
    else {
      $time_bucket = 7;
    }
    $data_layer['user_created_within'] = $time_bucket;

    $carnegie_code = 'unknown';
    try {
      $org = $account->get('field_access_organization')->getValue();
      if (!empty($org)) {
        $org = reset($org);
        if (array_key_exists('target_id', $org)) {
          $org = \Drupal::entityTypeManager()->getStorage('node')->load($org['target_id']);
          if ($org->get('field_carnegie_code')) {
            $carnegie_code = $org->get('field_carnegie_code')->value;
          }
        }
      }
    } catch (\Exception $e) {
      \Drupal::logger('access_misc')->error('Error loading user organization: ' . $e->getMessage());
    }
    $data_layer['carnegie_code'] = $carnegie_code;
  }
}

/**
 * Implements hook_form_alter().
 */
function access_misc_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Project tweak: /form/project
  if ($form_id == 'webform_submission_project_add_form') {
    $program = \Drupal::service('access_misc.sitetools')->getProgram();
    if ($program) {
      $form['elements']['region']['#default_value'] = $program;
    }
  }

  if ($form_id == 'webform_submission_project_add_form' || $form_id == 'webform_submission_project_edit_form') {
    // Submit hander to handle emails.
    array_unshift($form['actions']['submit']['#submit'], 'access_misc_project_email_submit');

    // Only show the notify managers checkbox to the submission owner.
    if ($form_id == 'webform_submission_project_edit_form') {
      $webform_submission = $form_state->getFormObject()->getEntity();
      $current_user = \Drupal::currentUser();

      // Hide the checkbox if the current user is not the submission owner.
      if ($webform_submission->getOwnerId() != $current_user->id()) {
        $form['elements']['notify_managers_of_update']['#access'] = FALSE;
      }
    }
  }

  $domain = \Drupal::service('access_misc.sitetools')->getDomain();

  if ($domain != 'access-support' && ($form_id == 'node_access_news_form' || $form_id == 'node_access_news_edit_form')) {
    $form['field_affiliation']['#access'] = FALSE;
  }

  if ($form_id == 'node_access_news_form' || $form_id == 'node_access_news_edit_form') {
    // If domain doesn't get set, force current domain after submit.
    array_unshift($form['actions']['submit']['#submit'], 'access_announcements_domain_submit');
  }

  if ($form_id == 'user_login_form') {
    $form['#title'] = t('Join or Login');
  }

  if ($form_id == 'user_form') {
    $form['actions']['submit']['#submit'][] = 'access_misc_user_password_change';

    // Hide the current password field and make the password field optional
    // so users can save profile changes without setting a new password.
    // Uses #after_build to ensure it runs after the form is fully built.
    $form['#after_build'][] = 'access_misc_user_form_after_build';
  }
}

/**
 * After build callback for user_form.
 *
 * Users authenticate via CILogon/social auth and don't have Drupal passwords,
 * so we hide the current password field and make the password field optional.
 * The user_pass_reset flag tells core's ProtectedUserFieldConstraint validator
 * to skip the current password check on submit. User 1 is exempt so the
 * superadmin account retains the current password requirement.
 */
function access_misc_user_form_after_build($form, FormStateInterface $form_state) {
  // Do not bypass current password for the superadmin (user 1).
  $account = $form_state->getFormObject()->getEntity();
  if (!empty($account) && (int) $account->id() === 1) {
    return $form;
  }
  if (isset($form['account']['current_pass'])) {
    $form['account']['current_pass']['#access'] = FALSE;
  }
  if (isset($form['account']['pass'])) {
    $form['account']['pass']['#required'] = FALSE;
  }
  // Ensure user_pass_reset is set so core's ProtectedUserFieldConstraint
  // validator skips the current password check on submit. This is safe for
  // admin-editing-other-user because the validator only checks when the
  // current user is editing their own account.
  $form_state->set('user_pass_reset', 1);
  return $form;
}

/**
 * Custom submit handler to set domain access based on current domain.
 */
function access_announcements_domain_submit($form, FormStateInterface $form_state) {
  $domain_id = \Drupal::service('access_misc.sitetools')->getDomainId();
  $set_domain = $form_state->getValue('field_domain_access');

  if ($domain_id && empty($set_domain)) {
    $set_domain[] = $domain_id;
    $form_state->setValue('field_domain_access', $set_domain);
  }
}

/**
 * Submit handler for project form.
 */
function access_misc_project_email_submit(array &$form, FormStateInterface $form_state) {
  $values = $form_state->getValues();
  $form_object = $form_state->getFormObject();

  /** @var \Drupal\webform\WebformSubmissionInterface $webform_submission */
  $webform_submission = $form_object->getEntity();

  // Check if this is a configured program.
  $program_id = _access_misc_check_project_program($webform_submission);
  if (!$program_id) {
    return;
  }

  // Get submission author email.
  $author_uid = $webform_submission->getOwnerId();
  $author = \Drupal::entityTypeManager()->getStorage('user')->load($author_uid);
  if (!$author) {
    return;
  }
  $author_email = $author->getEmail();
  if (!$author_email) {
    return;
  }

  // Get common email variables.
  $variables = _access_misc_get_project_email_variables($webform_submission);
  $symfony_mail = \Drupal::service('access_misc.symfony.mail');
  $policy = 'access_misc_project';

  // Determine region suffix for email subtype.
  $region_suffix = _access_misc_get_region_suffix($program_id);

  // Check if "Received" email should be sent.
  if (!$values['received_sent'] && $values['approved_milestones']) {
    $policy_subtype = 'project_received_' . $region_suffix;
    $symfony_mail->email($policy, $policy_subtype, $author_email, $variables);
    $form_state->setValue('received_sent', 1);
    \Drupal::logger('access_misc')->info('Project received notification sent to @email for submission @sid', [
      '@email' => $author_email,
      '@sid' => $webform_submission->id(),
    ]);
  }

  // Check if "Approved" email should be sent.
  if (!$values['accept_and_publish_sent'] && $values['approved']) {
    $policy_subtype = 'project_approved_' . $region_suffix;
    $symfony_mail->email($policy, $policy_subtype, $author_email, $variables);
    $form_state->setValue('accept_and_publish_sent', 1);
    \Drupal::logger('access_misc')->info('Project approved notification sent to @email for submission @sid', [
      '@email' => $author_email,
      '@sid' => $webform_submission->id(),
    ]);
  }

}

/**
 * Helper: Check if webform submission is for a configured program.
 *
 * @param \Drupal\webform\WebformSubmissionInterface $webform_submission
 *   The webform submission.
 *
 * @return int|false
 *   The program ID if configured, FALSE otherwise.
 */
function _access_misc_check_project_program(\Drupal\webform\WebformSubmissionInterface $webform_submission) {
  // Get the region/program from the submission.
  $submission_region = $webform_submission->getElementData('region');
  $submission_region = is_array($submission_region) ? reset($submission_region) : $submission_region;

  if (!$submission_region) {
    return FALSE;
  }

  // Get current site program.
  $site_tools = \Drupal::service('access_misc.sitetools');
  $current_program = $site_tools->getProgram();
  $current_program = is_array($current_program) ? reset($current_program) : $current_program;

  // Only process if submission region matches current domain program.
  if ($submission_region != $current_program) {
    return FALSE;
  }

  // Check if this program has a manager role configured.
  $manager_role = $site_tools->getManagerRole($current_program);
  if (!$manager_role) {
    return FALSE;
  }

  return $current_program;
}

/**
 * Helper: Get region suffix for email subtype.
 *
 * @param int $program_id
 *   The program/region taxonomy term ID.
 *
 * @return string
 *   The region suffix (e.g., 'pascience').
 */
function _access_misc_get_region_suffix($program_id) {
  $region_map = [
    323 => 'careers',    // CAREERS
    933 => 'pascience',  // PA Science
    // Add other regions here as they are configured.
  ];

  return $region_map[$program_id] ?? 'default';
}

/**
 * Helper: Get common email variables for project notifications.
 *
 * @param \Drupal\webform\WebformSubmissionInterface $webform_submission
 *   The webform submission.
 *
 * @return array
 *   Array of email variables.
 */
function _access_misc_get_project_email_variables(\Drupal\webform\WebformSubmissionInterface $webform_submission) {
  // Get raw submission data to avoid spamspan markup.
  $data = $webform_submission->getData();

  $project_title = $data['project_title'] ?? '';
  $project_leader_name = $data['project_leader'] ?? [];
  $project_leader_first = $project_leader_name['first'] ?? '';
  $project_leader_last = $project_leader_name['last'] ?? '';
  $project_institution = $data['project_institution'] ?? '';
  $project_description = $data['project_description'] ?? '';
  $contact_email = $data['email'] ?? '';
  $status = $data['status'] ?? 'Not set';

  // Get submission author.
  $author_uid = $webform_submission->getOwnerId();
  $author = \Drupal::entityTypeManager()->getStorage('user')->load($author_uid);
  $author_name = $author ? $author->getDisplayName() : 'Unknown';

  // Get URLs.
  $request = \Drupal::request();
  $host = $request->getSchemeAndHttpHost();
  $submission_id = $webform_submission->id();
  $edit_url = $host . '/webform/project/submissions/' . $submission_id . '/edit';
  $public_url = $host . '/project/' . $submission_id;

  // Build approval status.
  $approved_milestones = $webform_submission->getElementData('approved_milestones');
  $approved = $webform_submission->getElementData('approved');

  return [
    'project_title' => $project_title,
    'project_leader_first' => $project_leader_first,
    'project_leader_last' => $project_leader_last,
    'contact_email' => $contact_email,
    'project_institution' => $project_institution,
    'project_description' => $project_description,
    'submitted_by' => $author_name,
    'submission_id' => $submission_id,
    'created_date' => date('F j, Y', $webform_submission->getCreatedTime()),
    'updated_date' => date('F j, Y'),
    'approved_date' => date('F j, Y'),
    'status' => $status,
    'received' => $approved_milestones ? 'Yes' : 'No',
    'approved' => $approved ? 'Yes' : 'No',
    'edit_url' => $edit_url,
    'public_url' => $public_url,
  ];
}

/**
 * Implements hook_ENTITY_TYPE_insert() for webform_submission entities.
 */
function access_misc_webform_submission_insert(\Drupal\webform\WebformSubmissionInterface $webform_submission) {
  // Only process project webform.
  if ($webform_submission->getWebform()->id() !== 'project') {
    return;
  }

  // Check if this is a configured program.
  $program_id = _access_misc_check_project_program($webform_submission);
  if (!$program_id) {
    \Drupal::logger('access_misc')->info('Project created notification skipped: submission @sid not for configured program', [
      '@sid' => $webform_submission->id(),
    ]);
    return;
  }

  // Get manager emails for this program.
  $site_tools = \Drupal::service('access_misc.sitetools');
  $manager_role = $site_tools->getManagerRole($program_id);
  $user_tools = \Drupal::service('access_misc.usertools');
  $manager_emails = $user_tools->getEmails([$manager_role], []);

  if (!$manager_emails) {
    \Drupal::logger('access_misc')->warning('Project created notification skipped: no managers found for role @role (program @pid)', [
      '@role' => $manager_role,
      '@pid' => $program_id,
    ]);
    return;
  }

  // Send "Project Created" email to managers.
  $region_suffix = _access_misc_get_region_suffix($program_id);
  $variables = _access_misc_get_project_email_variables($webform_submission);
  $symfony_mail = \Drupal::service('access_misc.symfony.mail');
  $policy = 'access_misc_project';
  $policy_subtype = 'project_created_' . $region_suffix;

  $symfony_mail->email($policy, $policy_subtype, $manager_emails, $variables);

  // Count recipients: if array use count(), if string count commas + 1.
  $recipient_count = is_array($manager_emails) ? count($manager_emails) : substr_count($manager_emails, ',') + 1;
  \Drupal::logger('access_misc')->info('Project created notification sent to @count managers for submission @sid', [
    '@count' => $recipient_count,
    '@sid' => $webform_submission->id(),
  ]);
}

/**
 * Implements hook_ENTITY_TYPE_update() for webform_submission entities.
 *
 * Only notifies PA Science DMZ Program Managers when the submitter explicitly
 * checks the "Notify PA Science DMZ Program Managers of this update" checkbox.
 */
function access_misc_webform_submission_update(\Drupal\webform\WebformSubmissionInterface $webform_submission) {
  // Only process project webform.
  if ($webform_submission->getWebform()->id() !== 'project') {
    return;
  }

  // Check if notification checkbox is checked.
  $notify_managers = $webform_submission->getElementData('notify_managers_of_update');
  if (!$notify_managers) {
    return;
  }

  // Check if this is a configured program.
  $program_id = _access_misc_check_project_program($webform_submission);
  if (!$program_id) {
    return;
  }

  // Get manager emails for this program.
  $site_tools = \Drupal::service('access_misc.sitetools');
  $manager_role = $site_tools->getManagerRole($program_id);
  $user_tools = \Drupal::service('access_misc.usertools');
  $manager_emails = $user_tools->getEmails([$manager_role], []);

  if (!$manager_emails) {
    \Drupal::logger('access_misc')->warning('Project updated notification skipped: no managers found for role @role (program @pid)', [
      '@role' => $manager_role,
      '@pid' => $program_id,
    ]);
    return;
  }

  // Send "Project Updated" email to PA Science DMZ Program Managers.
  $region_suffix = _access_misc_get_region_suffix($program_id);
  $variables = _access_misc_get_project_email_variables($webform_submission);
  $symfony_mail = \Drupal::service('access_misc.symfony.mail');
  $policy = 'access_misc_project';
  $policy_subtype = 'project_updated_' . $region_suffix;

  $symfony_mail->email($policy, $policy_subtype, $manager_emails, $variables);

  // Count recipients: if array use count(), if string count commas + 1.
  $recipient_count = is_array($manager_emails) ? count($manager_emails) : substr_count($manager_emails, ',') + 1;
  \Drupal::logger('access_misc')->info('Project updated notification sent to @count managers for submission @sid', [
    '@count' => $recipient_count,
    '@sid' => $webform_submission->id(),
  ]);

  // Reset the checkbox after sending.
  $webform_submission->setElementData('notify_managers_of_update', 0);
  $webform_submission->resave();
}

/**
 * Validate handler for mentorship_engagement form.
 */
function access_misc_custom_tags_validate(array &$form, FormStateInterface $form_state) {
  $values = $form_state->getValues();
  $tags = $values['tags'];

  if (count($tags) > 6) {
    $form_state->setErrorByName('Tags', t('You can only select 6 tags. Please remove some tags.'));
  }
}

/**
 * Custom submit handler for registrant form to email user.
 */
function access_misc_registrant_email_submit($form, FormStateInterface $form_state) {
  // Get url.
  $url = Xss::filter(\Drupal::request()->getRequestUri());
  $url = explode('/', $url);
  $event_instance_id = is_numeric($url[2]) ? $url[2] : '';
  // Entity load eventinctance by id.
  $event_instance = \Drupal::entityTypeManager()->getStorage('eventinstance')->load($event_instance_id);
  $series = $event_instance->getEventSeries();

  $author = $series->getOwner();
  $author_email = $author->getEmail();

  $series_title = $series->get('title')->value;
  $series_contact = $series->get('field_contact')->getValue();
  $contact = !empty($series_contact) ? t('In the meantime, if you have any questions or wish to withdraw from the waitlist, please contact us at ') . $series_contact[0]['value']  . '.': '';
  $start_date = $event_instance->get('date')->start_date->__toString();
  $start_date = date('F j, Y', strtotime($start_date));
  // Turn $series_title into a link to the event with correct domain.
  $event_url = _access_misc_get_event_domain_url($event_instance_id);
  $series_title_url = "<a href='$event_url'>$series_title</a>";

  $series_screen_survey_url = $series->get('field_screen_survey_url')->uri;
  $series_email_template = $series->get('field_screen_survey_email_text')->value;

  $registered_person_email = Xss::filter($form_state->getValues()['email'][0]['value']);
  $name = Xss::filter($form_state->getValues()['field_first_name'][0]['value']) . ' ' . Xss::filter($form_state->getValues()['field_last_name'][0]['value']);
  $uid = Xss::filter($form_state->getValues()['user_id'][0]['target_id']);
  $waitlist = Xss::filter($form_state->getValues()['add_to_waitlist']);

  // Subject for email.
  $email_title = empty($series_screen_survey_url) ? t('Registration Pending for ') . $series_title : t('Please Complete a Pre-Screening Survey for ') . $series_title;

  $policy = 'access_misc';

  // Render the full email body from the event's template field.
  // Mark title_link as safe since it contains an <a> tag.
  $template_variables = [
    'name' => $name,
    'title_link' => new \Twig\Markup($series_title_url, 'UTF-8'),
    'start_date' => $start_date,
    'screen_survey_url' => $series_screen_survey_url,
  ];
  $custom_body = _access_events_render_email_template($series_email_template, $template_variables);

  // The 'register' policy uses custom_body + email_title only.
  // Extra variables (title, name, title_link, etc.) are needed by the
  // 'waitlist' policy which still uses its own Symfony Mailer template.
  $variables = [
    'title' => $series_title,
    'name' => $name,
    'title_link' => $series_title_url,
    'start_date' => $start_date,
    'contact' => $contact,
    'custom_body' => $custom_body,
    'email_title' => $email_title,
  ];

  if ($waitlist) {
    $policy_subtype = 'waitlist';
    \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $registered_person_email, $variables);
  }
  else {
    $policy_subtype = 'register';
    \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $registered_person_email, $variables);
  }

  // Add to email digest list.
  $digest = \Drupal::state()->get('access_misc_email_digest', []);

  // Don't overwrite existing entries - just ensure the event is in the digest.
  if (!isset($digest[$event_instance_id])) {
    $digest[$event_instance_id] = [
      'event_title' => $series_title,
      'event_url' => _access_misc_get_event_domain_url($event_instance_id),
      'author_email' => $author_email,
      'registration_count' => 1,
      'first_registration' => date('Y-m-d H:i:s'),
    ];
  }
  else {
    // Increment registration count for existing entry.
    $digest[$event_instance_id]['registration_count']++;
  }

  \Drupal::state()->set('access_misc_email_digest', $digest);
}

/**
 * Helper function to get domain-specific URL for an event.
 */
function _access_misc_get_event_domain_url($event_instance_id) {
  try {
    // Load the event instance.
    $event_instance = \Drupal::entityTypeManager()
      ->getStorage('eventinstance')
      ->load($event_instance_id);
    if (!$event_instance) {
      return '/events/' . $event_instance_id; // Fallback to relative URL.
    }

    // Get associated domains from the event instance.
    $instance_domains = $event_instance->get('domain_access')->getValue();

    // If instance doesn't have domains, get from the series.
    if (empty($instance_domains)) {
      $series = $event_instance->getEventSeries();
      if ($series) {
        $instance_domains = $series->get('domain_access')->getValue();
      }
    }

    // Generate domain-specific URL if domains are found.
    if (!empty($instance_domains)) {
      $domain_id = $instance_domains[0]['target_id'];
      $domain = \Drupal::entityTypeManager()
        ->getStorage('domain')
        ->load($domain_id);
      if ($domain) {
        return $domain->buildUrl('/events/' . $event_instance_id);
      }
    }

    // Fallback to current domain if no specific domain found.
    $current_domain = \Drupal::service('domain.negotiator')->getActiveDomain();
    if ($current_domain) {
      return $current_domain->buildUrl('/events/' . $event_instance_id);
    }

    // Final fallback to relative URL.
    return '/events/' . $event_instance_id;
  }
  catch (\Exception $e) {
    \Drupal::logger('access_misc')
      ->error('Error generating event domain URL: ' . $e->getMessage());
    return '/events/' . $event_instance_id;
  }
}

/**
 * Custom submit handler for user_form.
 */
function access_misc_user_password_change($form, FormStateInterface $form_state) {
  $password = $form_state->getValue('pass');
  if ($password) {
    \Drupal::messenger()->addMessage(t('Password changed successfully.'));
    // Redirect user to '/community-persona' after password change.
    $form_state->setRedirect('cssn.page');
  }
}

function access_misc_replace_section_callback(array &$form, FormStateInterface $form_state) {
  $raw_data = $form_state->getUserInput();
  $body = $raw_data['description'];
  $body_filter = $body ? Xss::filter($body) : '';
  $suggested_tag_ids = '0';
  $tagged_tags = array_filter($raw_data['tags']);
  $tag_count = count($tagged_tags);
  $tag_limit = 6;
  $tag_amount = $tag_limit - $tag_count;

  if ($tag_amount <= 0) {
    $form['field_tags_replace']['user_message'] = [
      '#markup' => "<div class='match-tag-list bg-blue-200 text-sky-900 my-5 p-5'>
      <strong class='text-sky-900'>You already have 6 tags</strong><br />
      You can remove some tags to get more suggestions.</div>",
    ];
  }
  elseif (strlen($body_filter) >= 100) {
    try {
      $llm = \Drupal::service('access_llm.ai_references_generator');
      $llm->generateTaxonomyPrompt('tags', 1, $body_filter);
      $suggestions = array_slice($llm->taxonomyIdSuggested(), 0, $tag_amount);
      $suggested_tag_ids = implode(', ', $suggestions);
      $form['field_tags_replace']['user_message'] = [
        '#markup' => "",
      ];
    }
    catch (\Throwable $e) {
      $form['field_tags_replace']['user_message'] = [
        '#markup' => "<div class='match-tag-list bg-yellow-200 text-yellow-900 my-5 p-5'>
        <strong class='text-yellow-900'>AI tag suggestions are not available</strong><br />
        Please select tags manually from the list below.</div>",
      ];
    }
  }
  else {
    $form['field_tags_replace']['user_message'] = [
      '#markup' => "<div class='match-tag-list bg-blue-200 text-sky-900 my-5 p-5'>
      <strong class='text-sky-900'>Fill in the description above to get suggested tags.</strong><br />
                    Your description must be over 100 characters to get a suggestion.</div>",
    ];
  }

  $form['field_tags_replace']['#attributes']['data-suggest'] = $suggested_tag_ids ;

  // Return the updated section.
  return $form['field_tags_replace'];
}

/**
 * Implements hook_mail().
 */
function access_misc_mail($key, &$message, $params) {
  switch ($key) {
    case 'notify_role':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = $params['subject'];
      $message['body'][] = $params['body'];
      break;
  }
}

function get_domain_email() {
  // Lookup the site_mail for the current domain.
  // This is used to set the Reply-To header for emails sent from the site.
  $domain_negotiator = \Drupal::service('domain.negotiator');
  $active_domain = $domain_negotiator->getActiveDomain();
  if ($active_domain) {
    $domain_id = $active_domain->id();
    $configFactory = \Drupal::configFactory()->get('domain_site_settings.domainconfigsettings');
    if ($configFactory->get($domain_id) !== NULL) {
      $domain_config = $configFactory->get($domain_id);
      $site_mail = $domain_config['site_mail'];
      return $site_mail;
    }
  }
  return NULL; // Fallback if no domain match
}

/**
 * Implements hook_mail_alter().
 */
function access_misc_mail_alter(&$message) {
  // If the domain-specific email exists, use it.
  $site_email = get_domain_email();
  if (!empty($site_email)) {
    $message['headers']['Reply-To'] = $site_email;
  }
}

/**
 * Implements hook_cron().
 */
function access_misc_cron() {
  // Run this cron job every day at 3am.
  $currentTime = \Drupal::time()->getCurrentTime();
  $hour = date('H', $currentTime);
  $min = date('i', $currentTime);

  // Cron runs every 10 minutes. Extended window to 3:00-3:59 AM for better reliability.
  if ($hour == 3) {
    // Run the ingest of ACCESS organizations.
    \Drupal::service('access_misc.import_access_orgs')->ingest();

    // Run registration email digest for authors of event.
    $digest = \Drupal::state()->get('access_misc_email_digest', []);

    // Only proceed if there are notifications to send.
    if (!empty($digest)) {
      $successful_sends = [];

      foreach ($digest as $event_id => $digest_event) {
        $event_author = $digest_event['author_email'];
        $policy = 'access_misc';
        $policy_subtype = 'registrant_digest';

        try {
          \Drupal::service('access_misc.symfony.mail')
            ->email($policy, $policy_subtype, $event_author, $digest_event);
          $successful_sends[] = $event_id;
          \Drupal::logger('access_misc')
            ->info('Event registration digest sent for event @event_id to @email', [
              '@event_id' => $event_id,
              '@email' => $event_author,
            ]);
        }
        catch (\Exception $e) {
          \Drupal::logger('access_misc')
            ->error('Failed to send event registration digest for event @event_id to @email: @error', [
              '@event_id' => $event_id,
              '@email' => $event_author,
              '@error' => $e->getMessage(),
            ]);
        }
      }

      // Only reset digest for successfully sent notifications.
      if (!empty($successful_sends)) {
        $remaining_digest = array_diff_key($digest, array_flip($successful_sends));
        \Drupal::state()->set('access_misc_email_digest', $remaining_digest);

        \Drupal::logger('access_misc')
          ->info('Event registration digest processed: @sent sent, @remaining remaining', [
            '@sent' => count($successful_sends),
            '@remaining' => count($remaining_digest),
          ]);
      }
    }
  }
}

/**
 * Implements hook_user_update().
 *
 * Sync user email changes to their event registrations.
 */
function access_misc_user_update(\Drupal\user\UserInterface $account) {
  $original = $account->original;
  if ($original && $account->getEmail() != $original->getEmail()) {
    // Find registrations belonging to this user with the old email.
    $storage = \Drupal::entityTypeManager()->getStorage('registrant');
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('user_id', $account->id())
      ->condition('email', $original->getEmail())
      ->execute();

    // Update each registrant entity through the proper API.
    foreach ($ids as $id) {
      $registrant = $storage->load($id);
      if ($registrant) {
        $registrant->set('email', $account->getEmail());
        $registrant->save();
      }
    }
  }
}

/**
 * Normalize a string for comparison: lowercase, strip dashes/spaces.
 */
function _access_misc_normalize_term(string $name): string {
  return strtolower(preg_replace('/[\s\-_]+/', '', $name));
}

/**
 * Implements hook_node_presave().
 *
 * For appverse_software nodes, move tags that match a topic (normalized) from
 * field_tags to field_appverse_topics. This prevents duplication between the
 * two vocabularies.
 */
function access_misc_node_presave(NodeInterface $node) {
  if ($node->bundle() !== 'appverse_software') {
    return;
  }

  if (!$node->hasField('field_tags') || !$node->hasField('field_appverse_topics')) {
    return;
  }

  // Build a lookup of normalized topic names → term IDs.
  $topic_terms = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->loadTree('appverse_science_domains', 0, NULL, TRUE);

  $topic_map = [];
  foreach ($topic_terms as $term) {
    $normalized = _access_misc_normalize_term($term->getName());
    $topic_map[$normalized] = (int) $term->id();
  }

  // Collect current topic IDs already on the node.
  $current_topic_ids = array_map(function ($item) {
    return (int) $item['target_id'];
  }, $node->get('field_appverse_topics')->getValue());

  $tags = $node->get('field_tags')->getValue();
  $remaining_tags = [];
  $topics_to_add = [];

  foreach ($tags as $tag_item) {
    $tag_term = Term::load($tag_item['target_id']);
    if (!$tag_term) {
      continue;
    }

    $normalized_tag = _access_misc_normalize_term($tag_term->getName());

    if (isset($topic_map[$normalized_tag])) {
      // This tag matches a topic — add the topic if not already present.
      $topic_id = $topic_map[$normalized_tag];
      if (!in_array($topic_id, $current_topic_ids) && !in_array($topic_id, $topics_to_add)) {
        $topics_to_add[] = $topic_id;
      }
      // Don't keep this tag.
    }
    else {
      // Keep tags that don't match any topic.
      $remaining_tags[] = $tag_item;
    }
  }

  // Update fields if anything changed.
  if (count($remaining_tags) !== count($tags)) {
    $node->set('field_tags', $remaining_tags);

    if ($topics_to_add) {
      $topic_values = $node->get('field_appverse_topics')->getValue();
      foreach ($topics_to_add as $tid) {
        $topic_values[] = ['target_id' => $tid];
      }
      $node->set('field_appverse_topics', $topic_values);
    }

    \Drupal::logger('access_misc')->notice(
      'Appverse software "@title": moved @count tag(s) to topics.',
      [
        '@title' => $node->getTitle(),
        '@count' => count($tags) - count($remaining_tags),
      ]
    );
  }
}
