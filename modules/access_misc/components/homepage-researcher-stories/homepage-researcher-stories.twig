{#
/**
 * @file
 * Homepage researcher stories band: the latest tool case studies.
 *
 * Available variables:
 * - stories_url: href for "Read all stories".
 * - stories: slot with the stories view (rows are .homepage-story).
 */
#}
<section class="homepage-stories">
  <div class="container">
    <p class="homepage-stories__eyebrow">{{ 'Tools in practice'|t }}</p>
    <h2 class="homepage-stories__title">{{ 'Researcher stories'|t }}</h2>
    {{ stories }}
    <p class="homepage-stories__all"><a class="homepage-stories__button" href="{{ stories_url }}">{{ 'Read all stories'|t }}</a></p>
  </div>
</section>
