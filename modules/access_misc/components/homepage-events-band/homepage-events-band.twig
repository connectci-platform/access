{#
/**
 * @file
 * Homepage events band: events, announcements and the office hours tiles.
 *
 * Available variables:
 * - events_url: href for "See all events".
 * - announcements_url: href for "See all announcements".
 * - post_announcement_url: href for "Post an announcement".
 * - office_hours_url: optional href for the office hours "More info" link.
 * - office_hours_next: optional list of preformatted upcoming dates.
 * - open_ondemand_url: optional href for the Open OnDemand office hours.
 * - pegasus_url: optional href for the Pegasus office hours.
 * - webinars_url: optional href for "NAIRR Pilot webinars".
 * - video_learning_center_url: optional href for "Video Learning Center".
 * - events: slot with the events view (rows are .homepage-ev).
 * - announcements: slot with the announcements view (rows are a.homepage-ann).
 */
#}
<section class="homepage-events-band">
  <div class="container homepage-events-band__grid">
    <div class="homepage-events-band__events">
      <h2 class="homepage-events-band__title">{{ 'Training & events'|t }}</h2>
      {{ events }}
      <p class="homepage-events-band__all"><a href="{{ events_url }}">{{ 'See all events'|t }}</a></p>
    </div>

    <div class="homepage-events-band__announcements">
      <h2 class="homepage-events-band__title">{{ 'Announcements'|t }}</h2>
      {{ announcements }}
      <p class="homepage-events-band__all"><a href="{{ announcements_url }}">{{ 'See all announcements'|t }}</a></p>
      <a class="homepage-events-band__post" href="{{ post_announcement_url }}">
        <svg class="homepage-events-band__megaphone" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
          <path d="M13 2.5a1.5 1.5 0 0 1 3 0v11a1.5 1.5 0 0 1-3 0zm-1 .724c-2.067.95-4.539 1.481-7 1.656v6.237a25 25 0 0 1 1.088.085c2.053.204 4.038.668 5.912 1.56zm-8 7.841V4.934c-.68.027-1.399.043-2.008.053A2.02 2.02 0 0 0 0 7v2c0 1.106.896 1.996 1.994 2.009l.496.008a64 64 0 0 1 1.51.048m1.39 1.081q.428.032.85.078l.253 1.69a1 1 0 0 1-.983 1.187h-.548a1 1 0 0 1-.916-.599l-1.314-2.48a66 66 0 0 1 1.692.064q.491.026.966.06"/>
        </svg>
        <span class="homepage-events-band__post-text">
          <span>{{ 'Have news to share?'|t }}</span>
          <b>{{ 'Post an announcement'|t }}</b>
        </span>
      </a>
    </div>

    <div class="homepage-events-band__tiles">
      <div class="homepage-events-band__tile homepage-events-band__tile--yellow">
        <h2 class="homepage-events-band__tile-title">{{ 'ACCESS & NAIRR Pilot office hours'|t }}</h2>
        <p><b>{{ '2nd Tue, 3–4 PM ET'|t }}<br>{{ '4th Wed, 12–1 PM ET'|t }}</b></p>
        {% if office_hours_next %}
          <p class="homepage-events-band__small">{{ 'Next:'|t }} {{ office_hours_next|join(' · ') }}</p>
        {% endif %}
        {% if office_hours_url %}
          <a class="homepage-events-band__tile-link" href="{{ office_hours_url }}">{{ 'More info'|t }}</a>
        {% endif %}
      </div>

      <div class="homepage-events-band__tile homepage-events-band__tile--teal">
        <h2 class="homepage-events-band__tile-title">{{ 'Other office hours'|t }}</h2>
        {% if open_ondemand_url %}
          <a class="homepage-events-band__tile-link" href="{{ open_ondemand_url }}">{{ 'Open OnDemand'|t }}</a>
        {% endif %}
        {% if pegasus_url %}
          <a class="homepage-events-band__tile-link" href="{{ pegasus_url }}">{{ 'Pegasus'|t }}</a>
        {% endif %}
      </div>

      <div class="homepage-events-band__tile homepage-events-band__tile--ink">
        <h2 class="homepage-events-band__tile-title">{{ 'Webinars & videos'|t }}</h2>
        <p>{{ 'Join live or learn on your own time.'|t }}</p>
        {% if webinars_url %}
          <a class="homepage-events-band__tile-link" href="{{ webinars_url }}">{{ 'NAIRR Pilot webinars'|t }}</a>
        {% endif %}
        {% if video_learning_center_url %}
          <a class="homepage-events-band__tile-link" href="{{ video_learning_center_url }}">{{ 'Video Learning Center'|t }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>
