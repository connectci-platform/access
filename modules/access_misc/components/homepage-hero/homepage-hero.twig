{#
/**
 * @file
 * Homepage hero: "How can we help?" ask box and help-ticket card.
 *
 * Available variables:
 * - bg: URL to the background image (decorative shapes are baked in).
 * - help_ticket_url: href for "Open a help ticket".
 * - tickets_url: href for "View your tickets".
 * - docs_url: optional href for "Search the documentation".
 * - assistant_url: action URL of the ask form; the question is submitted
 *   as the "q" query parameter (GET, same tab, no JavaScript).
 * - prompts: optional list of example questions, each an object with
 *   "label" (text) and "url" (assistant_url with the label in "q").
 *
 * Note: a GET form drops any query string on its action URL, so an assistant
 * URL that needs its own parameters would need hidden inputs.
 */
#}
<section class="homepage-hero" style="background-image: url({{ bg }})">
  <div class="container homepage-hero__grid">
    <div class="homepage-hero__ask">
      <h2 class="homepage-hero__title">{{ 'How can we help?'|t }}</h2>
      <p class="homepage-hero__intro">{{ 'Ask our assistant about allocations, resources, software and more.'|t }}</p>

      <form class="homepage-hero__search" role="search" method="get" action="{{ assistant_url }}">
        <label for="homepage-hero-q" class="visually-hidden">{{ 'Ask a question about ACCESS'|t }}</label>
        <span class="homepage-hero__bot" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="24" height="24">
            <path d="M5 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0m4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0m3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
            <path d="m2.165 15.803.02-.004c1.83-.363 2.948-.842 3.468-1.105A9 9 0 0 0 8 15c4.418 0 8-3.134 8-7s-3.582-7-8-7-8 3.134-8 7c0 1.76.743 3.37 1.97 4.6a10.4 10.4 0 0 1-.524 2.318l-.003.011a11 11 0 0 1-.244.637c-.079.186.074.394.273.362a22 22 0 0 0 .693-.125m.8-3.108a1 1 0 0 0-.287-.801C1.618 10.83 1 9.468 1 8c0-3.192 3.004-6 7-6s7 2.808 7 6-3.004 6-7 6a8 8 0 0 1-2.088-.272 1 1 0 0 0-.711.074c-.387.196-1.24.57-2.634.893a11 11 0 0 0 .398-2"/>
          </svg>
        </span>
        <input id="homepage-hero-q" type="text" name="q" required maxlength="500" placeholder="{{ 'Ask me about ACCESS…'|t }}">
        <button type="submit">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="14" height="14">
            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576zm6.787-8.201L1.591 6.602l4.339 2.76z"/>
          </svg>
          {{ 'Ask'|t }}
        </button>
      </form>

      {% if prompts %}
        <div class="homepage-hero__prompts" aria-label="{{ 'Example questions'|t }}">
          {% for prompt in prompts %}
            <a href="{{ prompt.url }}">{{ prompt.label }}</a>
          {% endfor %}
        </div>
      {% endif %}

      {% if docs_url %}
        <p class="homepage-hero__browse">{{ 'Prefer to browse?'|t }} <a href="{{ docs_url }}">{{ 'Search the documentation'|t }}</a></p>
      {% endif %}
    </div>

    <div class="homepage-hero__help">
      <h2 class="homepage-hero__help-title">{{ 'Need help from a person?'|t }}</h2>
      <div class="homepage-hero__help-actions">
        <a class="btn btn-primary" href="{{ help_ticket_url }}">{{ 'Open a help ticket'|t }}</a>
        <a class="homepage-hero__tickets" href="{{ tickets_url }}">{{ 'View your tickets'|t }}</a>
      </div>
    </div>
  </div>
</section>
