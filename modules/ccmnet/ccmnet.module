<?php

/**
 * @file
 * Module for customizing mentorship_engagement node.
 */

use Drupal\access_misc\Plugin\Util\SiteTools;
use Drupal\Component\Utility\Html;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\domain\Entity\Domain;
use Drupal\node\NodeInterface;
use Drupal\user\Entity\User;
use Drupal\user\UserInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_pre_render().
 */
function ccmnet_views_pre_render(ViewExecutable $view): void {
  if ($view->id() == 'ccmnet_members') {
    $view->element['#attached']['library'][] = 'cssn/cssn_directory';
  }
  $display = $view->getDisplay();
  if ($view->id() == 'mentorship_facet_search' && $display->display['id'] == 'block_1') {
    $view->element['#attached']['library'][] = 'ccmnet/mentorship_front_more';
  }
}

/**
 * Implements hook_views_pre_view() for node templates.
 *
 * Also injects the resolved Campus Champions AI Mentorship program tid into
 * the mentorship_status:page_2 program filter. The view config carries
 * a placeholder 0 because tids are environment-specific (see
 * _ccmnet_get_cc_program_tid()).
 */
function ccmnet_views_pre_view(ViewExecutable $view, string $display_id, array &$args): void {
  if ($view->id() == 'mentorship_status' && $display_id === 'block_1') {
    $view_filters = $view->display_handler->getOption('filters');
    $domain = \Drupal::service('access_misc.sitetools')->getDomainId();

    $view_filters['field_domain_access_target_id']['value'] = [];
    $view_filters['field_domain_access_target_id']['value'] = [$domain => $domain];
    $view->display_handler->setOption('filters', $view_filters);
  }
  if ($view->id() == 'mentorship_facet_search' && $display_id === 'block_1') {
    $view_filters = $view->display_handler->getOption('filters');
    $domain = \Drupal::service('access_misc.sitetools')->getDomainId();
    $view_filters['field_domain_access']['value']['value'] = $domain;
    $view->display_handler->setOption('filters', $view_filters);
  }
  if ($view->id() === 'mentorship_status' && $display_id === 'page_2') {
    $tid = _ccmnet_get_cc_program_tid();
    if (!$tid) {
      \Drupal::logger('ccmnet')->error('Campus Champions AI Mentorship term not found; mentorship_status:page_2 will return no results.');
      // Early-return: this branch is currently the last per-display block in
      // the hook. If shared logic is added below, refactor to per-display
      // helpers rather than carrying the early-return forward.
      return;
    }
    // Filter handler isn't built yet at pre_view; mutate display options
    // directly.
    $filters = $view->display_handler->getOption('filters');
    if (isset($filters['field_mentorship_program_target_id'])) {
      $filters['field_mentorship_program_target_id']['value'] = [$tid => (string) $tid];
      $view->display_handler->setOption('filters', $filters);
    }
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function ccmnet_page_attachments_alter(array &$attachments): void {
  // Get path.
  $module_path = \Drupal::service('module_handler')->getModule('ccmnet')->getPath();
  $token = \Drupal::token();
  $domainName = Html::getClass($token->replace(t('[domain:name]')));
  if ($domainName == 'ccmnet') {
    $attachments['#attached']['html_head_link'][0] = [
      [
        "rel" => "icon",
        "href" => "/$module_path/images/ccmnet-favicon.ico",
        "type" => "image/x-icon",
      ],
    ];
  }
}

/**
 * Implements hook_entity_insert().
 */
function ccmnet_entity_insert(EntityInterface $entity): void {
  $type = $entity->bundle();
  if ($type == 'mentorship_engagement' && $entity instanceof ContentEntityInterface) {
    // Give badge to mentor or Mentee.
    $mentor = $entity->get('field_mentor')->getValue();
    $mentee = $entity->get('field_mentee')->getValue();

    $badge_tools = \Drupal::service('access_badges.badgeTools');

    // Get 'CCMNet Engagement Participant' term id.
    $match_badge = $badge_tools->getBadgeTid('CCMNet Engagement Participant');

    if ($mentor) {
      // Give 'CCMNet Engagement Participant' badge to mentor.
      $badge_tools->setUserBadge($match_badge, $mentor);
    }
    if ($mentee) {
      // Give 'CCMNet Engagement Participant' badge to mentee.
      $badge_tools->setUserBadge($match_badge, $mentee);
    }

    $message = t('We will notify you by email once your mentorship has been posted on the website.');
    \Drupal::messenger()->addMessage($message);
  }

  // Notify CCMNet PMs when new user is created with CCMNet program.
  if ($type == 'user') {
    if (_ccmnet_user_has_ccmnet_region($entity)) {
      _ccmnet_send_new_user_notification($entity);
    }
  }
}

/**
 * Implements hook_entity_update().
 */
function ccmnet_entity_update(EntityInterface $entity): void {
  // Notify CCMNet PMs when existing user is added to CCMNet program.
  if ($entity->bundle() == 'user') {
    // Check if user was previously in CCMNet region.
    $was_ccmnet = isset($entity->original) ? _ccmnet_user_has_ccmnet_region($entity->original) : FALSE;

    // Check if user is currently in CCMNet region.
    $is_ccmnet = _ccmnet_user_has_ccmnet_region($entity);

    // Send notification if user was just added to CCMNet.
    if ($is_ccmnet && !$was_ccmnet) {
      _ccmnet_send_new_user_notification($entity);
    }
  }
}

/**
 * Implements hook_entity_field_access().
 */
function ccmnet_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResult {
  // Restrict access to field_admin_notes on mentorship_engagement nodes.
  if ($field_definition->getName() == 'field_admin_notes' && $field_definition->getTargetEntityTypeId() == 'node') {
    if ($items && $items->getEntity()->bundle() == 'mentorship_engagement') {
      $allowed_roles = ['administrator', 'ccmnet_pm', 'champions_mentorship_admin', 'campuschampionsadmin'];
      $user_roles = $account->getRoles();
      $has_access = !empty(array_intersect($allowed_roles, $user_roles));

      if (!$has_access) {
        return AccessResult::forbidden()->addCacheContexts(['user.roles']);
      }
    }
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_node_access().
 *
 * Scope CC-only edit roles (champions_mentorship_admin,
 * campuschampionsadmin) to mentorship engagements in the Campus
 * Champions AI Mentorship program. Users who also hold administrator
 * or ccmnet_pm are unaffected.
 */
function ccmnet_node_access(NodeInterface $node, string $op, AccountInterface $account): AccessResult {
  if ($node->bundle() !== 'mentorship_engagement') {
    return AccessResult::neutral();
  }
  if ($op !== 'update') {
    return AccessResult::neutral();
  }

  $roles = $account->getRoles();

  // Unrestricted edit roles fall through to standard permission checks.
  if (in_array('administrator', $roles, TRUE) || in_array('ccmnet_pm', $roles, TRUE)) {
    return AccessResult::neutral();
  }

  $cc_roles = ['champions_mentorship_admin', 'campuschampionsadmin'];
  if (!array_intersect($cc_roles, $roles)) {
    return AccessResult::neutral();
  }

  $cc_tid = _ccmnet_get_cc_program_tid();
  if (!$cc_tid) {
    // Term unresolved — fail closed. Otherwise both $cc_tid and an empty
    // $program_tid would be NULL and the !== check below would fall
    // through to neutral, accidentally widening edit access.
    return AccessResult::forbidden('Campus Champions program term unresolved.')
      ->addCacheContexts(['user.roles']);
  }
  $program_tid = $node->hasField('field_mentorship_program') && !$node->get('field_mentorship_program')->isEmpty()
    ? (int) $node->get('field_mentorship_program')->target_id
    : NULL;

  if ($program_tid !== $cc_tid) {
    return AccessResult::forbidden('Campus Champions admin roles can only edit Campus Champions AI Mentorship engagements.')
      ->addCacheContexts(['user.roles'])
      ->addCacheableDependency($node);
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_form_alter().
 */
function ccmnet_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id == 'node_mentorship_engagement_edit_form' || $form_id == 'node_mentorship_engagement_form') {
    // Set domain source to n/a by default.
    $form['field_domain_source']['widget']['#default_value'] = '_none';

    $form['title']['widget'][0]['#maxlength'] = 65;
    $form['body']['widget'][0]['summary']['#description'] = t('No html tags allowed in summary. Limit to 275 characters.');
    $form['body']['widget'][0]['summary']['#maxlength'] = 275;

    // Hide the Goals and Deliverables if the mentorship has not been approved.
    if (!$form['field_ccmnet_approved']['widget']['value']['#default_value']) {
      // Hide the entire goals and deliverables fieldsets.
      $form['group_goals']['#access'] = FALSE;
      $form['group_deliverables']['#access'] = FALSE;
      $form['field_milestone_description']['#access'] = FALSE;
      $form['field_milestone_completion_date']['#access'] = FALSE;
      $form['field_milestone_actual_date']['#access'] = FALSE;
      $form['field_milestone_description_1']['#access'] = FALSE;
      $form['field_completion_date_goal_1']['#access'] = FALSE;
      $form['field_actual_completion_date_1']['#access'] = FALSE;
      $form['field_milestone_description_2']['#access'] = FALSE;
      $form['field_completion_date_goal_2']['#access'] = FALSE;
      $form['field_actual_completion_date_2']['#access'] = FALSE;
      $form['field_goal_3_description']['#access'] = FALSE;
      $form['field_completion_date_goal_3']['#access'] = FALSE;
      $form['field_actual_completion_date_3']['#access'] = FALSE;
      $form['field_milestone_description_4']['#access'] = FALSE;
      $form['field_completion_date_goal_4']['#access'] = FALSE;
      $form['field_actual_completion_date_4']['#access'] = FALSE;
    }
    else {
      // Fixup date-time fields to act as date-only.
      $date_only_fields = [
        "field_milestone_actual_date",
        "field_actual_completion_date_1",
        "field_actual_completion_date_2",
        "field_actual_completion_date_3",
        "field_actual_completion_date_4",
        "field_milestone_completion_date",
        "field_completion_date_goal_1",
        "field_completion_date_goal_2",
        "field_completion_date_goal_3",
        "field_completion_date_goal_4",
        "field_launch_presentation_date",
        "field_wrap_presentation_date",
      ];
      foreach ($date_only_fields as $fieldname) {
        $form[$fieldname]['widget'][0]['value']['#date_time_element'] = 'none';
        $form[$fieldname]['widget'][0]['value']['#date_time_format'] = '';
      }
    }

    \Drupal::service('access_misc.tag_suggester')->build($form, [
      'weight' => 11,
      'panel_intro' => 'Get tag suggestions based on your description and then curate as necessary.',
    ]);

    $add_tags = \Drupal::service('access_misc.addtags');
    $output = $add_tags->getView();
    $tag_label = t('Tags');
    $tag_description = t('Select tags that relate to your engagement. Tags will help us find people with related expertise. Limited to 6 tags.');
    $tag_summary = t('Select Tags');

    $form['node_add_tags'] = [
      '#markup' => "<div class='font-bold form-required'>$tag_label</div>"
      . "<div class='tag-description'>$tag_description</div>"
      . "<div id='tag-suggestions'></div>"
      . "<details class='tags m-0 mb-8'><summary class='font-bold'>$tag_summary</summary>$output</details>",
      '#weight' => 11,
      '#allowed_tags' => [
        'ul',
        'li',
        'button',
        'details',
        'summary',
        'div',
        'span',
        'h2',
      ],
    ];

    // Lookup current user's username.
    $current_user = \Drupal::currentUser();
    $uid = $current_user->id();
    $user = User::load($uid);
    // Create variable 'First Last (ID)'.
    $author = $user->get('field_user_first_name')->value . ' ' . $user->get('field_user_last_name')->value . ' (' . $uid . ')';

    $form['field_me_looking_for']['widget']['#attributes']['onchange'] = "setMentoree('$author')";

    // Set mentor mentee fields to author on opposite from selection.
    // $form['field_me_looking_for']['#ajax'] = [
    // 'callback' => 'ccmnet_access_mentorship_engagement_select_mentoree',
    // 'event' => 'autocompleteselect',
    // 'wrapper' => 'mentoree',
    // ];
    // Attach javascript.
    $form['#attached']['library'][] = 'ccmnet/mentorship_engagement';

    $form['#validate'][] = 'ccmnet_access_mentorship_engagement_validate';

    // Only create mentorships on ccmnet domain.
    $token = \Drupal::token();
    $domainName = Html::getClass($token->replace(t('[domain:name]')));
    if ($domainName != 'ccmnet') {
      \Drupal::messenger()->addWarning(t('You must be on the CCMNet domain to create a mentorship engagement.'));
      $form['#access'] = FALSE;
    }
    array_unshift($form['actions']['submit']['#submit'], 'ccmnet_set_domain_submit');
  }
  elseif ($form_id == 'user_register_form' || $form_id == 'user_form') {
    // For forms on ccmnet domain only:
    // Hide region field for both user registration and user edit.
    // For user registration only, add handlers to add user to CCMNet
    // program + affinity group.
    $token = \Drupal::token();
    $domainName = t("[domain:name]");
    $current_domain_name = Html::getClass($token->replace($domainName));

    if ($current_domain_name == 'ccmnet') {
      $form['field_region']['widget']['#access'] = FALSE;
      if ($form_id == 'user_register_form') {
        // First handler called before user saved; the second afterwards.
        array_unshift($form['actions']['submit']['#submit'], 'ccmnet_add_program_form_submit');
        $form['actions']['submit']['#submit'][] = 'ccmnet_add_ag_form_submit';
      }
    }
  }
}

/**
 * Validate handler for mentorship_engagement form.
 *
 * @param array<string, mixed> $form
 *   The form array.
 */
function ccmnet_access_mentorship_engagement_validate(array &$form, FormStateInterface $form_state): void {
  $values = $form_state->getValues();

  $summary = $values['body'][0]['summary'];
  $tags = $values['field_tags'];

  // Check if summary contains html.
  if (preg_match('/<[^>]*>/', $summary)) {
    $form_state->setErrorByName('body][0][summary', t('Summary cannot contain html tags.'));
  }

  if (count($tags) > 6) {
    $form_state->setErrorByName('Tags', t('You can only select 6 tags. Please remove some tags.'));
  }
}

/**
 * Ajax callback function to replace the section with '#markup'.
 *
 * @param array<string, mixed> $form
 *   The form array.
 *
 * @return array<string, mixed>
 *   The updated section of the form.
 */
function ccmnet_access_mentorship_engagement_select_mentoree(array &$form, FormStateInterface $form_state): array {
  // Lookup current user's username.
  $current_user = \Drupal::currentUser();
  $uid = $current_user->id();
  $user = User::load($uid);

  $form['field_mentee']['widget'][0]['#default_value'] = $user;
  $form['field_mentee']['widget'][0]['target_id']['#attributes']['data-suggest'] = 1;

  // Return the updated section.
  return $form['group_mentoree_container'];
}

/**
 * Submit handler from hook form_alter user_register_form.
 *
 * Add user to CCMNet program (aka region).
 *
 * @param array<string, mixed> $form
 *   The form array.
 */
function ccmnet_add_program_form_submit(array &$form, FormStateInterface $form_state): void {
  $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['name' => 'CCMNet']);
  $term = reset($term);
  $form_state->setValue('field_region', [['target_id' => $term->id()]]);
}

/**
 * Submit handler from hook form_alter for node_mentorship_engagement_form.
 *
 * Set domain.
 *
 * @param array<string, mixed> $form
 *   The form array.
 */
function ccmnet_set_domain_submit(array $form, FormStateInterface &$form_state): void {
  $env = getenv('PANTHEON_ENVIRONMENT');
  $cc = SiteTools::DOMAIN_CAMPUS_CHAMPIONS;
  $mentor_program = $form_state->getValue('field_mentorship_program');
  $domain_access = $form_state->getValue('field_domain_access');

  $set_cc = TRUE;
  foreach ($domain_access as $key => $value) {
    if ($value['target_id'] == $cc) {
      $set_cc = FALSE;
      break;
    }
  }

  if ($mentor_program) {
    // Add campuschampions_cyberinfrastructure_org to domain access when CC
    // Ai mentorship program is selected.
    if ($mentor_program[0]['target_id'] == 910) {
      if ($set_cc) {
        $domain_access[] = ['target_id' => $cc];
        $form_state->setValue('field_domain_access', $domain_access);
      }
    }
    // Remove campuschampions_cyberinfrastructure_org from domain access
    // when no program is selected.
    if ($mentor_program[0]['target_id'] == NULL) {
      $da = $form_state->getValue('field_domain_access');
      foreach ($da as $key => $value) {
        if ($value['target_id'] == $cc) {
          unset($da[$key]);
        }
      }
      $form_state->setValue('field_domain_access', $da);
    }
  }
  elseif (!$set_cc) {
    // Remove campuschampions_cyberinfrastructure_org from domain access
    // when n/a program is selected.
    $da = $form_state->getValue('field_domain_access');
    foreach ($da as $key => $value) {
      if ($value['target_id'] == $cc) {
        unset($da[$key]);
      }
    }
    $form_state->setValue('field_domain_access', $da);
  }

  if ($env == 'live') {
    $form_state->setValue('field_domain_source', [['target_id' => SiteTools::DOMAIN_CCMNET]]);
  }
}

/**
 * Submit handler from hook form_alter for user_register_form.
 *
 * Add new user to CCMNet Mentors affinity group.
 *
 * @param array<string, mixed> $form
 *   The form array.
 */
function ccmnet_add_ag_form_submit(array $form, FormStateInterface &$form_state): void {
  $uid = $form_state->getValue('uid');

  ccmnet_add_to_ccmnet_ag($uid, TRUE);
}

/**
 * Add user to CCMNet Mentors affinity group.
 *
 * Unless user previously blocked this group previously by unjoining.
 *
 * @param int|string|null $uid
 *   The user id.
 * @param bool $isNewUser
 *   Whether the user is newly created.
 */
function ccmnet_add_to_ccmnet_ag($uid, bool $isNewUser): void {
  $user = User::load($uid);
  $ccmnet_term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['name' => 'CCMNet Mentoring']);
  $ccmnet_term = reset($ccmnet_term);
  $flag = \Drupal::service('cssn.flag');

  if (!$isNewUser) {
    $userBlockedArray = $user->get('field_blocked_ag_tax')->getValue();
    foreach ($userBlockedArray as $userBlock) {
      if ($userBlock['target_id'] == $ccmnet_term->id()) {
        return;
      }
    }
  }

  // This service only sets flag if not already set.
  $flag->setFlag('affinity_group', $ccmnet_term, $user);
}

/**
 * Implements hook_user_login().
 *
 * If on ccmnet domain, a user logging in while be added to ccmnet program,
 * ccmnet role, and ccmnet AG if not already there.
 * If user is new to ccmnet (defined by lack of ccmnet program on the user),
 * a welcome email is sent.
 */
function ccmnet_user_login(UserInterface $account): void {
  $token = \Drupal::token();
  $domainName = t("[domain:name]");
  $current_domain_name = Html::getClass($token->replace($domainName));
  if ($current_domain_name == 'ccmnet') {
    $current_user = \Drupal::currentUser();
    $uid = $current_user->id();
    $user = User::load($uid);

    // Affinity group.
    ccmnet_add_to_ccmnet_ag($uid, FALSE);

    // Role.
    $roles = $current_user->getRoles();
    if (!in_array('ccmnet', $roles)) {
      $user->addRole('ccmnet');
      $user->save();
    }

    // Program.
    $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['name' => 'CCMNet']);
    $term_id = reset($term)->id();

    $new_ccmnet_user = FALSE;
    $programs = $user->get('field_region')->referencedEntities();
    if (count($programs) == 0) {
      $user->set('field_region', $term_id);
      $new_ccmnet_user = TRUE;
    }
    elseif (!array_filter(
      $programs,
      function ($program) use ($term_id) {
        return $program->id() == $term_id;
      }
    )) {
      $user->get('field_region')->appendItem(['target_id' => $term_id]);
      $new_ccmnet_user = TRUE;
    }

    // Send the welcome email.
    if ($new_ccmnet_user) {
      $link = "https://ccmnet.org/community-persona/$uid";
      $variables = [
        'url' => $link,
      ];
      $email = $user->getEmail();
      $policy = 'ccmnet';
      $policy_subtype = 'ccmnet_welcome';
      \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $email, $variables);
      $user->save();
    }
  }
}

/**
 * Implements hook_node_insert().
 */
function ccmnet_node_insert(EntityInterface $entity): void {
  if ($entity->bundle() == 'mentorship_engagement' && $entity instanceof ContentEntityInterface) {
    $options = ['absolute' => TRUE];
    $nid = $entity->id();
    $program = $entity->get('field_mentorship_program')->getValue();
    $policy = 'ccmnet';
    $here = Url::fromRoute('entity.node.canonical', ['node' => $nid], $options);
    $link = $here->toString(TRUE)->getGeneratedUrl();

    $env = getenv('PANTHEON_ENVIRONMENT');

    // Get current users email.
    $current_user = \Drupal::currentUser();
    $user = User::load($current_user->id());
    $email = $user->getEmail();

    // Mail person creating mentorship engagement.
    $policy_subtype = 'mentorship_created';
    $link_title = t('here');
    $variables = [
      'title' => $link_title,
      'url' => $link,
    ];

    \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $email, $variables);

    // Send email to CCMNet admin.
    // mentorship_created_admin.
    $role = $env == 'live' ? 'ccmnet_admin' : 'site_developer';

    if ($program) {
      if ($program[0]['target_id'] == 910 && $env == 'live') {
        $role = 'champions_mentorship_admin';
      }
    }

    $ccmnet_admin_emails = \Drupal::service('access_misc.usertools')->getEmails([$role], []);
    $policy_subtype = 'mentorship_created_admin';

    \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $ccmnet_admin_emails, $variables);
  }
}

/**
 * Check if user has CCMNet region (835).
 *
 * @param \Drupal\Core\Entity\EntityInterface $user
 *   The user entity.
 *
 * @return bool
 *   TRUE if user has CCMNet region, FALSE otherwise.
 */
function _ccmnet_user_has_ccmnet_region(EntityInterface $user): bool {
  if (!$user instanceof ContentEntityInterface) {
    return FALSE;
  }
  $region = $user->get('field_region')->getValue();
  if ($region) {
    foreach ($region as $region_value) {
      if ($region_value['target_id'] == "835") {
        return TRUE;
      }
    }
  }
  return FALSE;
}

/**
 * Send CCMNet notification when user is added to CCMNet program.
 */
function _ccmnet_send_new_user_notification(EntityInterface $entity): void {
  $policy = 'ccmnet';
  $env = getenv('PANTHEON_ENVIRONMENT');

  // Get the current domain to determine which role to use.
  $domain = \Drupal::service('domain.negotiator')->getActiveDomain()->id();

  $role = $env == 'live' ? 'ccmnet_pm' : 'site_developer';

  if ($domain == 'campuschampions_cyberinfrastructure_org') {
    $role = $env == 'live' ? 'champions_mentorship_admin' : 'site_developer';
  }

  $ccmnet_emails = \Drupal::service('access_misc.usertools')
    ->getEmails([$role], []);
  $uid = $entity->id();

  // Link to /community-persona/uid.
  $options = ['absolute' => TRUE];
  $here = Url::fromUri('internal:/community-persona/' . $uid, $options);
  $link = $here->toString(TRUE)->getGeneratedUrl();

  $policy_subtype = 'ccmnet_new_user';
  $variables = [
    'title' => t('Click here to view'),
    'url' => $link,
  ];

  \Drupal::service('access_misc.symfony.mail')
    ->email($policy, $policy_subtype, $ccmnet_emails, $variables);
}

/**
 * Implements hook_entity_presave().
 */
function ccmnet_entity_presave(EntityInterface $entity): void {
  $original = $entity->original ?? NULL;
  if ($entity->bundle() == 'mentorship_engagement' && $entity instanceof NodeInterface && $original instanceof ContentEntityInterface) {
    // Give badge to mentor or Mentee.
    $mentor = $entity->get('field_mentor')->getValue();
    $mentee = $entity->get('field_mentee')->getValue();
    $program = $entity->get('field_mentorship_program')->getValue();

    $badge_tools = \Drupal::service('access_badges.badgeTools');

    // Get 'CCMNet Engagement Participant' term id.
    $match_badge = $badge_tools->getBadgeTid('CCMNet Engagement Participant');

    if ($mentor) {
      // Give 'CCMNet Engagement Participant' badge to mentor.
      $badge_tools->setUserBadge($match_badge, $mentor);
    }
    if ($mentee) {
      // Give 'CCMNet Engagement Participant' badge to mentee.
      $badge_tools->setUserBadge($match_badge, $mentee);
    }

    // Mentorship title.
    $title = $entity->getTitle();

    // Mailer Policy type.
    $policy = 'ccmnet';

    // Get environment.
    $env = getenv('PANTHEON_ENVIRONMENT');

    // Link back to mentorship.
    $options = ['absolute' => TRUE];
    $nid = $entity->id();
    $here = Url::fromRoute('entity.node.canonical', ['node' => $nid], $options);
    $link = $here->toString(TRUE)->getGeneratedUrl();

    $field_looking = $entity->get('field_me_looking_for')->getValue();
    $field_looking_value = $field_looking[0]['value'] ?? NULL;

    $state_values = $entity->get('field_me_state')->getValue();
    $state = $state_values[0]['target_id'] ?? NULL;
    $prev_state_values = $original->get('field_me_state')->getValue();
    $prev_state = $prev_state_values[0]['target_id'] ?? NULL;

    $approved_values = $entity->get('field_ccmnet_approved')->getValue();
    $approved_state = $approved_values[0]['value'] ?? NULL;
    $prev_approved_values = $original->get('field_ccmnet_approved')->getValue();
    $prev_approved_state = $prev_approved_values[0]['value'] ?? NULL;

    // If state is changed to 'Approved', send email to ccmnet pm.
    if ($approved_state == 1 && $prev_approved_state != $approved_state) {
      $role = $env == 'live' ? 'ccmnet_pm' : 'site_developer';

      if ($program) {
        if ($program[0]['target_id'] == 910 && $env == 'live') {
          $role = 'champions_mentorship_admin';
        }
      }

      $ccmnet_emails = \Drupal::service('access_misc.usertools')->getEmails([$role], []);
      $policy_subtype = 'mentorship_approved_ccmnet_pm';
      $variables = [
        'title' => t('here'),
        'url' => $link,
      ];

      \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $ccmnet_emails, $variables);
    }

    // If mentor is added or changed, send email to new mentor and liaison.
    if ($field_looking_value === 'mentor') {
      $policy_subtype = 'mentor_changed';
      $mentor = $entity->get('field_mentor')->getValue();
      $mentor_update = 0;
      $og_mentor = [];

      foreach ($original->get('field_mentor')->getValue() as $og_mentor_id) {
        $og_mentor[] = $og_mentor_id['target_id'];
      }

      foreach ($mentor as $mentor_id) {
        $current_mentor_id = $mentor_id['target_id'];

        if (!in_array($current_mentor_id, $og_mentor)) {
          $mentor_user = User::load($current_mentor_id);
          $mentor_email = $mentor_user->getEmail();
          $variables = [
            'title' => $title,
            'url' => $link,
          ];
          \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $mentor_email, $variables);
          $mentor_update = 1;
        }
      }

      $leadership = $entity->get('field_me_ccmnet_leadership')->getValue();
      $liaison = $leadership[0]['target_id'] ?? 0;
      if ($liaison && $mentor_update) {
        $liaison_user = User::load($liaison);
        $liaison_email = $liaison_user->getEmail();
        $policy_subtype = 'liaison_mentor_mentee_changed';
        $variables = [
          'title' => $title,
          'url' => $link,
        ];
        \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $liaison_email, $variables);
      }
    }

    // If mentee is added or changed, send email to new mentee and liaison.
    if ($field_looking_value === 'mentee') {
      $policy_subtype = 'mentee_changed';
      $mentee = $entity->get('field_mentee')->getValue();
      $mentee_update = 0;
      $og_mentee = [];

      foreach ($original->get('field_mentee')->getValue() as $og_mentee_id) {
        $og_mentee[] = $og_mentee_id['target_id'];
      }

      foreach ($mentee as $mentee_id) {
        $current_mentee_id = $mentee_id['target_id'];
        if (!in_array($current_mentee_id, $og_mentee)) {
          $mentee_user = User::load($current_mentee_id);
          $mentee_email = $mentee_user->getEmail();
          $variables = [
            'title' => $title,
            'url' => $link,
          ];
          \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $mentee_email, $variables);
          $mentee_update = 1;
        }
      }

      $leadership = $entity->get('field_me_ccmnet_leadership')->getValue();
      $liaison = $leadership[0]['target_id'] ?? 0;

      if ($liaison && $mentee_update) {
        $liaison_user = User::load($liaison);
        $liaison_email = $liaison_user->getEmail();
        $policy_subtype = 'liaison_mentor_mentee_changed';
        $variables = [
          'title' => $title,
          'url' => $link,
        ];
        \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $liaison_email, $variables);
      }
    }

    // If state is changed to 'In Progress', send email to ccmnet pm and
    // liaison.
    if ($state && $prev_state && ($state != $prev_state) && ($state == 829)) {
      $liaison_values = $entity->get('field_me_ccmnet_leadership')->getValue();
      $liaison = $liaison_values[0]['target_id'] ?? NULL;
      if (!$liaison) {
        return;
      }
      $liaison_user = User::load($liaison);
      if (!$liaison_user) {
        return;
      }
      $liaison_email = $liaison_user->getEmail();
      $policy_subtype = 'mentorship_in_progress';

      $role = $env == 'live' ? 'ccmnet_pm' : 'site_developer';

      if ($program) {
        if ($program[0]['target_id'] == 910 && $env == 'live') {
          $role = 'champions_mentorship_admin';
        }
      }

      // Get list of unique emails.
      $progress_emails = \Drupal::service('access_misc.usertools')->getEmails([$role], [$liaison_email]);
      $variables = [
        'title' => t('Click here to view'),
        'url' => $link,
      ];

      \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $progress_emails, $variables);
    }
  }
}

/**
 * Implements hook_entity_extra_field_info().
 */
function ccmnet_entity_extra_field_info(): array {
  $extra = [];
  $extra['node']['mentorship_engagement']['display']['field_mentorship_pretitle'] = [
    'label' => t('Pretitle'),
    'description' => t('Pretitle pseudo field.'),
    'weight' => 0,
    'visible' => TRUE,
  ];

  return $extra;
}

/**
 * Implements hook_ENTITY_TYPE_view().
 *
 * If state is recruiting, return string for pre-title display:
 * Recruiting: mentor / Recruiting: mentee.
 */
function ccmnet_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  if ($entity->bundle() == 'mentorship_engagement' && $entity instanceof ContentEntityInterface) {
    $recruitingTerm = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['name' => 'recruiting']);
    $recruitingTermId = array_keys($recruitingTerm)[0];
    $state = $entity->get('field_me_state')->getValue()[0]['target_id'];

    if ($state == $recruitingTermId) {
      if ($display->getComponent('field_mentorship_pretitle')) {
        $field_looking = $entity->get('field_me_looking_for')->getValue();

        $field_looking = '<span class="pt-2 pl-2 ">Recruiting: ' . $field_looking[0]['value'] . '<span>';
        $module_path = \Drupal::service('extension.list.module')
          ->getPath('ccmnet');
        $image_path = $module_path . '/images/star-o.png';
        $image_url = \Drupal::service('file_url_generator')
          ->generateAbsoluteString($image_path);
        $img = '<img src="' . $image_url . '" alt="star" />';
        $text = '<div class="mentorship_pretitle d-flex align-items-center text-uppercase">' . $img . $field_looking . '</div>';

        $build['field_mentorship_pretitle'] = [
          '#type' => 'markup',
          '#markup' => $text,
        ];
      }
    }
  }
}

/**
 * Implements hook_cron().
 *
 *  This function runs at 1:00am on the live environment to send
 *  emails to mentorship authors when someone has expressed interest in their
 *  mentorship. It collects the list of interested mentorships from the state,
 *  constructs links to those mentorships, and sends an email to the authors.
 *  It also sends a summary email to the CCMNet PMs with the list of links.
 *  The state is reset to 0 after sending the emails.
 */
function ccmnet_cron(): void {
  $env = getenv('PANTHEON_ENVIRONMENT');
  $cypress_test = getenv('CYPRESS_TEST_MODE');

  // Allow testing mode to bypass environment and time restrictions.
  if ($env == 'live' || $cypress_test == 'true') {
    // Set the active domain so hook_mailer_init() routes emails through
    // the CCMNet SMTP transport.
    $negotiator = \Drupal::service('domain.negotiator');
    $original_domain = $negotiator->getActiveDomain();
    $domain = Domain::load('ccmnet_org');
    if ($domain) {
      $negotiator->setActiveDomain($domain);
    }

    // Send interested email between 1:00 am and 1:59 am (or anytime in
    // test mode).
    if (date('G', time()) == 01 || $cypress_test == 'true') {
      $interested_status = \Drupal::state()->get('access_mentorship_interested');
      $interested_list = json_decode($interested_status, TRUE);
      if (empty($interested_list) || !is_array($interested_list)) {
        \Drupal::logger('ccmnet')->warning('No interested list or invalid JSON: @status', ['@status' => $interested_status]);
        return;
      }
      $policy = 'ccmnet';
      $policy_subtype = 'cron_author_update';
      $interested_links['ccmnet'] = '<ul>';
      $interested_links['cc'] = '<ul>';
      // Send email to each author.
      foreach ($interested_list as $interested_nid) {
        $node = \Drupal::entityTypeManager()->getStorage('node')->load($interested_nid);
        if (!$node) {
          \Drupal::logger('ccmnet')->warning('Could not load node @nid', ['@nid' => $interested_nid]);
          continue;
        }

        $author = $node->getOwner()->getEmail();
        $options = ['absolute' => TRUE];
        $here = Url::fromRoute('entity.node.canonical', ['node' => $interested_nid], $options);
        $link = $here->toString(TRUE)->getGeneratedUrl();
        $node_title = $node->getTitle();
        $mentorship_program = $node->get('field_mentorship_program')->getString();
        if ($mentorship_program == 910) {
          $interested_links['cc'] .= '<li><a href="' . $link . '">' . $node_title . '</a></li>';
        }
        else {
          $interested_links['ccmnet'] .= '<li><a href="' . $link . '">' . $node_title . '</a></li>';
        }
        $title = t('click here');

        $variables = [
          'title' => $title,
          'url' => $link,
        ];

        \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $author, $variables);
        \Drupal::logger('ccmnet')->info('Sent interested email to @user for node @nid', [
          '@user' => $author,
          '@nid' => $interested_nid,
        ]);
      }
      $interested_links['cc'] .= '</ul>';
      $interested_links['ccmnet'] .= '</ul>';
      // 2nd email: send collection of request links to all with ccmnet_pm role.
      $policy_subtype = 'cron_role_update';

      if ($interested_links['cc'] != '<ul></ul>') {
        $cc_role = $env == 'live' ? 'champions_mentorship_admin' : 'site_developer';
        $cc_admin_emails = \Drupal::service('access_misc.usertools')->getEmails([$cc_role], []);
        $cc_variables = [
          'extra' => $interested_links['cc'],
        ];
        \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $cc_admin_emails, $cc_variables);
        \Drupal::logger('ccmnet')->info('Sent interested summary email to @role', ['@role' => $cc_role]);
      }
      if ($interested_links['ccmnet'] != '<ul></ul>') {
        $ccmnet_role = $env == 'live' ? 'ccmnet_pm' : 'site_developer';
        $ccmnet_admin_emails = \Drupal::service('access_misc.usertools')->getEmails([$ccmnet_role], []);
        $variables = [
          'extra' => $interested_links['ccmnet'],
        ];
        \Drupal::service('access_misc.symfony.mail')->email($policy, $policy_subtype, $ccmnet_admin_emails, $variables);
        \Drupal::logger('ccmnet')->info('Sent interested summary email to @role', ['@role' => $ccmnet_role]);
      }

      \Drupal::state()->set('access_mentorship_interested', 0);
    }

    // Restore the original active domain so we don't pollute state
    // for anything else running in this process.
    // @phpstan-ignore-next-line if.alwaysTrue
    if ($original_domain) {
      $negotiator->setActiveDomain($original_domain);
    }
  }
}

/**
 * Resolve the "Campus Champions AI Mentorship" program term ID.
 *
 * The term is created by ccmnet_update_10003() without an explicit tid, so
 * each environment auto-assigns its own. Resolve by name + vocabulary at
 * runtime to avoid hardcoding an environment-specific value. Cached per
 * request via drupal_static().
 *
 * @return int|null
 *   The tid, or NULL if the term doesn't exist.
 */
function _ccmnet_get_cc_program_tid(): ?int {
  $cached = &drupal_static(__FUNCTION__);
  if ($cached !== NULL) {
    return $cached ?: NULL;
  }
  $terms = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->loadByProperties([
      'name' => 'Campus Champions AI Mentorship',
      'vid' => 'mentorship_programs',
    ]);
  $term = reset($terms);
  $cached = $term ? (int) $term->id() : 0;
  return $cached ?: NULL;
}
