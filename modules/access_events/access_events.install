<?php

/**
 * @file
 * Install, update and uninstall functions for the access_events module.
 */

use Drupal\Core\Database\Database;
use Drupal\search_api\Entity\Index;
use Drupal\access_misc\Plugin\Util\SiteTools;

/**
 * Set domain access for Event Series content items.
 */
function access_events_update_10001() {
  $database = Database::getConnection();

  // Define the specific event series that should have openondemand domain
  $openondemand_series = [
    515, // ACCESS and NAIRR Pilot Office Hours
    516, // ACCESS and NAIRR Pilot Office Hours
    477, // Open OnDemand Office Hours
    252, // Open OnDemand Tips and Tricks Call
  ];

  // Get all event series IDs
  $event_series_ids = $database->query("SELECT id FROM eventseries")->fetchCol();

  if (empty($event_series_ids)) {
    return 'No event series found.';
  }

  // Clear existing domain access entries for event series
  $database->delete('eventseries__domain_access')
    ->condition('entity_id', $event_series_ids, 'IN')
    ->execute();

  // Also clear revision table
  $database->delete('eventseries_revision__domain_access')
    ->condition('entity_id', $event_series_ids, 'IN')
    ->execute();

  $batch_size = 50;
  $processed = 0;

  foreach (array_chunk($event_series_ids, $batch_size) as $batch) {
    foreach ($batch as $series_id) {
      // Get the current revision ID for this event series
      $revision_id = $database->query("SELECT vid FROM eventseries WHERE id = :id", [':id' => $series_id])->fetchField();

      if (!$revision_id) {
        continue;
      }

      // Determine which domain(s) to set
      $domains_to_set = [];

      if (in_array($series_id, $openondemand_series)) {
        // OnDemand series get both domains
        $domains_to_set = [SiteTools::DOMAIN_ACCESS_SUPPORT, SiteTools::DOMAIN_OPENONDEMAND];
      } else {
        // All other series get ACCESS Support domain
        $domains_to_set = [SiteTools::DOMAIN_ACCESS_SUPPORT];
      }

      // Insert domain access records for each domain
      foreach ($domains_to_set as $domain_id) {
        // Insert into main field table
        $database->insert('eventseries__domain_access')
          ->fields([
            'bundle' => 'default',
            'deleted' => 0,
            'entity_id' => $series_id,
            'revision_id' => $revision_id,
            'langcode' => 'en',
            'delta' => array_search($domain_id, $domains_to_set),
            'domain_access_target_id' => $domain_id,
          ])
          ->execute();

        // Insert into revision table
        $database->insert('eventseries_revision__domain_access')
          ->fields([
            'bundle' => 'default',
            'deleted' => 0,
            'entity_id' => $series_id,
            'revision_id' => $revision_id,
            'langcode' => 'en',
            'delta' => array_search($domain_id, $domains_to_set),
            'domain_access_target_id' => $domain_id,
          ])
          ->execute();
      }

      $processed++;
    }
  }

  return t('Updated domain access for @count event series. OnDemand series (@ondemand_count) have both ACCESS Support and OnDemand domains, others have ACCESS Support domain only.', [
    '@count' => $processed,
    '@ondemand_count' => count($openondemand_series),
  ]);
}

/**
 * Set domain access for Event Instance content items based on their Event Series.
 */
function access_events_update_10002() {
  $database = Database::getConnection();

  // Define the specific event series that should have openondemand domain
  $openondemand_series = [
    515, // ACCESS and NAIRR Pilot Office Hours
    516, // ACCESS and NAIRR Pilot Office Hours
    477, // Open OnDemand Office Hours
    252, // Open OnDemand Tips and Tricks Call
  ];

  // Get all event instances with their series IDs
  $event_instances = $database->query("
    SELECT ei.id, ei.vid, efd.eventseries_id
    FROM eventinstance ei
    JOIN eventinstance_field_data efd ON ei.id = efd.id
    WHERE efd.eventseries_id IS NOT NULL
  ")->fetchAll();

  if (empty($event_instances)) {
    return 'No event instances found.';
  }

  // Get all event instance IDs for clearing existing data
  $event_instance_ids = array_column($event_instances, 'id');

  // Clear existing domain access entries for event instances
  $database->delete('eventinstance__domain_access')
    ->condition('entity_id', $event_instance_ids, 'IN')
    ->execute();

  // Also clear revision table
  $database->delete('eventinstance_revision__domain_access')
    ->condition('entity_id', $event_instance_ids, 'IN')
    ->execute();

  $batch_size = 50;
  $processed = 0;
  $ondemand_instances = 0;

  foreach (array_chunk($event_instances, $batch_size) as $batch) {
    foreach ($batch as $instance) {
      $instance_id = $instance->id;
      $revision_id = $instance->vid;
      $series_id = $instance->eventseries_id;

      // Determine which domain(s) to set based on the event series
      $domains_to_set = [];

      if (in_array($series_id, $openondemand_series)) {
        // OnDemand series instances get both domains
        $domains_to_set = [SiteTools::DOMAIN_ACCESS_SUPPORT, SiteTools::DOMAIN_OPENONDEMAND];
        $ondemand_instances++;
      } else {
        // All other series instances get ACCESS Support domain
        $domains_to_set = [SiteTools::DOMAIN_ACCESS_SUPPORT];
      }

      // Insert domain access records for each domain
      foreach ($domains_to_set as $domain_id) {
        // Insert into main field table
        $database->insert('eventinstance__domain_access')
          ->fields([
            'bundle' => 'default',
            'deleted' => 0,
            'entity_id' => $instance_id,
            'revision_id' => $revision_id,
            'langcode' => 'en',
            'delta' => array_search($domain_id, $domains_to_set),
            'domain_access_target_id' => $domain_id,
          ])
          ->execute();

        // Insert into revision table
        $database->insert('eventinstance_revision__domain_access')
          ->fields([
            'bundle' => 'default',
            'deleted' => 0,
            'entity_id' => $instance_id,
            'revision_id' => $revision_id,
            'langcode' => 'en',
            'delta' => array_search($domain_id, $domains_to_set),
            'domain_access_target_id' => $domain_id,
          ])
          ->execute();
      }

      $processed++;
    }
  }

  return t('Updated domain access for @count event instances. OnDemand instances (@ondemand_count) have both ACCESS Support and OnDemand domains, others have ACCESS Support domain only.', [
    '@count' => $processed,
    '@ondemand_count' => $ondemand_instances,
  ]);
}

/**
 * Reindex the events search API index after domain access changes.
 */
function access_events_update_10003() {
  // Reindex the events search API index to pick up domain access changes
  $events_index = Index::load('events');
  if ($events_index) {
    $events_index->reindex();

    // Process the indexing immediately
    $indexed_count = $events_index->indexItems();

    return t('Events search index has been reindexed. Processed @count items to pick up domain access changes.', [
      '@count' => $indexed_count,
    ]);
  } else {
    return t('Warning: Events search index not found. Manual reindexing may be required.');
  }
}

/**
 * Helper function to rebuild and index the events search API index.
 */
function _access_events_index_events() {
  try {
    // Load the index using entity type manager
    $index = \Drupal::entityTypeManager()->getStorage('search_api_index')->load('events');
    if ($index) {
      // Clear the index first to ensure clean rebuild
      $index->clear();

      // Reindex all items (queues them)
      $index->reindex();

      // Process the indexing queue immediately (don't wait for cron)
      $indexed = $index->indexItems(-1); // -1 means index all queued items

      \Drupal::logger('access_events')->info('Successfully rebuilt and indexed @count events in search API.', ['@count' => $indexed]);

      return $indexed;
    } else {
      \Drupal::logger('access_events')->warning('Events search API index not found.');
      return 0;
    }
  } catch (Exception $e) {
    \Drupal::logger('access_events')->error('Failed to index events search API: @error', ['@error' => $e->getMessage()]);
    return 0;
  }
}

/**
 * Reindex events for new EventAffinityGroup processor and removed custom_event_no_show field.
 */
function access_events_update_10004() {
  // Clear plugin caches to recognize the new EventAffinityGroup processor
  \Drupal::service('plugin.manager.search_api.processor')->clearCachedDefinitions();

  // Use helper function to rebuild and index
  $indexed_count = _access_events_index_events();

  if ($indexed_count > 0) {
    return t('Events search index has been cleared and reindexed. Processed @count items to add affinity group data and remove obsolete no_show field.', [
      '@count' => $indexed_count,
    ]);
  }
  else {
    return t('Warning: Events search index not found or no items indexed. Manual reindexing may be required.');
  }
}

/**
 * Migrate event_type field from 'other' to 'zz_other'.
 */
function access_events_update_10005() {
  $database = Database::getConnection();

  // Update the main field table
  $updated = $database->update('eventseries__field_event_type')
    ->fields(['field_event_type_value' => 'zz_other'])
    ->condition('field_event_type_value', 'other')
    ->execute();

  // Update the revision table
  $updated_revisions = $database->update('eventseries_revision__field_event_type')
    ->fields(['field_event_type_value' => 'zz_other'])
    ->condition('field_event_type_value', 'other')
    ->execute();

  return t('Migrated @count event series from "other" to "zz_other" event type (@revisions revisions updated).', [
    '@count' => $updated,
    '@revisions' => $updated_revisions,
  ]);
}

/**
 * Migrate event email text fields from fragments to full email body templates.
 */
function access_events_update_10006() {
  $templates = _access_events_email_templates();

  // Map: field_name => [template_key, old fragment insertion token].
  $field_map = [
    'field_screen_survey_email_text' => 'registration',
    'field_pre_survey_email_text' => 'approval',
    'field_post_survey_email_text' => 'post_survey',
  ];

  // The old templates with a placeholder where the fragment was inserted.
  // We'll wrap existing fragments into the full template at this marker.
  $old_templates = [
    'field_screen_survey_email_text' => [
      'before' => '<p>Dear {{ name }},</p>' . "\n"
        . '<p>Thank you for registering for <strong>{{ title_link }}</strong> scheduled for {{ start_date }}. Your registration has been submitted and is under review.</p>' . "\n"
        . '<p>You will receive another email once your registration has been reviewed and approved. Approval typically takes 1-2 business days.</p>' . "\n",
      'after' => '{% if screen_survey_url %}<p><a href="{{ screen_survey_url }}">{{ screen_survey_url }}</a></p>{% endif %}' . "\n"
        . '<p>____<br>This message is sent through the ACCESS-CI event registration system.</p>',
    ],
    'field_pre_survey_email_text' => [
      'before' => '<p>Dear {{ name }},</p>' . "\n"
        . '<p>Congratulations! Your registration for <strong>{{ title_link }}</strong> on {{ start_date }} has been confirmed.</p>' . "\n"
        . '<p>Here are the details:</p>' . "\n"
        . '<ul><li><strong>Location (if applicable):</strong> {{ location }}</li>' . "\n"
        . '<li><strong>Time:</strong> {{ event_start_time }} - {{ event_end_time }}</li></ul>' . "\n",
      'after' => '{% if pre_survey_url %}<p><a href="{{ pre_survey_url }}">{{ pre_survey_url }}</a></p>{% endif %}' . "\n"
        . '<p>We are glad you are going to attend!</p>' . "\n"
        . '<p>____<br>This message is sent through the ACCESS-CI event registration system.</p>',
    ],
    'field_post_survey_email_text' => [
      'before' => '<p>Dear {{ name }},</p>' . "\n"
        . '<p>Thank you for participating in <strong>{{ title }}</strong>. We\'d appreciate it if you participated in our survey.</p>' . "\n",
      'after' => '{% if post_survey_url %}<p><a href="{{ post_survey_url }}">{{ post_survey_url }}</a></p>{% endif %}' . "\n"
        . '<p>____<br>This message is sent through the ACCESS-CI event registration system.</p>',
    ],
  ];

  $entity_query = \Drupal::entityTypeManager()->getStorage('eventseries')->getQuery();
  $entity_query->accessCheck(FALSE);
  $series_ids = $entity_query->execute();

  $migrated = 0;
  $populated = 0;

  foreach ($series_ids as $series_id) {
    $series = \Drupal::entityTypeManager()->getStorage('eventseries')->load($series_id);
    $changed = FALSE;

    foreach ($field_map as $field_name => $template_key) {
      $value = $series->get($field_name)->value;

      if (!empty($value)) {
        // Wrap existing fragment into full template.
        // Fragment already has block-level tags from CKEditor.
        $full = $old_templates[$field_name]['before']
          . $value . "\n"
          . $old_templates[$field_name]['after'];
        $series->set($field_name, $full);
        $changed = TRUE;
        $migrated++;
      }
      else {
        // Populate with default template.
        $series->set($field_name, $templates[$template_key]);
        $changed = TRUE;
        $populated++;
      }
    }

    if ($changed) {
      $series->save();
    }
  }

  return t('Migrated email templates for @total event series: @migrated fields wrapped with full template, @populated empty fields populated with defaults.', [
    '@total' => count($series_ids),
    '@migrated' => $migrated,
    '@populated' => $populated,
  ]);
}

/**
 * Adds the individually_cancelled base field to event instances.
 */
function access_events_update_10007() {
  $definition = \Drupal\Core\Field\BaseFieldDefinition::create('boolean')
    ->setLabel(t('Individually cancelled'))
    ->setDefaultValue(0)
    ->setRevisionable(FALSE);
  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('individually_cancelled', 'eventinstance', 'access_events', $definition);
}

/**
 * Decides whether a field_inheritance key-value row is dead weight.
 *
 * A "dead" row is one that field_inheritance_update_10300() would migrate onto
 * a base field at the cost of an entity save (and therefore a pathauto alias
 * regeneration), while carrying no inheritance state worth migrating.
 *
 * A row qualifies only when ALL of the following hold:
 *  - its entity-type prefix is not 'eventinstance' — those are the rows the
 *    site actually inherits into and 10300 must migrate them;
 *  - its entity-type prefix is not 'file' — file rows are out of scope for
 *    this pass by explicit decision and are left for 10300;
 *  - the row's 'enabled' member is falsy;
 *  - the row carries no field mappings, i.e. no array members. 10300 treats
 *    every array member as a field mapping.
 *
 * @param string $key
 *   The key-value key, in '<entity_type_id>:<uuid>' form.
 * @param mixed $value
 *   The stored row value.
 *
 * @return bool
 *   TRUE when the row can be safely deleted.
 */
function _access_events_field_inheritance_row_is_dead(string $key, $value): bool {
  if (!is_array($value)) {
    return FALSE;
  }

  $entity_type_id = explode(':', $key)[0];
  if ($entity_type_id === 'eventinstance' || $entity_type_id === 'file') {
    return FALSE;
  }

  if (!empty($value['enabled'])) {
    return FALSE;
  }

  foreach ($value as $member) {
    if (is_array($member)) {
      return FALSE;
    }
  }

  return TRUE;
}

/**
 * Trims field_inheritance config and drops dead key-value rows before 10300.
 */
function access_events_update_10008() {
  // This MUST run before field_inheritance_update_10300(); the
  // access_events_update_dependencies() entry at the bottom of this file
  // orders it. Unmodified, 10300 re-saves every entity named in the
  // field_inheritance key-value collection — on production that is 653 nodes,
  // terms and block_contents carrying no inheritance state at all — and
  // pathauto regenerates an alias on each save, moving live page URLs such as
  // /outages. 10300 also adds the field_inheritance widget to every bundle
  // listed in the old included_bundles string, and its config save makes
  // field_inheritance's ConfigSubscriber install and then uninstall base field
  // storage on four unrelated entity types.
  //
  // Step A narrows field_inheritance.config to eventinstance so 10300 has
  // nothing else to act on. Step B deletes the dead key-value rows so 10300
  // never loads or re-saves those entities.
  //
  // The key-value deletion is one-way on production: there is no restore path
  // once the rows are gone. That is why the predicate is deliberately narrow
  // and why every unexpected surviving row is logged at warning level.
  //
  // The hook is idempotent. On an environment where 10300 has already run, the
  // collection is empty and the config already lists eventinstance only, so it
  // deletes nothing and returns cleanly.
  //
  // Step A — trim field_inheritance.config.
  $config = \Drupal::configFactory()->getEditable('field_inheritance.config');
  $changed_config = FALSE;

  if ($config->get('included_entities') !== ['eventinstance']) {
    $config->set('included_entities', ['eventinstance']);
    $changed_config = TRUE;
  }

  // Only rewrite included_bundles when the key is still present. It is a
  // pre-3.x key with no schema in field_inheritance 3.x, read nowhere but
  // update_10300, and dropped entirely by that hook's setData() call — so
  // re-adding it on an already-upgraded site would leave a stray, unschema'd
  // key that the exported field_inheritance.config.yml does not carry.
  if ($config->get('included_bundles') !== NULL && $config->get('included_bundles') !== 'eventinstance:default') {
    $config->set('included_bundles', 'eventinstance:default');
    $changed_config = TRUE;
  }

  if ($changed_config) {
    $config->save();
  }

  // Step B — delete the dead key-value rows.
  $key_value = \Drupal::keyValue('field_inheritance');
  $logger = \Drupal::logger('access_events');

  $delete = [];
  $kept = 0;
  foreach ($key_value->getAll() as $key => $value) {
    if (_access_events_field_inheritance_row_is_dead($key, $value)) {
      $delete[] = $key;
      continue;
    }

    $kept++;

    // The eventinstance and file rows are kept by design and are the bulk
    // of the collection, so only warn about rows that survived unexpectedly
    // — those are worth eyeballing in dslog before 10300 re-saves them.
    $entity_type_id = explode(':', $key)[0];
    if ($entity_type_id === 'eventinstance' || $entity_type_id === 'file') {
      continue;
    }

    $reason = !is_array($value)
      ? 'value is not an array'
      : (!empty($value['enabled']) ? 'inheritance is enabled' : 'row carries field mappings');
    $logger->warning('access_events_update_10008 kept field_inheritance row @key: @reason.', [
      '@key' => $key,
      '@reason' => $reason,
    ]);
  }

  if (!empty($delete)) {
    $key_value->deleteMultiple($delete);
  }

  return t('Trimmed field_inheritance.config to eventinstance. Deleted @deleted dead field_inheritance key-value rows, kept @kept.', [
    '@deleted' => count($delete),
    '@kept' => $kept,
  ]);
}

/**
 * Backfill event timezones and repair their field inheritance.
 *
 * 10008 belongs to the field_inheritance cleanup that ships with the
 * recurring_events 3.x upgrade.
 */
function access_events_update_10009() {
  // The field arrives with config, and config import runs AFTER updb, so on a
  // normal deploy this hook runs before the field exists and the backfill has
  // nothing it can write to. Say that, rather than reporting zero as though
  // the work were done — the operator still has to run the drush command, and
  // "Wrote 0 event timezones" reads like they do not.
  $definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('eventseries');
  if (!isset($definitions['field_event_timezone'])) {
    return t('The event timezone field is not installed yet, so nothing was backfilled. Run `drush access-events:backfill-timezones` after configuration import.');
  }

  $backfill = \Drupal::service('access_events.timezone_backfill');
  $result = $backfill->backfill();
  $written = $result['author_zone'] + $result['site_default'];

  $message = t('Wrote @n event timezones.', ['@n' => $written]);
  if (!empty($result['review'])) {
    // Not a failure: these are rows where the data disagrees with the derived
    // default. Run the drush command to list them.
    $message .= ' ' . t('@c series need review — run `drush access-events:backfill-timezones` to list them.', [
      '@c' => count($result['review']),
    ]);
  }
  return $message;
}

/**
 * Implements hook_update_dependencies().
 */
function access_events_update_dependencies() {
  // field_inheritance_update_10300() re-saves every entity in the
  // field_inheritance key-value collection. access_events_update_10008()
  // removes the dead rows and narrows the config first, so 10300 only touches
  // event instances. This orders PENDING updates only — on an environment
  // where 10300 has already run, 10008 simply runs on its own and no-ops.
  $dependencies['field_inheritance'][10300]['access_events'] = 10008;
  return $dependencies;
}
