<?php

/**
 * @file
 */

use Drupal\access_events\Plugin\Util\EventDateConvert;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\Component\Utility\Xss;
use Drupal\Core\Render\Markup;
use Drupal\user\Entity\User;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\Component\Utility\Html;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\access_events\EffectiveCreationSet;
use Drupal\access_events\Plugin\EventInstanceCreator\PastPreservingEventInstanceCreator;
use Drupal\access_events\Plugin\Validation\Constraint\EventInstancePublishGuardConstraint;
use Drupal\access_events\Plugin\Validation\Constraint\EventInstancePublishGuardConstraintValidator;
use Drupal\access_events\Plugin\Validation\Constraint\EventSeriesRescheduleBlockConstraint;
use Drupal\access_events\Plugin\Validation\Constraint\EventSeriesRescheduleBlockConstraintValidator;
use Drupal\recurring_events\Entity\EventInstance;
use Drupal\recurring_events\Entity\EventSeries;
use Drupal\recurring_events\EventInstanceCreatorInterface;
use Drupal\recurring_events\EventInstanceCreatorPluginManager;

/**
 * Implements hook_form_alter().
 */
function access_events_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if ($form['#id'] == 'views-exposed-form-events-facet-recorded-webinars-block') {
    $form['search_api_fulltext']['#attributes']['placeholder'] = t('Search this collection');
  }
  if ($form_id == 'registrant_default_delete_form') {
    $form['actions']['submit']['#submit'][] = 'access_events_user_delete_submit';
  }
  if ($form_id == 'eventseries_default_delete_form' || $form_id == 'eventinstance_default_delete_form') {
    access_events_disable_delete_when_registered($form, $form_state);
  }
  if ($form_id == 'content_moderation_entity_moderation_form') {
    _access_events_standalone_moderation_form_alter($form, $form_state);
  }
  if ($form_id == 'eventseries_revision_revert_confirm'
    || $form_id == 'eventinstance_revision_revert_confirm'
    || $form_id == 'eventseries_revision_revert_translation_confirm'
    || $form_id == 'eventinstance_revision_revert_translation_confirm') {
    $form['#validate'][] = 'access_events_revision_revert_validate';
  }
  if ($form_id == 'eventseries_default_clone_form' || $form_id == 'eventinstance_default_clone_form') {
    // This form is the guaranteed born-draft surface for a hand-authored
    // clone. A duplicate cannot be forced to draft at presave instead: a
    // duplicate arrives at presave as a new eventinstance carrying an
    // eventseries_id and a source-copied moderation_state, which is the same
    // shape a machinery-created occurrence has (the birth alter stamps its
    // published/archived state into the create() data before the entity
    // exists), so presave cannot tell a duplicate from a machinery insert and
    // must not force either to draft. Pinning the widget default here is what
    // makes a UI clone born draft; a purely programmatic createDuplicate()
    // that skips this form would keep the source's state, but no such
    // clone-and-save path exists for eventinstances in this codebase.
    //
    // createDuplicate() copies the source entity's moderation_state field
    // value onto the (new, unsaved) duplicate; the ModerationStateWidget's
    // own default-value computation happens to land on the workflow's
    // initial state (draft) for a new entity given today's transition graph,
    // but that is an emergent property of the workflow config, not a
    // guarantee — a duplicate must always be born in a non-publishing state
    // regardless of the source's state, so pin the widget default explicitly
    // rather than relying on transition-graph shape. Roles without the
    // create-new-draft permission on the instance workflow do not get 'draft'
    // in the widget's option list at all (their options are
    // [published, ready_for_review]) and the widget would otherwise preselect
    // published, so only pin 'draft' when it is actually offered; when it is
    // not, fall back to the first non-publishing option the widget offers
    // (options are weight-ordered, so this is the lowest-weight non-publishing
    // target) so the clone is still never born published.
    if (isset($form['moderation_state']['widget'][0]['state']['#options'])) {
      $stateOptions = $form['moderation_state']['widget'][0]['state']['#options'];
      if (isset($stateOptions['draft'])) {
        $form['moderation_state']['widget'][0]['state']['#default_value'] = 'draft';
      }
      else {
        $nonPublishing = array_diff_key($stateOptions, ['published' => TRUE]);
        $fallback = array_key_first($nonPublishing);
        if ($fallback !== NULL) {
          $form['moderation_state']['widget'][0]['state']['#default_value'] = $fallback;
        }
      }
    }
  }
  if ($form_id == 'eventseries_default_add_form' || $form_id == 'eventseries_default_edit_form' || $form_id == 'eventseries_default_clone_form') {

    $form['field_registration']['widget'][0]['uri']['#description'] = "";

    $form['event_registration']['widget'][0]['registration']['#description'] = "";
    $form['event_registration']['widget']['#description'] = "";
    $form['event_registration']['#label_help'] =
      t('Check this box to enable event registration. You can set capacity, add surveys, and enable a waitlist if needed.') .
      "<br />" . t('The event registration configuration');


    $form['registration_reminders']['widget'][0]['data']['reminder_data']['reminder_units']['#default_value'] = 'day';

    // Remove required from fieldset 'recur_type' for a11y.
    $form['recur_type']['widget']['#required'] = FALSE;
    $form['field_event_type']['widget']['#required'] = FALSE;

    // Force h2 on titles.
    $form['field_affinity_group_node']['widget']['#title'] = Markup::create('<h2 class="label">' . $form['field_affinity_group_node']['widget']['#title'] . '</h2>');
    $form['excluded_dates']['widget']['#title'] = Markup::create('<h2 class="label mb-0">' . $form['excluded_dates']['widget']['#title'] . '</h2>');
    $form['field_other_authors']['widget']['#title'] = Markup::create('<h2 class="label mb-0">' . $form['field_other_authors']['widget']['#title'] . '</h2>');

    $form['weekly_recurring_date']['widget'][0]['#title'] = Markup::create('<h2 class="label">' . $form['weekly_recurring_date']['widget']['#title'] . '</h2>');
    $form['monthly_recurring_date']['widget'][0]['#title'] = Markup::create('<h2 class="label">' . $form['monthly_recurring_date']['widget']['#title'] . '</h2>');
    $form['custom_date']['widget'][0]['#title'] = Markup::create('<h2 class="label">' . $form['custom_date']['widget']['#title'] . '</h2>');
    $form['event_registration']['widget'][0]['#title'] = Markup::create('<h2 class="fieldset-legend mb-0">' . $form['event_registration']['widget'][0]['#title'] . '</h2>');


    // Hide options this editor's context may not set (restricted affiliations
    // for non-editors; the bi-weekly-digest share option off the ACCESS
    // domain). The SAME map drives the presave strip guard, which restores
    // stored values an editor could not see — a hidden checkbox is round-
    // tripped unchecked by the form, and without the guard the save would
    // silently strip the value (this is how series lost their NAIRR
    // affiliations and digest flags). One map, two consumers, no drift.
    foreach (_access_events_hidden_series_options() as $hiddenField => $hiddenValues) {
      foreach ($hiddenValues as $hiddenValue) {
        unset($form[$hiddenField]['widget']['#options'][$hiddenValue]);
      }
    }
    $set_tz = $form['custom_date']['widget'][0]['value']['#date_timezone'];
    $suffix = '<div class="form-text">' . t('Your time zone is set to ') . "<strong>$set_tz</strong>. " . t('If your event is in a different time zone, calculate the time difference accordingly.') . '</div>';

    foreach ($form['custom_date']['widget'] as $key => $value) {
      if (is_numeric($key)) {
        $form['custom_date']['widget'][$key]['value']['#prefix'] = '<span class="label">' . t('Start date') . '</span>';
        $form['custom_date']['widget'][$key]['value']['#attributes']['aria-label'] = t('Start date');
        $form['custom_date']['widget'][$key]['end_value']['#prefix'] = '<span class="label">' . t('End date') . '</span>';
        $form['custom_date']['widget'][$key]['end_value']['#attributes']['aria-label'] = t('End date');
        $form['custom_date']['widget'][$key]['day_occurance']['#suffix'] = $suffix;
      }
    }

    $form['monthly_recurring_date']['widget'][0]['day_occurrence']['#suffix'] = $suffix;

    $form['weekly_recurring_date']['widget'][0]['days']['#suffix'] = $suffix;
    $form['daily_recurring_date']['widget'][0]['duration']['#suffix'] = $suffix;

    $current_user = \Drupal::currentUser();
    $username = $current_user->getAccountName();
    $username = str_replace('@access-ci.org', '', $username);

    $grantlist = \Drupal::service('access_events.XsedeApi')->getGrantList($username);
    $no_grants = 0;
    if (empty($grantlist)) {
      $no_grants = 1;
    }
    $grantlist = [0 => 'No Allocation'] + $grantlist;

    $form['field_event_allocation_grant']['widget'][0]['value']['#type'] = 'select';
    $form['field_event_allocation_grant']['widget'][0]['value']['#options'] = $grantlist;
    $form['field_event_allocation_grant']['widget'][0]['value']['#size'] = 1;
    if ($no_grants) {
      $form['field_event_allocation_grant']['widget'][0]['value']['#default_value'] = 0;
      $form['field_event_allocation_grant']['widget'][0]['value']['#access'] = FALSE;
    }

    // Get current user.
    $current_user = \Drupal::currentUser();
    $roles = $current_user->getRoles();

    $form['#validate'][] = 'access_events_ag_validate';

  }

  if ($form_id == 'registrant_default_add_form' || $form_id == 'registrant_default_edit_form') {
    // Email registered user.
    $form['actions']['submit']['#submit'][] = 'access_misc_registrant_email_submit';

    // Get current user.
    $current_user = \Drupal::currentUser();
    $roles = $current_user->getRoles();
    $username = $current_user->getAccountName();

    // Get event instance id.
    $uri = \Drupal::request()->getRequestUri();
    $uri = explode('/', $uri);
    $eventinstance_id = $uri[2];

    // Only force these fields to the current user's own identity when the
    // registrant being submitted is (or will be) the current user's own
    // record. No role currently holds the cross-user 'edit registrant
    // entities' permission, so today a non-admin can only ever reach this
    // form for their own registrant — but if that permission is ever granted
    // to another role, this check keeps an editor from silently overwriting
    // someone else's name/email with their own on save.
    $registrant = $form_state->getFormObject()->getEntity();
    $editing_own_registrant = $registrant->isNew() || (int) $registrant->getOwnerId() === (int) $current_user->id();

    if (!in_array('administrator', $roles) && $editing_own_registrant) {
      // Get current user field 'field_user_first_name'.
      $user = User::load($current_user->id());
      $first_name = $user->get('field_user_first_name')->value;
      $last_name = $user->get('field_user_last_name')->value;
      $email = $user->getEmail();
      $form['field_first_name']['widget'][0]['value']['#default_value'] = $first_name;
      $form['field_first_name']['widget'][0]['value']['#access'] = FALSE;
      $form['field_last_name']['widget'][0]['value']['#default_value'] = $last_name;
      $form['field_last_name']['widget'][0]['value']['#access'] = FALSE;
      $form['email']['widget'][0]['value']['#default_value'] = $email;
      $form['email']['widget'][0]['value']['#access'] = FALSE;
      $form['user_id']['widget'][0]['#access'] = FALSE;

      $form['confirm_registeration'] = [
        '#type' => 'markup',
        '#weight' => 99,
        '#markup' => "<div class='py-4'><strong>Please confirm your registration below.</strong></div>",
      ];

      // Check if user is registered and redirect back to event if so.
      $entity_query = \Drupal::entityQuery('registrant')
        ->condition('eventinstance_id', $eventinstance_id)
        ->condition('user_id', $current_user->id())
        ->accessCheck(FALSE);
      $registrant_status = $entity_query->execute();

      if ($registrant_status) {
        $redirect = new RedirectResponse('/events/' . $eventinstance_id);
        $redirect->send();
        \Drupal::messenger()->addMessage(t('You are already registered for this event.'));
      }
    }

    $eventinstance = \Drupal::entityTypeManager()->getStorage('eventinstance')->load($eventinstance_id);
    $series = $eventinstance->getEventSeries();
    $field_event_allocation_grant = $series->get('field_event_allocation_grant')->value;
    if ($field_event_allocation_grant) {
      if (!strpos($username, '@access-ci.org')) {
        \Drupal::messenger()->addWarning(t('Registration for the event requires an <a href="https://access-ci.org">ACCESS ID</a>'));
        $form['confirm_registeration']['#access'] = FALSE;
        $form['actions']['submit']['#access'] = FALSE;
      }

      $allocation = $series->get('field_event_allocation_grant')->getValue();
      $resources = '';
      if ($allocation) {
        $allocation = $allocation[0]['value'];
        if ($allocation) {
          $grantlist = \Drupal::service('access_events.XsedeApi')->getGrantedUsers($allocation);
          $allocation_title = \Drupal::service('access_events.XsedeApi')->getTitle($allocation);
          $resourcename = [];

          if (isset($grantlist['result']) && is_array($grantlist['result'])) {
            foreach ($grantlist['result'] as $value) {
              foreach ($value as $key => $resource) {
                if ($key == 'resourceName') {
                  $resourcename[$resource] = $resource;
                }
              }
            }
          }
          $resources = "<p class='mb-0'>When your registration is approved, you will be added the the <strong><em>$allocation_title</em></strong> allocation which will provide access to the following resources for this event:</p><ul class='mt-0 mb-10'>";
          foreach ($resourcename as $resource) {
            $resources .= "<li>$resource</li>";
          }
          $resources .= "</ul>";
        }
      }

      $form['resources'] = [
        '#type' => 'markup',
        '#weight' => 99,
        '#markup' => $resources,
      ];
    }

    // Add submit handler to registrant form to invalidate cache on Events
    // Facet view.
    $form['actions']['submit']['#submit'][] = 'access_misc_registrant_submit';

    // Add validation handler for eligibility checking.
    $form['#validate'][] = 'access_events_registrant_eligibility_validate';
  }

  if ($form_id == 'registrant_default_add_form') {
    // Registration-requires-published-occurrence gate mirror: the same "is
    // the target occurrence currently published" check
    // access_events_entity_presave() enforces on a bare/programmatic save,
    // re-run here so a form submission fails with a field-level form error
    // instead of an uncaught RuntimeException. Only the ADD form needs this —
    // the gate exempts updates (e.g. the edit form's waitlist-promotion path)
    // entirely, so no equivalent is attached to registrant_default_
    // edit_form.
    $form['#validate'][] = 'access_events_registrant_publish_gate_validate';
  }

  if ( ($form_id == 'registrant_default_add_form' || $form_id == 'registrant_default_edit_form') && in_array('administrator', $roles)) {
    $form['field_first_name']['widget'][0]['value']['#access'] = TRUE;
    $form['field_last_name']['widget'][0]['value']['#access'] = TRUE;
    $form['email']['widget'][0]['value']['#access'] = TRUE;
    $form['user_id']['widget'][0]['#access'] = TRUE;

    if ($form_id == 'registrant_default_add_form') {
      // Get current user.
      $current_user = \Drupal::currentUser();
      // Get current user field 'field_user_first_name'.
      $user = User::load($current_user->id());
      $first_name = $user->get('field_user_first_name')->value;
      $last_name = $user->get('field_user_last_name')->value;
      $email = $user->getEmail();

      $form['field_first_name']['widget'][0]['value']['#default_value'] = $first_name;
      $form['field_last_name']['widget'][0]['value']['#default_value'] = $last_name;
      $form['email']['widget'][0]['value']['#default_value'] = $email;
    }

    // Add submit handler to registrant form to invalidate cache on Events
    // Facet view.
    $form['actions']['submit']['#submit'][] = 'access_misc_registrant_submit';
  }

  if ($form_id == 'eventinstance_default_form' || $form_id == 'eventinstance_default_add_form' || $form_id == 'eventinstance_default_edit_form' || $form_id == 'eventinstance_default_clone_form') {
    if ($form['notifications']) {
      $form['notifications']['edit_message']['title']['#prefix'] = '';
      $form['notifications']['edit_message']['title']['#suffix'] = '';
    }

    // If user is not administrator, hide the field 'domain_access'.
    $current_user = \Drupal::currentUser();
    $roles = $current_user->getRoles();
    if (!in_array('administrator', $roles)) {
      $form['domain_access']['#access'] = FALSE;
      // Hide internal tracking number fields from non-admins.
      foreach (['field_post_survey_sent', 'field_post_survey_reminder_sent'] as $f) {
        if (isset($form[$f])) {
          $form[$f]['#access'] = FALSE;
        }
      }
    }
    else {
      // Admins see the survey-tracking fields read-only as a true/false
      // indicator (they're set by code; editing them by hand could break
      // the survey-send tracking).
      foreach (['field_post_survey_sent', 'field_post_survey_reminder_sent'] as $f) {
        if (isset($form[$f]['widget'][0]['value'])) {
          $value = $form[$f]['widget'][0]['value']['#default_value'] ?? NULL;
          $form[$f]['widget'][0]['value']['#disabled'] = TRUE;
          $form[$f]['widget'][0]['value']['#title_display'] = 'before';
          // Render as a t/f indicator in the description rather than a number.
          $sent = !empty($value);
          $form[$f]['widget'][0]['value']['#description'] = $sent ? t('Sent') : t('Not sent yet');
        }
      }
      // Reordering of the post-survey-sent indicators happens in #after_build
      // (since later alters reset weights set here).
      // Move domain_access to the very end for admins. Use #after_build so
      // the weight wins against any later alter (domain_entity, field_group).
      $form['#after_build'][] = '_access_events_eventinstance_after_build';
    }

    // Moderation-state warnings — not on the clone form: createDuplicate()
    // pins a fresh clone to draft (see the clone-form block above), so it
    // never carries a "currently published" state to leave and, unlike a
    // series, a machinery-created instance's first publish is not something
    // an editor drives through the clone form. An occurrence currently
    // published carries the leaving-published warning (any transition away
    // from published cancels it and notifies registrants); one NOT currently
    // published carries the arriving-published warning (choosing Published
    // republishes it and notifies registrants). Static text keyed off the
    // CURRENT state, not the submitted target — the widget's selected value
    // isn't known until submission, so this informs the editor of what each
    // direction would do rather than reacting to a live selection.
    if ($form_id !== 'eventinstance_default_clone_form') {
      // Cast: FormState::$process_input is unset (NULL, not FALSE) at
      // form_alter time — FormBuilder::doBuildForm() is the only place that
      // calls setProcessInput(), and it runs after prepareForm()/the alter
      // hooks. NULL correctly reads as "not processing input" (GET) here.
      _access_events_attach_moderation_warnings($form, $form_state->getFormObject()->getEntity(), (bool) $form_state->isProcessingInput());
    }

    // The screen/pre/post-survey email accordions only matter when internal
    // event registration is enabled on the parent series (the survey emails
    // are sent through the registration flow). Hide the accordions and their
    // contained fields when registration is off — they're noise otherwise.
    $eventinstance = $form_state->getFormObject()->getEntity();
    $series = method_exists($eventinstance, 'getEventSeries') ? $eventinstance->getEventSeries() : NULL;
    $registration_on = FALSE;
    if ($series && !$series->get('event_registration')->isEmpty()) {
      $registration_on = !empty($series->get('event_registration')->getValue()[0]['registration']);
    }
    if (!$registration_on) {
      $survey_fields = [
        'field_screen_survey_email_text',
        'field_screen_survey_url',
        'field_pre_survey_email_text',
        'field_pre_survey_url',
        'field_post_survey_email_text',
        'field_post_survey_url',
        'field_post_survey_sent',
        'field_post_survey_reminder_sent',
      ];
      foreach ($survey_fields as $f) {
        if (isset($form[$f])) {
          $form[$f]['#access'] = FALSE;
        }
      }
      foreach (['group_screening_survey', 'group_surveys', 'group_post_survey'] as $g) {
        if (isset($form['#fieldgroups'][$g])) {
          unset($form['#fieldgroups'][$g]);
        }
      }
    }

    // The field_inheritance module renders a "Field Inheritance" admin
    // widget (visible only to users with the `administer field inheritance`
    // permission) at the top of the form. Collapse it (and its many nested
    // per-field detail panels) by default — the state is wired automatically
    // by access_events_entity_presave(), so admins rarely need to interact
    // with this section.
    if (isset($form['field_inheritance'])) {
      $form['field_inheritance']['#open'] = FALSE;
      if (isset($form['field_inheritance']['fields'])) {
        foreach ($form['field_inheritance']['fields'] as $key => &$child) {
          if (is_array($child) && ($child['#type'] ?? '') === 'details') {
            $child['#open'] = FALSE;
          }
        }
      }
    }

    // Suppress text-format help/guidelines on instance override fields. The
    // series form hides these via theme CSS scoped to the recur-type widget
    // (which only the series form has) — that selector can't match on
    // instance forms. Attach a small CSS library here to mirror the rule.
    $form['#attached']['library'][] = 'access_events/eventinstance-form';

    // Shared event-form CSS (multi-value field table alignment, etc.) —
    // applies to any theme on any portal.
    $form['#attached']['library'][] = 'access_events/event-form';

    // Email body field token-documentation prefixes — same on series and
    // instance forms since the override semantics share the same tokens.
    _access_events_attach_email_token_prefixes($form);
  }

  // Email body fields on event series forms.
  if ($form_id == 'eventseries_default_add_form' || $form_id == 'eventseries_default_edit_form' || $form_id == 'eventseries_default_clone_form') {
    $templates = _access_events_email_templates();

    _access_events_attach_email_token_prefixes($form);

    // Shared event-form CSS — applies to any theme on any portal.
    $form['#attached']['library'][] = 'access_events/event-form';

    // Pre-populate with default templates on add form only.
    if ($form_id == 'eventseries_default_add_form') {
      $form['field_screen_survey_email_text']['widget'][0]['#default_value'] = $templates['registration'];
      $form['field_pre_survey_email_text']['widget'][0]['#default_value'] = $templates['approval'];
      $form['field_post_survey_email_text']['widget'][0]['#default_value'] = $templates['post_survey'];
    }

    // If user is not administrator, hide the field 'domain_access'.
    $current_user = \Drupal::currentUser();
    $roles = $current_user->getRoles();
    if (!in_array('administrator', $roles)) {
      $form['domain_access']['#access'] = FALSE;
    }

    // Moderation-state warnings — not on the clone form: createDuplicate()
    // pins a fresh clone to draft (see the clone-form block above), so a
    // clone never carries a "currently published" state to leave. The add
    // form is likewise a no-op here: _access_events_attach_moderation_
    // warnings() itself skips any $entity->isNew() case — a brand-new series
    // has neither a saved state to leave nor a recurrence configuration to
    // compute an effective creation set from.
    if ($form_id !== 'eventseries_default_clone_form') {
      // Cast: see the eventinstance call site above — $process_input is NULL
      // (not FALSE) at form_alter time, and NULL correctly reads as "GET".
      _access_events_attach_moderation_warnings($form, $form_state->getFormObject()->getEntity(), (bool) $form_state->isProcessingInput());
    }

    // Schedule-change disclosure — edit form only: the add form has no
    // existing occurrences yet to diverge from (whatever recur config is
    // submitted IS the schedule, nothing to regenerate away from), and the
    // clone form's duplicate is a brand-new, unsaved entity for the same
    // reason.
    if ($form_id === 'eventseries_default_edit_form') {
      _access_events_attach_schedule_change_warning($form, $form_state->getFormObject()->getEntity());
    }

    $form['body']['widget'][0]['#required'] = TRUE;

    $form['consecutive_recurring_date'] = [];

    // Summary ai suggestion.
    $form['field_summary_replace'] = [
      '#type' => 'container',
      '#attributes' => [
        'id' => 'field-summary-replace',
        'data-suggest' => '0',
      ],
      '#weight' => 2,
    ];


    $form['field_summary_replace']['field_suggest'] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => [
          'bg-light-teal',
          'my-5',
          'p-5'
        ]
      ],
    ];

    $form['field_summary_replace']['field_suggest']['summary_list'] = [
      '#markup' => "<div id='match-summary-list' class='mb-3'>Get summary suggestions based on your description and then curate as necessary.</div>",
    ];

    $form['field_summary_replace']['field_suggest']['summary_text'] = [
      '#type' => 'textarea',
      '#title' => t('Summary'),
      '#description' => $form['field_summary']['widget'][0]['#description'],
      '#default_value' => $form['field_summary']['widget'][0]['value']['#default_value'],
      '#required' => TRUE,
      '#rows' => 5,
      '#weight' => 10,
      '#maxlength' => 150,
    ];

    $form['field_summary_replace']['field_suggest']['replace_button'] = [
      '#type' => 'button',
      '#value' => t('Suggest Summary'),
      '#limit_validation_errors' => array(),
      '#attributes' => [
        'class' => [
          'ml-0'
        ],
      ],
      '#ajax' => [
        'callback' => 'access_events_replace_summary_section_callback',
        'wrapper' => 'field-summary-replace',
      ],
    ];

    $form['field_summary_replace']['user_message'] = [
      '#markup' => "",
    ];

    // Hide the field 'field_summary' and replace it with a textarea.
    $form['field_summary']['widget'][0]['value']['#access'] = FALSE;

    array_unshift($form['actions']['submit']['#submit'], 'access_events_save_summary');

    // Tags ai suggestion.
    $form['field_tags_replace'] = [
      '#type' => 'container',
      '#attributes' => [
        'id' => 'field-tags-replace',
        'data-suggest' => '0',
      ],
      '#weight' => 20,
    ];

    $form['field_tags_replace']['field_suggest_title'] = [
      '#markup' => "<h2 class='label form-required mt-4 mb-0'>Tags</h2>",
    ];

    $form['field_tags_replace']['field_suggest'] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => [
          'bg-light-teal',
          'my-5',
          'p-5'
        ]
      ],
    ];

    $form['field_tags_replace']['field_suggest']['tag_list'] = [
      '#markup' => "<div id='match-tag-list' class='mb-3'>Get tag suggestions based on your description and then curate as necessary. Limited to 6 tags.</div>",
    ];
    $form['field_tags_replace']['field_suggest']['replace_button'] = [
      '#type' => 'button',
      '#value' => t('Suggest Tags'),
      '#limit_validation_errors' => array(),
      '#attributes' => [
        'class' => [
          'ml-0'
        ],
      ],
      '#ajax' => [
        'callback' => 'access_events_replace_event_section_callback',
        'wrapper' => 'field-tags-replace',
      ],
    ];
    $form['field_tags_replace']['user_message'] = [
      '#markup' => "",
    ];


    $add_tags = \Drupal::service('access_misc.addtags');
    $output = $add_tags->getView();
    $tag_label = t('Tags');
    $tag_description = t('Add tags that will help people find your event.');
    $tag_summary = t('Select Tags');

    $form['node_add_tags'] = [
      '#markup' => "<div class='mt-4'>
          <h4 class='label form-required'>$tag_label</h4>
          <div class='tag-description'>$tag_description</div>
        </div>
        <div id='tag-suggestions'></div>
        <details class='tags m-0 mb-8'><summary class='font-bold'>$tag_summary</summary>$output</details>",
      '#weight' => 20,
      '#allowed_tags' => [
        'ul',
        'li',
        'button',
        'details',
        'summary',
        'div',
        'span',
        'h2',
        'h4',
      ],
    ];

    // Attach javascript.
    $form['#attached']['library'][] = 'access_misc/node_add_tags';
    $form['#attached']['library'][] = 'access_events/events';

    // Registration form.
    $form['event_registration']['widget'][0]['unique_email_address']['#default_value'] = 1;
    $form['event_registration']['widget'][0]['unique_email_address']['#access'] = FALSE;
    $form['event_registration']['widget'][0]['permitted_roles']['#default_value'] = ['authenticated'];
    $form['event_registration']['widget'][0]['permitted_roles']['#access'] = FALSE;
    $form['#validate'][] = 'access_events_eventseries_validate';
  }
}

/**
 * Implements hook_preprocess_field_multiple_value_form().
 *
 * Removes the drag handle and Order column from specific multi-value fields.
 */
function access_events_preprocess_field_multiple_value_form(&$variables) {
  if (!$variables['multiple']) {
    return;
  }
  $fields = ['field_other_authors', 'field_affinity_group_node'];
  if (!in_array($variables['element']['#field_name'] ?? '', $fields)) {
    return;
  }

  // Fix label header colspan: 2 covers drag handle + field, reduce to 1.
  $variables['table']['#header'][0]['colspan'] = 1;
  // Remove the Order column header (always last).
  array_pop($variables['table']['#header']);

  foreach ($variables['table']['#rows'] as &$row) {
    unset($row['data'][0]); // field-multiple-drag (drag handle)
    unset($row['data'][3]); // delta-order (weight select)
    $row['data'] = array_values($row['data']);
    $row['class'] = array_diff($row['class'] ?? [], ['draggable']);
  }

  // Remove tabledrag JS attachment.
  unset($variables['table']['#tabledrag']);
}

/**
 * Custom validation handler for webform_submission_resource_add_form.
 */
function access_events_eventseries_validate($form, FormStateInterface $form_state) {
  $values = $form_state->getValues();

  foreach ($values['custom_date'] as $key => $value) {
    if (is_numeric($key)) {
      if ($value['value'] != null) {
        $start_date = (string) $values['custom_date'][$key]['value'];
        $end_date = (string) $values['custom_date'][$key]['end_value'];
        if ($start_date == $end_date) {
          $form_state->setErrorByName('custom_date', t('Start date and end date must not be the same.'));
        }
      }
    }
  }

  $recur_types = [
    'custom' => 'custom_date',
    'monthly_recurring_date' => 'monthly_recurring_date',
    'weekly_recurring_date' => 'weekly_recurring_date',
    'daily_recurring_date' => 'daily_recurring_date',
    'consecutive_recurring_date' => 'included_dates',
  ];

  foreach ($recur_types as $recur_type => $date_field) {
    if ($form_state->getValue('recur_type')[0]['value'] == $recur_type) {
      $date = $form_state->getValue($date_field)[0]['value'];
      if ($date == null) {
        $form_state->setErrorByName($date_field, t('Please select a date.'));
      }
    }
  }

  // Enforce the 150-character summary limit server-side. The custom textarea
  // carries an HTML #maxlength, but that is only a client-side hint and is
  // bypassed by paste and the AI-suggestion path, so a hand-entered or
  // suggested summary can still exceed the documented limit. Read it from the
  // raw input the same way access_events_save_summary() does, since this
  // replacement element is not a real entity field value. Measure as plain
  // text with mb_strlen so multibyte characters are counted correctly.
  $raw_input = $form_state->getUserInput();
  $summary_text = $raw_input['summary_text'] ?? '';
  if (is_string($summary_text) && mb_strlen(trim($summary_text)) > 150) {
    $form_state->setErrorByName('summary_text', t('The summary must be 150 characters or fewer (currently @count).', [
      '@count' => mb_strlen(trim($summary_text)),
    ]));
  }

}

/**
 * Custom validation callback.
 *
 * Make sure AG is selected with proper checkboxes.
 */
function access_events_ag_validate(&$form, FormStateInterface $form_state) {
  // Get the value of the field_choose_where_to_share_this field.
  $values = $form_state->getValues();
  $share_options = $values['field_choose_where_to_share_this'] ?? [];
  $ag = $values['field_affinity_group_node'] ?? [];

  $no_ag = TRUE;
  foreach ($ag as $key => $value) {
    if (is_array($value) && !empty($value['target_id'])) {
      $no_ag = FALSE;
    }
  }

  if ($no_ag) {
    foreach ($share_options as $key => $value) {
      if ($value['value'] == 'email_to_your_affinity_group' || $value['value'] == 'on_your_affinity_group_page') {
        $form_state->setErrorByName('field_affinity_group_node', t('You must select at least one Affinity Group when choosing to email your Affinity Groups or place the event on your Affinity Group Page.'));
      }
    }
  }

}

/**
 * Ajax callback function to replace the section with '#markup'.
 */
function access_events_replace_event_section_callback(array &$form, FormStateInterface $form_state) {
  $raw_data = $form_state->getUserInput();
  $body = $raw_data['body'][0]['value'];
  $body_filter = $body ? Xss::filter($body) : '';
  $suggested_tag_ids = '0';
  $tag_count = count($raw_data['field_tags'] ?? []);
  $tag_limit = 6;
  $tag_amount = $tag_limit - $tag_count;

  $form['field_tags_replace']['user_message'] = [
    '#markup' => "",
  ];

  if ($tag_amount <= 0) {
    $form['field_tags_replace']['user_message'] = [
      '#markup' => "<div class='match-tag-list bg-blue-200 text-sky-900 my-5 p-5'>
      <strong class='text-sky-900'>You already have 6 tags</strong><br />
      You can remove some tags to get more suggestions.</div>",
    ];
  }
  elseif (strlen($body_filter) >= 100) {
    try {
      $llm = \Drupal::service('access_llm.ai_references_generator');
      $llm->generateTaxonomyPrompt('tags', 1, $body_filter);
      $suggestions = array_slice($llm->taxonomyIdSuggested(), 0, $tag_amount);
      $suggested_tag_ids = implode(', ', $suggestions);
      $form['field_tags_replace']['user_message'] = [
        '#markup' => "",
      ];
    }
    catch (\Throwable $e) {
      $form['field_tags_replace']['user_message'] = [
        '#markup' => "<div class='match-tag-list bg-yellow-200 text-yellow-900 my-5 p-5'>
        <strong class='text-yellow-900'>AI tag suggestions are not available</strong><br />
        Please select tags manually from the list below.</div>",
      ];
    }
  }
  else {
    $form['field_tags_replace']['user_message'] = [
      '#markup' => "<div class='match-tag-list bg-blue-200 text-sky-900 my-5 p-5'>
      <strong class='text-sky-900'>Fill in the description above to get suggested tags.</strong><br />
                    Your description must be over 100 characters to get a suggestion.</div>",
    ];
  }

  $form['field_tags_replace']['#attributes']['data-suggest'] = $suggested_tag_ids ;

  // Return the updated section.
  return $form['field_tags_replace'];
}

/**
 * Ajax callback function to replace the section with '#markup'.
 */
function access_events_replace_summary_section_callback(array &$form, FormStateInterface $form_state) {
  $raw_data = $form_state->getUserInput();
  $body_filter = $raw_data['body'][0]['value'] ? Xss::filter($raw_data['body'][0]['value']) : '';
  $suggested_tag_ids = '0';
  if (strlen($body_filter) >= 100) {
    try {
      $llm = \Drupal::service('access_llm.ai_references_generator');
      $llm->generateSummaryPrompt($body_filter);
      $result = $llm->summarySuggested();
      // Truncate to 150 characters. If truncated add ellipsis.
      if (strlen($result) > 150) {
        $result = substr($result, 0, 147) . '...';
      }
      $form['field_summary_replace']['field_suggest']['summary_text']['#value'] = $result;
      $form['field_summary_replace']['user_message'] = [
        '#markup' => '',
      ];
    }
    catch (\Throwable $e) {
      $form['field_summary_replace']['user_message'] = [
        '#markup' => "<div class='match-tag-list bg-yellow-200 text-yellow-900 my-5 p-5'>
        <strong class='text-yellow-900'>AI summary generation is currently unavailable</strong><br />
        Please write your summary in the text field above.</div>",
      ];
    }
  }
  else {
    $form['field_summary_replace']['user_message'] = [
      '#markup' => "<div class='match-tag-list bg-blue-200 text-sky-900 my-5 p-5'>
                    <strong class='text-sky-900'>Fill in the description below to get suggested tags.</strong><br />
                    Your description must be over 100 characters to get a suggestion.</div>",
    ];
  }
  $form['field_tags_replace']['#attributes']['data-suggest'] = $suggested_tag_ids ;

  // Return the updated section.
  return $form['field_summary_replace'];
}

/**
 * Custom submit handler for registrant form.
 */
function access_events_save_summary($form, FormStateInterface $form_state) {
  $entity = $form_state->getFormObject()->getEntity();
  $raw_data = $form_state->getUserInput();
  $suggested_summary = $raw_data['summary_text'] ? Xss::filter($raw_data['summary_text']) : '';
  $summary = $form_state->getValue('field_summary')[0]['value'] ? Xss::filter($form_state->getValue('field_summary')[0]['value']) : '';
  if ($suggested_summary != $summary) {
    $form_state->setValue('field_summary', [['value' => $suggested_summary]]);
  }
}

/**
 * Custom submit handler for registrant form.
 */
function access_misc_registrant_submit($form, FormStateInterface $form_state) {
  // Invalidate cache on Events Facet view.
  $cache_tags = ['config:views.view.events_facet'];
  \Drupal\Core\Cache\Cache::invalidateTags($cache_tags);

  // Load eventseries entity to get event pre-survey.
  $entity = $form_state->getFormObject()->getEntity();
  $eventseries_id = $entity->eventseries_id->target_id;
  $eventseries = \Drupal::entityTypeManager()->getStorage('eventseries')->load($eventseries_id);
  // Get 'field_screen_survey_url' value.
  $screen_survey = $eventseries->get('field_screen_survey_url')->getValue();

  if ($screen_survey) {
    // This email is sent immediately after registration.
    // Code in access_misc.module - 575.
    $registrant_id = $entity->id();
    $registrant = \Drupal::entityTypeManager()->getStorage('registrant')->load($registrant_id);
    $registrant->set('field_screen_survey_sent', \Drupal::time()->getRequestTime());
    \Drupal::messenger()->addMessage(t('You will receive a screening survey email shortly after registering. If you do not see it, please check your spam folder.'));
  }
  else {
    \Drupal::messenger()->addMessage(t('Your registration was received. You will receive an email after your registration is approved.'));
  }
}

/**
 * Submit handler for registrant user delete form.
 */
function access_events_user_delete_submit($form, FormStateInterface $form_state) {
  $current_user = \Drupal::currentUser();
  $username = $current_user->getAccountName();
  $username = [str_replace('@access-ci.org', '', $username)];

  // Get uri.
  $uri = \Drupal::request()->getRequestUri();
  $uri = explode('/', $uri);
  $eventinstance_id = $uri[2];
  $eventinstance = \Drupal::entityTypeManager()->getStorage('eventinstance')->load($eventinstance_id);
  $eventseries = $eventinstance->getEventSeries();
  $grant = $eventseries->get('field_event_allocation_grant')->value;

  if ($grant == 0) {
    return;
  }

  \Drupal::service('access_events.XsedeApi')->removeGrantedUsers($grant, $username);
}

/**
 * Implements hook_views_pre_build().
 * Handle timezone parameter for API endpoints.
 */
function access_events_views_pre_build(ViewExecutable $view) {
  // Handle timezone parameter for Events API v2.1 and v2.2
  if ($view->id() == 'events_facet' && in_array($view->current_display, ['data_export_1', 'data_export_2', 'data_export_3', 'data_export_4'])) {
    $request = \Drupal::request();
    $timezone = $request->query->get('timezone', 'UTC');

    // Validate timezone
    $valid_timezones = timezone_identifiers_list();
    if (!in_array($timezone, $valid_timezones)) {
      $timezone = 'UTC';
    }

    // Store timezone in view for use in date calculations
    $view->timezone = $timezone;

    // Process exposed filters from URL parameters with timezone
    $exposed_input = $view->getExposedInput();
    $updated_input = [];

    foreach ($exposed_input as $key => $value) {
      if (in_array($key, ['beginning_date_relative', 'end_date_relative']) && !empty($value)) {
        // Calculate the actual date based on timezone
        $date = new \DateTime('now', new \DateTimeZone($timezone));

        // Apply relative offset
        if ($value == 'today') {
          $date->setTime(0, 0, 0);
        } elseif (strpos($value, '+') === 0 || strpos($value, '-') === 0) {
          $date->modify($value);
        }

        // Convert to UTC for database query
        $date->setTimezone(new \DateTimeZone('UTC'));

        // Convert to absolute date
        $absolute_key = str_replace('_relative', '', $key);
        $updated_input[$absolute_key] = $date->format('Y-m-d H:i:s');

        // Remove the relative parameter
        unset($updated_input[$key]);
      } else {
        $updated_input[$key] = $value;
      }
    }

    if (!empty($updated_input)) {
      $view->setExposedInput($updated_input);
    }
  }
}

/**
 * Implements hook_pre_render().
 */
function access_events_views_pre_render(ViewExecutable $view) {
  // admin/structure/views/view/recurring_events_registrations/edit/event_registrant_list
  if ($view->id() == 'recurring_events_registrations' && $view->current_display == 'event_registrant_list') {
    // Grab url argument for event instance id.
    $path = \Drupal::service('path.current')->getPath();
    $path_args = explode('/', $path);
    $instance_id = is_numeric($path_args[2]) ? $path_args[2] : '';

    // Entity load 'eventinstance' to get event title.
    $eventinstance = \Drupal::entityTypeManager()->getStorage('eventinstance')->load($instance_id);
    // Load event series to get event title.
    $event_title = $eventinstance->getEventSeries()->get('title')->value;

    $view->setTitle(t('Registrations - @title', ['@title' => $event_title]));
  }
}

/**
 * Implements hook_pre_view().
 */
function access_events_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  if ($view->id() == 'recurring_events_event_instances' && $display_id === 'block_3') {
    // Set block to show only events for the current domain.
    $view_filters = $view->display_handler->getOption('filters');
    $domain = \Drupal::service('access_misc.sitetools')->getDomainId();
    $view_filters['domain_access_target_id']['value'] = $domain;
    $view->display_handler->setOption('filters', $view_filters);

    // Set the footer for the view.
    $term = term_lookup_from_path();

    $footer = \Drupal::service('access_misc.viewstools');
    $footer->setFooter($view, 'All Events with this tag', '/events?f%5B0%5D=custom_event_tags%3A' . $term['title'], 'block_3');
  }

  // admin/structure/views/view/recurring_events_registrations/edit/event_registrant_list
  if ($view->id() == 'recurring_events_registrations' && $display_id == 'event_registrant_list') {
    // Grab url argument for event instance id.
    $path = \Drupal::service('path.current')->getPath();
    $path_args = explode('/', $path);
    $instance_id = is_numeric($path_args[2]) ? $path_args[2] : '';

    // Entity load 'eventinstance' to get event title.
    $eventinstance = \Drupal::entityTypeManager()->getStorage('eventinstance')->load($instance_id);

    $eventseries = $eventinstance->getEventSeries();

    // Load event series to get event title.
    $event_title = $eventseries->get('title')->value;

    $registrants = \Drupal::entityTypeManager()->getStorage('registrant')->loadByProperties(['eventinstance_id' => $instance_id]);

    $approved_count = 0;
    $unapproved_count = 0;
    $waitlist_count = 0;

    $waitlist_enabled = $eventseries->get('event_registration')->waitlist;

    foreach ($registrants as $key => $registrant) {
      $is_approved = $registrant->status->value;
      $is_waitlisted = $registrant->waitlist->value;

      if ($is_approved) {
        $approved_count++;
      }
      elseif ($is_waitlisted) {
        $waitlist_count++;
      }
      else {
        // Unapproved and not on waitlist (pending)
        $unapproved_count++;
      }
    }

    // Get capacity for display
    $capacity = $eventseries->get('event_registration')->capacity;

    $header['string'] = [
      '#type' => 'inline_template',
      '#template' => '<p>Capacity: {{ capacity }}</p>
                      <p>Approved: {{ approved }}</p>
                      <p>Unapproved: {{ unapproved }}</p>
                      {% if waitlist_enabled %}<p>Waitlist: {{ waitlist }}</p>{% endif %}
                      <div><a href="waitlist/approve" class="btn btn-primary my-2 ms-0 me-4 mr-4 ml-0">{{ approve_text }}</a></div>
      ',
      '#context' => [
        'capacity' => $capacity,
        'approved' => $approved_count,
        'unapproved' => $unapproved_count,
        'waitlist' => $waitlist_count,
        'waitlist_enabled' => $waitlist_enabled,
        'approve_text' => t('Approve All'),
      ],
    ];

    $header = Markup::create(\Drupal::service('renderer')->render($header));

    $options = array(
      'id' => 'area_text_custom',
      'table' => 'views',
      'field' => 'area_text_custom',
      'relationship' => 'none',
      'group_type' => 'none',
      'admin_label' => '',
      'empty' => TRUE,
      'tokenize' => FALSE,
      'content' => $header,
      'plugin_id' => 'text_custom',
    );
    $view->setHandler('event_registrant_list', 'header', 'area_text_custom', $options);
  }


  // Override registration csv /admin/structure/views/view/recurring_events_registrations/edit/data_export_1.
  if ($view->id() == 'recurring_events_registrations' && $view->getDisplay()->view->element['#display_id'] === 'data_export_1') {
    $view_filters = $view->display_handler->getOption('filters');

    $path = \Drupal::service('path.current')->getPath();
    $path_args = explode('/', $path);
    $instance_id = is_numeric($path_args[2]) ? $path_args[2] : '';

    $view_filters['id']['value']['value'] = $instance_id;

    $user = \Drupal::currentUser();
    $roles = $user->getRoles();

    if (in_array('administrator', $roles)) {
      unset($view_filters['id']);
    }

    $view->display_handler->setOption('filters', $view_filters);
  }

}

/**
 * Implements hook_preprocess_views_view_field for views-view-field.html.twig.
 */
function access_events_preprocess_views_view_field(&$variables) {
  $view = $variables['view'];
  $field = $variables['field'];

  // admin/structure/views/view/event_instance_mine/edit/my_events_page
  if ($view->id() == 'event_instance_mine' && $view->current_display == 'my_events_page' && $field->options['id'] == 'id_1') {
    $id = $variables['output']->__toString();

    // Load registrants for the event instance.
    $registrants = \Drupal::entityTypeManager()->getStorage('registrant')->loadByProperties(['eventinstance_id' => $id]);

    $output = '<span class="visually-hidden">no</span>';

    foreach ($registrants as $registrant) {
      $status = $registrant->get('status')->getValue()[0]['value'];
      if ($status == 0) {
        $output = "<a href='/events/$id/registrations' title='Needs Approval'><i class='bi bi-exclamation-square-fill'></i></a>";
        break;
      }
    }

    $variables['output'] = Markup::create($output);
  }

  // /admin/structure/views/view/recurring_events_registrations/edit/event_registrant_list
  if ($view->id() == 'recurring_events_registrations' && $field->options['id'] == 'nothing_1') {
    $reg_data = explode(',', $variables['output']->__toString());


    if ($reg_data[1] && $reg_data[2]) {
      $sp_state = \Drupal::service('access_events.XsedeApi')->getSpState($reg_data[1], $reg_data[0]);
      $variables['output'] = $sp_state;
    } else {
      $variables['output'] = "n/a";
    }
  }

  // /admin/structure/views/view/events_facet/edit/page_1 view.
  if ($view->id() == 'events_facet' && $field->options['id'] == 'id_1') {
    $event_instance_id = $variables['output']->__toString();
    $event_instance = \Drupal::entityTypeManager()->getStorage('eventinstance')->load($event_instance_id);
    $series = $event_instance->getEventSeries();
    // Inheritance computed field — per-instance override falls back to series.
    $link = $event_instance->get('virtual_meeting_link')->getValue();

    $variables['output'] = "";

    if ($link) {
      $registration_status = $series->get('event_registration')->getValue()[0]['registration'];

      // Get current user id.
      $current_user = \Drupal::currentUser();
      $uid = $current_user->id();

      $link_url = $link[0]['uri'];

      $meeting_link = "<a href='$link_url' class='btn-sm btn-small btn-secondary-outline py-0 px-4 btn btn-md-teal ms-auto'>Join meeting</a>";

      if ($registration_status) {
        // Entity Query 'registrant' to get all registrants for the event instance.
        $query = \Drupal::entityQuery('registrant')
          ->condition('eventinstance_id', $event_instance_id)
          ->condition('status', 1)
          ->condition('user_id', $uid)
          ->accessCheck(TRUE);
        $registrants = $query->execute();

        $registrants = empty($registrants) ? FALSE : TRUE;


        if ($registrants) {
          $variables['output'] = Markup::create($meeting_link);
        }
      } else {
        // Show link when registration is not required.
        $variables['output'] = Markup::create($meeting_link);
      }
    }
  }

  // Display event instance date in the right format for My Events view.
  // The Twig |date() filter doesn't respect user timezone, so we handle it in PHP.
  if ($view->id() == 'event_instance_mine' && $view->current_display == 'my_events_page') {
    if ($field->field == 'date__value') {
      $row = $variables['row'];
      if (isset($row->_entity) && $row->_entity->hasField('date')) {
        $entity = $row->_entity;
        $date_field = $entity->get('date');

        if (!$date_field->isEmpty()) {
          $start_date = $date_field->start_date;

          // Convert to user timezone.
          $user = \Drupal::currentUser();
          $user_timezone = $user->getTimeZone() ?: date_default_timezone_get();

          if ($start_date) {
            $start_date->setTimezone(new \DateTimeZone($user_timezone));
            $formatted_output = $start_date->format('n/j/Y g:i A T');
            $variables['output'] = Markup::create($formatted_output);
          }
        }
      }
    }
  }

  // Overwrite tags on full webinars:
  // /admin/structure/views/view/events_facet/edit/recorded_webinars
  if ($view->id() == 'events_facet' && $view->current_display == 'recorded_webinars') {
    if ($field->field == 'custom_event_tags') {
      $raw_output = strip_tags($variables['output']);
      if (!empty(trim($raw_output))) {
        $tags = explode(',', $raw_output);
        $items = [];
        $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
        $path_alias_manager = \Drupal::service('path_alias.manager');

        foreach ($tags as $tag) {
          $tag = trim($tag);
          if (empty($tag)) {
            continue;
          }

          // Look up the tag term to get its real path alias.
          $terms = $term_storage->loadByProperties([
            'vid' => 'tags',
            'name' => $tag,
          ]);

          if (!empty($terms)) {
            $term = reset($terms);
            $path = '/taxonomy/term/' . $term->id();
            $alias = $path_alias_manager->getAliasByPath($path);
            $items[] = "<li class='my-0 me-1 p-0'><a href='$alias' class='inline-block text-nowrap  text-truncate text-xs no-underline font-normal mb-1 me-1 mr-1 px-2 py-1  border-dark-teal hover--border-black border text-dark-teal hover--text-black'>$tag</a></li>";
          }
        }

        if (!empty($items)) {
          $output = '<ul class="list-none p-0 m-0 flex flex-wrap" style="max-width: clamp(150px, 50vw, 600px);">' . implode('', $items) . '</ul>';
          $variables['output'] = Markup::create($output);
        }
      }
    }
  }

  // Display event instance date in the right format.
  if ($view->id() == 'recurring_events_event_instances' && ($view->current_display == 'block_1' || $view->current_display == 'block_2')) {
    if ($field->field == 'date__value' || $field->field == 'date__end_value') {
      // Handle custom Twig rewrite by getting dates from the entity directly
      $row = $variables['row'];
      if (isset($row->_entity) && $row->_entity->hasField('date')) {
        $entity = $row->_entity;
        $date_field = $entity->get('date');

        if (!$date_field->isEmpty()) {
          $start_date = $date_field->start_date;
          $end_date = $date_field->end_date;

          // Convert to user timezone
          $user = \Drupal::currentUser();
          $user_timezone = $user->getTimeZone() ?: date_default_timezone_get();

          if ($start_date) {
            $start_date->setTimezone(new \DateTimeZone($user_timezone));
          }
          if ($end_date) {
            $end_date->setTimezone(new \DateTimeZone($user_timezone));
          }

          // Create formatted output
          if ($start_date && $end_date) {
            $formatted_date = $start_date->format('l, n/j/Y');
            $start_time = $start_date->format('g:i A');
            $end_time = $end_date->format('g:i A T');
            $formatted_output = $formatted_date . '<br>' . $start_time . ' - ' . $end_time;

            $variables['output'] = Markup::create($formatted_output);
          }
        }
      }
      else {
        // Fallback to original logic for non-custom rewrite cases
        $output = explode(' - ', $variables['output']);
        if (count($output) == 2) {
          $start_date = $output[0];
          $end_date = $output[1];
          $date = new EventDateConvert($start_date, $end_date);
          if ($date->sameDay ) {
            $variables['output'] = Markup::create($date->getStart() . " - " . $date->getEnd());
          } else {
            $variables['output'] = Markup::create($date->getStart() . " to " . $date->getEnd());
          }
        }
      }
    }
  }

  // Display event instance date in the right format.
  if ($view->id() == 'events_facet' && $view->current_display != 'upcoming_webinars') {
    if ($field->field == 'date') {
      // Default separator between start and end dates is ' - '.
      $output = strip_tags($variables['output']);
      $output = explode('::', $output);
      if (count($output) == 2) {
        $start_date = $output[0];
        $end_date = $output[1];
        $date = new EventDateConvert($start_date, $end_date);
        if ($date->sameDay ) {
          $variables['output'] = Markup::create($date->getStartTime() . " - " . $date->getEndTime());
        } else {
          $variables['output'] = Markup::create($date->getStart() . " to " . $date->getEnd());
        }
      }
    }
  }

  if ($view->id() == 'events_facet' && $view->current_display == 'upcoming_webinars') {
    if ($field->field == 'date') {
      // Default separator between start and end dates is ' - '.
      $output = strip_tags($variables['output']);
      $output = explode('::', $output);
      if (count($output) == 2) {
        $start_date = $output[0];
        $end_date = $output[1];
        $date = new EventDateConvert($start_date, $end_date);
        $start_date = date('l n/j/Y', strtotime($start_date));

        if ($date->sameDay ) {
          $variables['output'] = Markup::create($start_date . " | " . $date->getStartTime() . " - " . $date->getEndTime());
        } else {
          $variables['output'] = Markup::create($start_date . " | " . $date->getStart() . " to " . $date->getEnd());
        }
      }
    }
  }


  // Overwrite location field into /events page on
  // /admin/structure/views/view/events_facet/edit/page_1
  if ($view->id() == 'events_facet' && $view->current_display == 'page_1' && $field->options['id'] == 'location') {
    $location = html_entity_decode($variables['output']);
    $location = strip_tags($location);
    if (strlen($location) > 80) {
      $location = substr($location, 0, 80) . '...';
    }
    $location = "<i class='bi bi-geo text-dark-teal'></i> <span class='text-dark-teal'>$location</span>";
    $variables['output'] = Markup::create($location);
  }

  // Convert event_type value to label for inherited fields.
  if ($field->options['id'] == 'event_type' && $field->options['entity_type'] == 'eventinstance') {
    $value = strip_tags($variables['output']->__toString());
    $field_storage = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('eventseries')['field_event_type'];
    $allowed_values = options_allowed_values($field_storage);

    if (isset($allowed_values[$value])) {
      $variables['output'] = $allowed_values[$value];
    }
  }

}

/**
 * Implements hook_entity_presave().
 */
function access_events_entity_presave(EntityInterface $entity) {
  $type = $entity->getEntityTypeId();
  if ($type == 'eventinstance') {
    $eventinstance = $entity;
    $eventseries = $eventinstance->getEventSeries();

    // Wire field_inheritance state for instances created outside the
    // EventCreationService (e.g. the "Add Instance" route on a series). Without
    // this, inherited fields like title and body return empty.
    // See: https://www.drupal.org/project/recurring_events/issues/3357979
    if ($eventinstance->isNew() && $eventseries) {
      \Drupal::service('recurring_events.event_creation_service')
        ->configureDefaultInheritances($eventinstance, $eventseries->id());
    }

    if ($eventseries) {
      $series_domain = $eventseries->get('domain_access')->getValue();
      // Use the inheritance computed field so an instance override flips on
      // the survey-tracking flags here too.
      $survey_url = $eventinstance->get('post_survey_url')->uri;
      $survey_sent_reminder = $eventinstance->get('field_post_survey_reminder_sent')->value;
      $survey_sent = $eventinstance->get('field_post_survey_sent')->value;
      if ($survey_url && $survey_sent == NULL && $survey_sent_reminder == NULL) {
        $eventinstance->set('field_post_survey_reminder_sent', 0);
        $eventinstance->set('field_post_survey_sent', 0);
      }

      // If series domain(s) is set, set the same domain(s) on the event instance.
      if ($series_domain) {
        $instance_domain = $eventinstance->get('domain_access')->getValue();

        // Compare domains properly - extract target_ids and compare as sets
        $series_ids = array_column($series_domain, 'target_id');
        $instance_ids = array_column($instance_domain, 'target_id');
        sort($series_ids);
        sort($instance_ids);

        // Update if instance has no domains or if the domain sets don't match
        if (empty($instance_domain) || $series_ids !== $instance_ids) {
          $eventinstance->set('domain_access', $series_domain);
        }
      }
    }

    if ($entity->getEntityTypeId() === 'eventinstance'
      && $entity->hasField('individually_cancelled')
      && $entity->hasField('moderation_state')
      && $entity->get('moderation_state')->value === 'published'
      && (bool) $entity->get('individually_cancelled')->value) {
      // A live occurrence is by definition not cancelled.
      $entity->set('individually_cancelled', FALSE);
    }

    if ($eventinstance instanceof EventInstance) {
      // The cancellation-email reaction's flag write + the occurrence-
      // publish-under-unpublished-event refusal — see
      // EventStateReactions::instancePresave().
      \Drupal::service('access_events.state_reactions')->instancePresave($eventinstance);
    }
  }
  elseif ($type === 'registrant') {
    // The registration-requires-published-occurrence gate: registration is
    // only open against a LIVE occurrence. This only gates NEW registrants —
    // an update save on an existing registrant row
    // (e.g. a waitlist promotion flipping the `waitlist` field) is a status
    // change on someone already registered, not a new signup, and is exempt
    // regardless of the instance's current state.
    if ($entity->isNew() && $entity->hasField('eventinstance_id')) {
      $instanceId = (int) $entity->get('eventinstance_id')->target_id;
      $registrable = $instanceId > 0
        && \Drupal::service('access_events.state_reactions')->instanceIsRegistrable($instanceId);
      if (!$registrable) {
        throw new \RuntimeException('Registration is closed — this occurrence is not currently published.');
      }
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_update() for eventinstance.
 *
 * The cancellation-email and reinstatement notifications + the
 * reschedule-notice reaction (a live occurrence's date moving) + outcome
 * recording, run after the row is saved — see
 * EventStateReactions::instanceUpdate(). This ENTITY_TYPE-specific hook is
 * also where the reschedule notice now lives instead of a separate generic
 * hook_entity_update() implementation — recurring_events_registration's own
 * hook_entity_update() (which fired this notice with no state gates at all)
 * is unimplemented for eventinstance saves in
 * access_events_module_implements_alter(), so this is the ONLY place that
 * notice fires from.
 */
function access_events_eventinstance_update(EntityInterface $entity) {
  if ($entity instanceof EventInstance) {
    \Drupal::service('access_events.state_reactions')->instanceUpdate($entity);
  }
}

/**
 * Implements hook_ENTITY_TYPE_update() for eventseries.
 *
 * The non-published rebuild trigger + the cancel sweep / restore sweep — see
 * EventStateReactions::seriesUpdate(). Must run AFTER recurring_events'
 * own eventseries_update() (which rebuilds instances for a published/
 * unmoderated series and syncs each instance's status to the series') — see
 * access_events_module_implements_alter(). Our rebuild trigger only fires for
 * a NOT-published series, so the two never both fire for the same save; our
 * sweeps read the instance set fresh from storage, so running after contrib's
 * own status-sync loop is safe either way.
 */
function access_events_eventseries_update(EntityInterface $entity) {
  if ($entity instanceof EventSeries) {
    \Drupal::service('access_events.state_reactions')->seriesUpdate($entity);
  }
}

/**
 * Option values hidden from the current editor's eventseries form context.
 *
 * Keyed by field name; each entry lists option keys the series form REMOVES
 * for this user/domain context. Shared by the form alter (which unsets the
 * options) and the presave strip guard (which restores stored values in
 * these sets that vanish from an editor's save — an invisible checkbox
 * cannot have been deliberately unchecked). Programmatic contexts (cron,
 * drush: anonymous user, no active domain) treat everything as hidden,
 * which makes the guard maximally protective there.
 *
 * @return array<string, list<string>>
 *   Hidden option values per field name.
 */
function _access_events_hidden_series_options(): array {
  $hidden = [];
  $roles = \Drupal::currentUser()->getRoles();
  if (!in_array('administrator', $roles, TRUE) && !in_array('news_pm', $roles, TRUE)) {
    $hidden['field_affiliation'] = [
      'access_nairr_office_hours',
      'nairr_pilot_partner_series',
      'cu_rmacc_webinars',
    ];
  }
  $domainId = NULL;
  if (\Drupal::hasService('domain.negotiator')) {
    $activeDomain = \Drupal::service('domain.negotiator')->getActiveDomain();
    $domainId = $activeDomain ? $activeDomain->id() : NULL;
  }
  if ($domainId !== 'amp_cyberinfrastructure_org') {
    $hidden['field_choose_where_to_share_this'] = ['in_the_access_support_bi_weekly_digest'];
  }
  return $hidden;
}

/**
 * Implements hook_ENTITY_TYPE_presave() for eventseries.
 *
 * Backstop for the EventSeriesRescheduleBlock constraint: the constraint only
 * runs where validate() runs, but some save paths (the content-moderation
 * widget, revision reverts) call save() directly. A recurrence/date change on
 * a series with registrations not verifiably past would let recurring_events
 * destructively rebuild every instance and hard-delete their registrants —
 * abort the save instead. Also mirrors the request-adjustment refusal, so
 * a bare save that skips validate() cannot silently hide a live registered
 * event either. Uses $entity->original (populated during presave, unlike at
 * validate time) for both diffs. Also guards domain_access: an empty value
 * on save is restored from the original (update) or filled from the active
 * domain (create); see DomainGuardTest.
 */
function access_events_eventseries_presave(EntityInterface $entity) {
  // Domain guard. The edit form renders a hidden, zero-option domain_access
  // widget for editors without domain permissions; the stored domain is
  // filtered out of its default and the hidden element round-trips an empty
  // value, which extraction happily saves — recurring_events' "Confirm Date
  // Changes" button bypasses any form-level backfill (hard-coded #submit),
  // so the guard lives here, at the entity layer, covering every save path.
  // Rules: an update that arrives empty restores the original domains (a
  // cross-domain series edited from another site keeps its home); a CREATE
  // that arrives empty is scoped to the active domain (browser and API
  // alike); an update whose original was also empty stays empty — a
  // deliberately all-affiliates series is never silently narrowed. Deletion
  // of domains by ANY user via an empty save is treated as the bug, not an
  // intent: on this site the events search view treats empty as invisible,
  // not as all-domains.
  if ($entity->hasField('domain_access') && $entity->get('domain_access')->isEmpty()) {
    $original = (!$entity->isNew() && $entity->original instanceof EventSeries)
      ? $entity->original
      : NULL;
    if ($original && !$original->get('domain_access')->isEmpty()) {
      $entity->set('domain_access', $original->get('domain_access')->getValue());
    }
    elseif ($entity->isNew() && \Drupal::hasService('domain.negotiator')) {
      $activeDomain = \Drupal::service('domain.negotiator')->getActiveDomain();
      if ($activeDomain) {
        $entity->set('domain_access', [$activeDomain->id()]);
      }
    }
  }

  // Strip guard: restore stored option values this editor's form context
  // hides. The form removes those options entirely, so the submission
  // round-trips without them and the save would silently strip values the
  // editor never saw (see _access_events_hidden_series_options()). Values
  // outside the hidden sets — anything the editor COULD see — are untouched,
  // so deliberate removals by privileged editors stick. Syncing saves are
  // exempt: a programmatic caller that sets the syncing flag is declaring
  // its values deliberate (CLI context would otherwise hide every option
  // and make intentional removals impossible). The guarded fields are
  // list_string ('value' column); an entity_reference entry in the map
  // would silently no-op here and needs target_id handling first.
  if (!$entity->isSyncing() && !$entity->isNew() && $entity->original instanceof EventSeries) {
    foreach (_access_events_hidden_series_options() as $guardedField => $hiddenValues) {
      if (!$entity->hasField($guardedField)) {
        continue;
      }
      $currentValues = array_column($entity->get($guardedField)->getValue(), 'value');
      $originalValues = array_column($entity->original->get($guardedField)->getValue(), 'value');
      $lostHidden = array_values(array_intersect(array_diff($originalValues, $currentValues), $hiddenValues));
      if ($lostHidden) {
        $entity->set($guardedField, array_map(
          static fn (string $value): array => ['value' => $value],
          array_merge($currentValues, $lostHidden),
        ));
      }
    }
  }

  if ($entity->isNew() || !$entity->original instanceof EventSeries) {
    return;
  }
  $counter = \Drupal::service('access_events.registrant_counter');

  // Request-adjustment refusal mirror: Request Adjustment (published ->
  // needs_adjustment) on a series that still has live registrations must not
  // silently hide it. Matches EventSeriesRescheduleBlockConstraintValidator's
  // request-adjustment refusal condition.
  if ($entity->original->isPublished()
    && $entity->get('moderation_state')->value === 'needs_adjustment'
    && $counter->countNotPastForSeries((int) $entity->id()) > 0) {
    throw new \RuntimeException('Request Adjustment would hide a live event that has registrations. Cancel (Archive) it instead — registrants will be notified.');
  }

  /** @var \Drupal\recurring_events\EventCreationService $creation */
  $creation = \Drupal::service('recurring_events.event_creation_service');
  if (!$creation->checkForOriginalRecurConfigChanges($entity, $entity->original)) {
    return;
  }
  $count = $counter->countNotPastForSeries((int) $entity->id());
  if ($count > 0) {
    throw new \RuntimeException("This event has registrations, so its schedule cannot be rebuilt. To reschedule: cancel the event (registrants are notified), change each occurrence's date, then restore the event. To adjust dates, edit the occurrences individually; to add or remove a date, add an occurrence or cancel one.");
  }
}

/**
 * Disables the confirm button on a contrib entity-delete form when blocked.
 *
 * The eventseries/eventinstance being deleted has registrations. Editors
 * should never actually reach the exception page the predelete
 * hooks throw (see access_events_eventseries_predelete(),
 * access_events_eventinstance_predelete(),
 * access_events_recurring_events_pre_delete_instance()) in normal browser
 * use — this is the UX layer that stops them before they submit. The throws
 * remain the backstop for anything that skips this form (API, direct code,
 * a resubmit with JS disabled).
 */
function access_events_disable_delete_when_registered(array &$form, FormStateInterface $form_state) {
  $entity = $form_state->getFormObject()->getEntity();
  // deletionBlockedReason() is strictly typed to EventSeries|EventInstance.
  // getEntity() is untyped on the interface, so a NULL (an AJAX partial
  // rebuild, or any form object whose entity is not yet set) or an entity of
  // an unrelated type (a future form id added to the two conditions above by
  // mistake) would otherwise reach it and throw a TypeError from inside
  // hook_form_alter — breaking the WHOLE form's render, not just this guard.
  // No-op cleanly instead; the predelete/pre_delete_instance hook throws
  // remain the real backstop regardless.
  if (!$entity instanceof EventSeries && !$entity instanceof EventInstance) {
    return;
  }
  $reason = \Drupal::service('access_events.event_delete_guard')->deletionBlockedReason($entity);
  if ($reason === NULL) {
    return;
  }
  $form['actions']['submit']['#disabled'] = TRUE;
  $form['access_events_delete_guard_message'] = [
    '#type' => 'markup',
    '#markup' => '<div class="messages messages--warning">' . Html::escape($reason) . '</div>',
    '#weight' => -10,
  ];
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for eventseries.
 *
 * Guards FIRST: a series with any registrations (past or future — attendance
 * history is protected data) can never be hard-deleted from any path. This
 * fires for every module-order-agnostic route to $series->delete()
 * (including the recurring_events series delete form, which calls
 * $entity->delete() directly with no pre-delete invokeAll of its own — the
 * cascade to instances happens INSIDE recurring_events' own predelete hook,
 * recurring_events_eventseries_predelete()). access_events_module_
 * implements_alter() below forces access_events to run BEFORE recurring_
 * events/recurring_events_registration on this hook (natural module-list
 * order alone does not guarantee it — verified directly in
 * EventDeleteGuardHooksTest), so this throw runs before contrib's predelete
 * ever fires, aborting inside the storage transaction — full rollback,
 * nothing deleted.
 */
function access_events_eventseries_predelete(EntityInterface $entity) {
  \Drupal::service('access_events.event_delete_guard')->assertDeletable($entity);
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for eventinstance.
 *
 * Same guard as access_events_eventseries_predelete(), scoped to a single
 * instance. Covers any code path that entity-deletes an eventinstance
 * directly (the past-preserving rebuild plugin's own belt-and-braces check
 * already guarantees its future-instance deletes are registrant-free, so
 * this never fires there — see PastPreservingEventInstanceCreator).
 *
 * This predelete alone is NOT sufficient for the two contrib delete forms
 * (EventInstanceDeleteForm, OrphanedEventInstanceForm): both invoke
 * hook_recurring_events_pre_delete_instance BEFORE calling $instance->
 * delete(), and recurring_events_registration's implementation of that hook
 * notifies-then-DELETES the registrants right there — so by the time THIS
 * predelete runs on those paths, the registrant count is already 0. See
 * access_events_recurring_events_pre_delete_instance() below, which is the
 * layer that actually protects those forms.
 */
function access_events_eventinstance_predelete(EntityInterface $entity) {
  \Drupal::service('access_events.event_delete_guard')->assertDeletable($entity);
}

/**
 * Implements hook_recurring_events_pre_delete_instance().
 *
 * The registrant guard for the two contrib delete forms
 * (EventInstanceDeleteForm::submitForm(), OrphanedEventInstanceForm::
 * submitForm()): both call moduleHandler->invokeAll('recurring_events_pre_
 * delete_instance', [$instance]) BEFORE $instance->delete(), and
 * recurring_events_registration's own implementation of this exact hook
 * (recurring_events_registration_recurring_events_pre_delete_instance())
 * notifies the registrants and then unconditionally deletes them — so an
 * eventinstance predelete guard alone is too late on these paths; the
 * registrants are already gone by the time predelete sees the instance.
 * access_events_module_implements_alter() below forces access_events to run
 * BEFORE recurring_events_registration on this hook (natural module-list
 * order alone does not guarantee it — verified directly in
 * EventDeleteGuardHooksTest), so this implementation's throw aborts
 * invokeAll() before the registration module's implementation runs, and no
 * registrant is ever touched.
 */
function access_events_recurring_events_pre_delete_instance(EventInstance $instance) {
  \Drupal::service('access_events.event_delete_guard')->assertDeletable($instance);
}

/**
 * Implements hook_recurring_events_registration_message_params_alter().
 *
 * Stamps the registrant's occurrence (and series) id onto the queued
 * notification's params. Registration notices are fully rendered and queued
 * at enqueue time and the queue table carries no column identifying which
 * occurrence a queued item belongs to. CancellationNotifier's supersede sweep
 * needs that id to scope its "remove the now-stale earlier notice" deletion to
 * a single occurrence, so it never removes a queued notice for a DIFFERENT
 * event to the same person. Stamping it here — the one place contrib exposes
 * for adding scalar params to a queued item — is what makes that safe scoping
 * possible. The id is read from the registrant's own eventinstance_id/
 * eventseries_id references, so it is correct regardless of which notification
 * key the item carries.
 */
function access_events_recurring_events_registration_message_params_alter(array &$params, $registrant): void {
  if (!is_object($registrant) || !method_exists($registrant, 'get')) {
    return;
  }
  $instanceId = $registrant->get('eventinstance_id')->target_id ?? NULL;
  if ($instanceId !== NULL) {
    $params[\Drupal\access_events\CancellationNotifier::INSTANCE_PARAM] = (int) $instanceId;
  }
  $seriesId = $registrant->get('eventseries_id')->target_id ?? NULL;
  if ($seriesId !== NULL) {
    $params['access_events_series_id'] = (int) $seriesId;
  }
}

/**
 * Implements hook_recurring_events_event_instance_creator_plugin_alter().
 *
 * recurring_events fires the active EventInstanceCreator plugin whenever a
 * published series' recurrence/date config changes. This site's
 * recurring_events.eventseries.config sets creator_plugin: null, and
 * EventInstanceCreatorPluginManager::createInstance() falls back to the
 * default plugin id (recurring_events_eventinstance_recreator, contrib's
 * destructive Recreate plugin) whenever the requested id is empty — so
 * today every such rebuild goes through the plugin that deletes and
 * recreates ALL instances, including ones whose date has already passed and
 * which may carry attendance history. Swap in the module's own
 * past-preserving plugin here instead, unconditionally: this only fires on
 * eventseries, and the invariant (never touch an ended instance) is safe for
 * every series regardless of recur type.
 *
 * This unconditionally overrides whatever choice contrib's
 * EventSeriesSettingsForm presents for the "Event instance creator" setting
 * — that admin form's value has no effect on this site as long as this hook
 * is enabled, since the alter always wins over whatever
 * EventInstanceCreatorPluginManager::createInstance() resolved.
 */
function access_events_recurring_events_event_instance_creator_plugin_alter(EventInstanceCreatorInterface &$active_plugin, EventInstanceCreatorPluginManager $plugin_manager, EventSeries $series) {
  $active_plugin = $plugin_manager->createInstance('access_events_past_preserving_recreator', []);
}

/**
 * Implements hook_recurring_events_event_instances_pre_create_alter().
 *
 * EventCreationService::createInstances() computes the full set of dates a
 * series' CURRENT recur config would produce (for both the 'custom' branch
 * and every rule-based recur type) and fires this alter on that computed set
 * immediately before creating any eventinstance entities. createInstances()
 * has THREE callers: PastPreservingEventInstanceCreator's own rebuild (where
 * past dates must be dropped so an ended, already-preserved instance is
 * never duplicated), and recurring_events_eventseries_insert()/
 * _translation_insert() (a brand-new series, where a past date is a
 * legitimate thing to create — nothing exists yet to preserve). This alter
 * has no way to see which of the three called it, so it only filters while
 * PastPreservingEventInstanceCreator::isRebuilding($event) is TRUE for THIS
 * series — that plugin sets its rebuilding-series-id for the exact duration
 * of its own createInstances() call and nowhere else, and only for the one
 * series it is rebuilding. $events_to_create is keyed by
 * DrupalDateTime::format('r') => ['start_date' => DrupalDateTime, 'end_date'
 * => DrupalDateTime]. The `?? NULL` below fails OPEN (an entry with no
 * end_date key is KEPT, not dropped) — if contrib's shape ever changes so
 * end_date is absent/renamed, this filter silently stops filtering rather
 * than erroring, which would let the rebuild duplicate a preserved past
 * instance. PastPreservingRebuildTest is the tripwire for that drift.
 *
 * A SECOND exclusion runs after the past-date filter: any computed date whose
 * start exactly matches a preserved FLAGGED (individually_cancelled)
 * instance's start is also dropped, via
 * EffectiveCreationSet::filterFlaggedDates() — the SAME method
 * EffectiveCreationSet::compute() calls, so this alter and that read-only
 * preview path can never derive "does this date collide with a flagged
 * instance" differently. By the time this alter fires mid-rebuild, a flagged
 * instance has already been skipped by PastPreservingEventInstanceCreator's
 * delete loop (see isFlagged() there) and so is still present in $event's
 * event_instances — there is no live twin left to create at its date.
 */
function access_events_recurring_events_event_instances_pre_create_alter(array &$events_to_create, EventSeries $event) {
  if (!PastPreservingEventInstanceCreator::isRebuilding($event)) {
    return;
  }
  $now = \Drupal::time()->getRequestTime();
  foreach ($events_to_create as $key => $dates) {
    $end = $dates['end_date'] ?? NULL;
    if ($end && $end->getTimestamp() <= $now) {
      unset($events_to_create[$key]);
    }
  }
  $events_to_create = EffectiveCreationSet::filterFlaggedDates($events_to_create, $event);
}

/**
 * Implements hook_recurring_events_event_instance_alter().
 *
 * This alter fires from two callers, and only one of them carries a series.
 *
 * The machinery path (EventCreationService::createEventInstance(), patched to
 * pass the series as the alter's second argument — the contrib patch at
 * EventCreationService.php:553) stamps the new occurrence's birth state to
 * follow its series: a live series bears live occurrences; a dark (draft or
 * cancelled) series' occurrences are born archived so a later series restore
 * or first publish sweep brings them along.
 *
 * The hand-authored path (EventSeriesController::addInstance(), the
 * /events/series/{eventseries}/add "Add Instance" form) invokes the same alter
 * with only $data and no series, so $event arrives NULL. That is the correct
 * signal to leave the moderation_state untouched: an occurrence a person
 * authors directly must be born in the workflow's own default state (draft),
 * never swept by a series-level transition. So when no series is present we
 * return early and stamp nothing. The nullable parameter is what keeps that
 * caller from throwing a TypeError and white-screening the Add Instance form.
 */
function access_events_recurring_events_event_instance_alter(array &$data, ?EventSeries $event = NULL): void {
  // No series context: the hand-authored Add Instance path. Leave the
  // workflow default (draft) in place — a person-authored occurrence is born
  // draft and is never carried by a series restore sweep.
  if ($event === NULL) {
    return;
  }
  $data['moderation_state'] = $event->isPublished() ? 'published' : 'archived';
}

/**
 * Implements hook_search_api_query_alter().
 *
 * Apply where_to_share filter at the Search API query level for API exports.
 * This ensures correct pager counts — the Views-level filter on this
 * multi-value field causes the search_api_db pager to miscount rows.
 */
function access_events_search_api_query_alter(\Drupal\search_api\Query\QueryInterface &$query) {
  if ($query->getIndex()->id() !== 'events') {
    return;
  }

  $search_id = $query->getSearchId();
  $api_exports = [
    'views_data_export:events_facet__data_export_4',
  ];

  if (in_array($search_id, $api_exports)) {
    $query->addCondition('where_to_share', 'on_the_announcements_page');
    // Also apply domain filter at query level (same as page displays do in
    // views_query_alter) so it doesn't happen post-query and break pager counts.
    $domain_id = \Drupal::service('access_misc.sitetools')->getDomainId();
    if ($domain_id) {
      $query->addCondition('domain_access', $domain_id);
    }
  }
}

/**
 * Implements hook_search_api_db_query_alter().
 *
 * Fix pager counts for events API exports. Multi-value field JOINs
 * (where_to_share, domain_access) produce duplicate rows that inflate the
 * pager count, causing pages to return fewer items than requested.
 *
 * Solution: replace LEFT JOIN + WHERE conditions on multi-value tables with
 * EXISTS subqueries, which don't produce duplicate rows.
 */
function access_events_search_api_db_query_alter(\Drupal\Core\Database\Query\SelectInterface &$db_query, \Drupal\search_api\Query\QueryInterface $query) {
  if ($query->getIndex()->id() !== 'events') {
    return;
  }

  $search_id = $query->getSearchId();
  $api_exports = [
    'views_data_export:events_facet__data_export_4',
  ];

  if (!in_array($search_id, $api_exports)) {
    return;
  }

  // Multi-value field JOINs inflate pager counts because the LEFT JOIN
  // produces multiple rows per item. Fix: remove the JOINs and their
  // WHERE conditions, replace with EXISTS subqueries.
  $multi_value_tables = [
    'search_api_db_events_where_to_share',
    'search_api_db_events_domain_access',
  ];

  $tables = &$db_query->getTables();
  $alias_to_table = [];
  foreach ($tables as $alias => $info) {
    if ($alias === 't') {
      continue;
    }
    if (is_scalar($info['table']) && in_array($info['table'], $multi_value_tables)) {
      $alias_to_table[$alias] = $info['table'];
    }
  }

  if (empty($alias_to_table)) {
    return;
  }

  // Recursively find and replace conditions on multi-value aliases with EXISTS.
  // Conditions are nested in groups, so we walk the tree.
  access_events_replace_mv_conditions($db_query->conditions(), $alias_to_table, $db_query);

  // Remove the JOINs.
  foreach (array_keys($alias_to_table) as $alias) {
    unset($tables[$alias]);
  }
}

/**
 * Implements hook_views_query_alter().
 *
 * Filter events by the current domain on page and block displays.
 */
function access_events_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() === 'events_facet' && ($view->current_display === 'page_1' || $view->current_display === 'page_2' || $view->current_display === 'block_1')) {
    $domain_id = \Drupal::service('access_misc.sitetools')->getDomainId();
    if ($domain_id) {
      $query->addCondition('domain_access', $domain_id, '=');
    }
  }

}

/**
 * Implements hook_entity_access().
 */
function access_events_entity_access(EntityInterface $entity, $operation, AccountInterface $account) {
  if (($entity->getEntityTypeId() == 'eventinstance' || $entity->getEntityTypeId() == 'eventseries') && $entity->bundle() == 'default') {
    $author = $entity->getOwner();
    if (!$author) {
      return AccessResult::neutral();
    }
    $author_id = $author->id();
    $current_user = \Drupal::currentUser();
    $current_user_id = $current_user->id();

    // Get field 'field_other_authors'.
    $other_authors = [];
    if ($entity->getEntityTypeId() == 'eventseries') {
      $other_authors = $entity->get('field_other_authors')->getValue();
    }
    elseif ($entity->getEntityTypeId() == 'eventinstance'){
      // For eventinstance, get the parent eventseries and check its field_other_authors
      // since other_authors is inherited via field_inheritance.
      $eventseries = $entity->getEventSeries();
      if ($eventseries && $eventseries->hasField('field_other_authors')) {
        $other_authors = $eventseries->get('field_other_authors')->getValue();
      }
    }

    $other_author_allowed = FALSE;

    foreach ($other_authors as $key => $value) {
      $target_id = $value['target_id'] ?? 0;
      if ($target_id == $current_user_id) {
        $other_author_allowed = TRUE;
        break;
      }
    }

    if ($author_id == $current_user_id) {
      // Allow access if the user is the author of the event instance.
      return AccessResult::allowed()
        ->addCacheContexts(['user'])
        ->addCacheableDependency($entity);
    }
    elseif ($other_author_allowed) {
      // Allow access if the user is listed as other author.
      return AccessResult::allowed()
        ->addCacheContexts(['user'])
        ->addCacheableDependency($entity);
    }
    else {
      // Return neutral if not author.
      return AccessResult::neutral()
        ->addCacheContexts(['user'])
        ->addCacheableDependency($entity);
    }
  }

  // Return neutral for all other cases.
  return AccessResult::neutral();
}

/**
 * Implements hook_module_implements_alter().
 *
 * Disable the recurring_events_reminders cron hook to replace it with our own
 * implementation that includes a check for events that have already started.
 *
 * Also FORCES access_events to run FIRST (not merely "before" by install
 * order, which is not a guarantee module_implements() honors — verified: in
 * a plain module list this site's actual order puts
 * recurring_events/recurring_events_registration BEFORE access_events on
 * eventseries_predelete and recurring_events_pre_delete_instance) on the
 * three hooks the delete-registrant guard depends on running first:
 *  - eventseries_predelete — our guard must run before
 *    recurring_events_eventseries_predelete()'s instance-delete cascade;
 *  - eventinstance_predelete — access_events is currently the only
 *    implementation, but pin it defensively so a future contrib
 *    implementation can never land ahead of the guard unnoticed;
 *  - recurring_events_pre_delete_instance — our guard must run before
 *    recurring_events_registration_recurring_events_pre_delete_instance(),
 *    which notifies-then-deletes the registrant, inside the SAME invokeAll()
 *    call the two contrib delete forms make.
 * Without this, a hard delete on a registered event would silently succeed
 * on any environment where module install order happens to differ.
 */
function access_events_module_implements_alter(&$implementations, $hook) {
  if ($hook === 'cron' && isset($implementations['recurring_events_reminders'])) {
    unset($implementations['recurring_events_reminders']);
  }
  // recurring_events_registration_entity_update() enqueues a reschedule
  // notice off ANY eventinstance date change, checked ONLY against the
  // post-save new end date — no published check, no default-revision check.
  // A date edit on a still-drafting or already-archived occurrence would
  // silently notify registrants of a "reschedule" on an event nobody can see.
  // access_events_eventinstance_update() (via EventStateReactions::
  // instanceUpdate() -> reactToInstanceModified()) replaces it with the same
  // notice, state-gated: default revision, published both before and after
  // the save, and the date actually changed. Removing the implementation
  // entirely (not reordering it) means this is the only place the notice can
  // fire from — there is nothing left to run before or after.
  if ($hook === 'entity_update' && isset($implementations['recurring_events_registration'])) {
    unset($implementations['recurring_events_registration']);
  }
  if ($hook === 'entity_base_field_info_alter' && isset($implementations['access_events'])) {
    $group = $implementations['access_events'];
    unset($implementations['access_events']);
    $implementations['access_events'] = $group;
  }
  // Run our form_alter AFTER field_inheritance so we can collapse its admin
  // widget on eventinstance forms (it sets #open=TRUE; we override to FALSE).
  if ($hook === 'form_alter' && isset($implementations['access_events'])) {
    $group = $implementations['access_events'];
    unset($implementations['access_events']);
    $implementations['access_events'] = $group;
  }
  // Run our eventseries_update AFTER recurring_events' — the opposite
  // direction from the delete-guard "must run FIRST" pins below.
  // EventStateReactions::seriesUpdate()'s rebuild trigger and cancel/restore
  // sweeps need the series' instance set as
  // recurring_events_eventseries_update()
  // left it (its own rebuild for a published/unmoderated series, and its
  // per-instance status sync) — reading a fresh entity query, not the
  // computed event_instances field, is what actually makes this correct even
  // when order is uncertain, but pinning it removes the uncertainty rather
  // than relying on incidental module-list order.
  if ($hook === 'eventseries_update' && isset($implementations['access_events'])) {
    $group = $implementations['access_events'];
    unset($implementations['access_events']);
    $implementations['access_events'] = $group;
  }
  $mustRunFirst = ['eventseries_predelete', 'eventinstance_predelete', 'recurring_events_pre_delete_instance'];
  // isset() guards against access_events having no implementation of $hook at
  // all — e.g. if a future refactor removes
  // access_events_eventinstance_predelete() while leaving the other two, this
  // stays a no-op for that hook instead of writing a bogus
  // ['access_events' => NULL] entry into $implementations that would corrupt
  // the array (module_implements() expects every value to be a real include-
  // group string or FALSE, never an absent key coerced to NULL).
  if (in_array($hook, $mustRunFirst, TRUE) && isset($implementations['access_events'])) {
    $group = $implementations['access_events'];
    unset($implementations['access_events']);
    $implementations = ['access_events' => $group] + $implementations;
  }
}

/**
 * Implements hook_tokens_alter().
 *
 * Fix the reminder_message token to return processed HTML instead of raw value.
 * The contrib module returns ->value (raw text), but we need ->processed
 * (HTML filtered through the text format). Note: Markup wrapping here doesn't
 * prevent escaping in emails since Token::replace() converts to string;
 * see access_events_mail_alter() for the email escaping fix.
 */
function access_events_tokens_alter(array &$replacements, array $context, \Drupal\Core\Render\BubbleableMetadata $bubbleable_metadata) {
  if ($context['type'] === 'eventseries' && !empty($context['data']['eventseries'])) {
    $event_series = $context['data']['eventseries'];
    foreach ($context['tokens'] as $name => $original) {
      if ($name === 'reminder_message' && isset($replacements[$original])) {
        // Replace raw value with processed HTML (filtered through text format).
        if ($event_series->hasField('registration_reminders') && !$event_series->registration_reminders->isEmpty()) {
          $processed = $event_series->registration_reminders->processed;
          if ($processed) {
            $replacements[$original] = $processed;
          }
        }
      }
    }
  }
}

/**
 * Implements hook_mail_alter().
 *
 * Convert registration_reminder email body to Markup to prevent HTML escaping.
 * The symfony_mailer LegacyMailerHelper::formatBody() preserves MarkupInterface
 * objects but escapes plain strings through processed_text.
 */
function access_events_mail_alter(&$message) {
  if ($message['module'] === 'recurring_events_registration' && $message['key'] === 'registration_reminder') {
    if (is_array($message['body'])) {
      foreach ($message['body'] as $key => $part) {
        if (is_string($part)) {
          $message['body'][$key] = Markup::create($part);
        }
      }
    }
    elseif (is_string($message['body'])) {
      $message['body'] = [Markup::create($message['body'])];
    }
  }
}

/**
 * Implements hook_cron().
 */
function access_events_cron() {
  // Send post survey emails.
  \Drupal::service('access_events.post_survey')->postSurveyEmail();

  // Send post survey reminder emails.
  \Drupal::service('access_events.post_survey')->postSurveyReminderEmail();

  // Send registration reminder emails (replaces recurring_events_reminders_cron).
  _access_events_send_registration_reminders();
}

/**
 * Send registration reminder emails to registrants.
 *
 * This replaces recurring_events_reminders_cron() with additional logic
 * to skip events that have already started.
 */
function _access_events_send_registration_reminders() {
  $query = \Drupal::entityTypeManager()->getStorage('eventinstance')->getQuery();
  $event_instances = $query
    ->condition('reminder_date', NULL, 'IS NOT NULL')
    ->condition('reminder_sent', NULL, 'IS NULL')
    ->condition('reminder_date', time(), '<=')
    ->accessCheck(FALSE)
    ->execute();

  if (empty($event_instances)) {
    return;
  }

  $instances = \Drupal::entityTypeManager()->getStorage('eventinstance')->loadMultiple($event_instances);

  /** @var \Drupal\recurring_events\Entity\EventInstance $instance */
  foreach ($instances as $instance) {
    // A cancelled (archived) instance's registrants already got the
    // cancellation notice; a reminder to attend an event that has been
    // called off would contradict it. moderation_state is not queryable as an
    // entity-query condition here (it 500s — "'moderation_state' not found"),
    // so filter after load instead.
    if ($instance->get('moderation_state')->value === 'archived') {
      continue;
    }

    // An instance with no start date has no "already started" moment to
    // reason about — skip it rather than let a null start_date fatal the whole
    // cron reminder loop and abort every remaining instance's reminder.
    $start_date = $instance->date->start_date;
    if ($start_date === NULL) {
      continue;
    }

    // Skip sending reminder if the event has already started.
    if ($start_date->getTimestamp() <= time()) {
      // Mark as sent to prevent future attempts.
      $instance->set('reminder_sent', time());
      $instance->setNewRevision(FALSE);
      $instance->save();
      \Drupal::logger('access_events')->notice('Skipped reminder for event instance @id - event has already started.', [
        '@id' => $instance->id(),
      ]);
      continue;
    }

    $instance->set('reminder_sent', time());
    $instance->setNewRevision(FALSE);
    $instance->save();

    /** @var \Drupal\recurring_events_registration\RegistrationCreationService $registration_creation_service */
    $registration_creation_service = \Drupal::service('recurring_events_registration.creation_service');
    $registration_creation_service->setEventInstance($instance);

    $registrants = $registration_creation_service->retrieveRegisteredParties();

    if (empty($registrants)) {
      continue;
    }

    $key = 'registration_reminder';

    $config = \Drupal::config('recurring_events_registration.registrant.config');
    $queue_is_enabled = $config->get('email_notifications_queue');

    // Send an email to all registrants.
    foreach ($registrants as $registrant) {
      if ($queue_is_enabled) {
        // Add each notification to be sent to the queue.
        \Drupal::service('recurring_events_registration.notification_service')->addEmailNotificationToQueue($key, $registrant);
      }
      else {
        // If the queue is not enabled, send this notification immediately.
        recurring_events_registration_send_notification($key, $registrant);
      }
    }

    \Drupal::logger('access_events')->notice('Sent registration reminder for event instance @id to @count registrants.', [
      '@id' => $instance->id(),
      '@count' => count($registrants),
    ]);
  }
}

/**
 * Custom validation handler for registrant eligibility checking.
 *
 * Checks if user is eligible for events with allocation grants.
 */
function access_events_registrant_eligibility_validate($form, FormStateInterface $form_state) {
  /** @var \Drupal\recurring_events_registration\Entity\Registrant $entity */
  $entity = $form_state->getFormObject()->getEntity();

  // Only check eligibility for new registrations.
  if (!$entity->isNew()) {
    return;
  }

  $route_match = \Drupal::routeMatch();
  $event_instance = $route_match->getParameter('eventinstance');

  if (!$event_instance) {
    return;
  }

  $event_series = $event_instance->getEventSeries();

  // Check if this event has an allocation grant configured.
  if (!$event_series->hasField('field_event_allocation_grant') ||
      $event_series->get('field_event_allocation_grant')->isEmpty()) {
    return;
  }

  $grant = $event_series->get('field_event_allocation_grant')->value;

  // Only check eligibility if there's a valid grant number.
  if (!$grant || $grant == 0) {
    return;
  }

  // Get the current user.
  $current_user = \Drupal::currentUser();
  $user = User::load($current_user->id());

  if (!$user) {
    return;
  }

  $username = $user->getAccountName();
  // Strip @access-ci.org suffix if present.
  $username = str_replace('@access-ci.org', '', $username);

  // Check eligibility via the API.
  try {
    $xsede_api = \Drupal::service('access_events.XsedeApi');
    $eligibility = $xsede_api->isPersonEligible($username);

    if (!$eligibility['eligible']) {
      \Drupal::logger('access_events')->notice('Registration blocked for user @username for event with grant @grant. Reason: @reason', [
        '@username' => $username,
        '@grant' => $grant,
        '@reason' => $eligibility['reason'] ?? 'none provided',
      ]);

      // Build error message with reason if available.
      if (!empty($eligibility['reason'])) {
        $error_message = t('You are not eligible to register for this event. @reason', [
          '@reason' => $eligibility['reason'],
        ]);
      }
      else {
        $error_message = t('You are not eligible to register for this event. Please contact support if you believe this is an error.');
      }

      $form_state->setError($form, $error_message);
    }
  }
  catch (\Exception $e) {
    // Log the error but don't block registration if API is unavailable.
    \Drupal::logger('access_events')->error('Error checking eligibility for user @username: @message. Allowing registration to proceed.', [
      '@username' => $username,
      '@message' => $e->getMessage(),
    ]);
  }
}

/**
 * Form-level mirror of access_events_entity_presave()'s
 * registration-requires-published-occurrence gate.
 *
 * A bare/programmatic Registrant::create()->save() is refused with an
 * uncaught RuntimeException by the presave hook; a form submission needs the
 * same refusal to surface as a normal field-level validation error instead.
 * Only ever attached to the ADD form (see access_events_form_alter()) and
 * only checks NEW entities — the gate exempts updates entirely, so this
 * re-checks isNew() as a second guard even though the form it's attached to
 * is add-only, in case a future change ever reuses this callback elsewhere.
 */
function access_events_registrant_publish_gate_validate($form, FormStateInterface $form_state) {
  /** @var \Drupal\recurring_events_registration\Entity\Registrant $entity */
  $entity = $form_state->getFormObject()->getEntity();
  if (!$entity->isNew() || !$entity->hasField('eventinstance_id')) {
    return;
  }

  $instanceId = _access_events_registrant_gate_instance_id($entity);
  $registrable = $instanceId > 0
    && \Drupal::service('access_events.state_reactions')->instanceIsRegistrable($instanceId);
  if (!$registrable) {
    $form_state->setErrorByName('', t('Registration is closed — this occurrence is not currently published.'));
  }
}

/**
 * Resolves the eventinstance id a NEW registrant is being created against.
 *
 * Contrib's RegistrantForm only calls setEventInstance() (populating the
 * entity's eventinstance_id field) inside save(), AFTER form validation
 * runs — so at validate time the unsaved entity's field is always empty.
 * The route the add form is served on (entity.registrant.add_form,
 * /events/{eventinstance}/registrations/add) carries the target instance in
 * its {eventinstance} parameter, upcast to an EventInstance object by the
 * route's entity:eventinstance parameter converter, so fall back to reading
 * it from there when the entity field is unset.
 *
 * @param \Drupal\recurring_events_registration\Entity\Registrant $entity
 *   The new (unsaved) registrant.
 * @param \Drupal\Core\Routing\RouteMatchInterface|null $routeMatch
 *   The route match to consult; defaults to the current request's.
 *
 * @return int
 *   The resolved instance id, or 0 if neither source yields one.
 */
function _access_events_registrant_gate_instance_id($entity, ?\Drupal\Core\Routing\RouteMatchInterface $routeMatch = NULL): int {
  if ($entity->hasField('eventinstance_id')) {
    $fieldInstanceId = (int) $entity->get('eventinstance_id')->target_id;
    if ($fieldInstanceId > 0) {
      return $fieldInstanceId;
    }
  }

  $routeMatch = $routeMatch ?? \Drupal::routeMatch();
  $routeInstance = $routeMatch->getParameter('eventinstance');
  if ($routeInstance instanceof EventInstance) {
    return (int) $routeInstance->id();
  }
  if (is_numeric($routeInstance)) {
    return (int) $routeInstance;
  }

  return 0;
}

/**
 * #after_build callback for the eventinstance form (admin only). Reorders
 * the form so admin-only tracking fields land in sensible places: the
 * post-survey-sent indicators move next to the post-survey email body, and
 * domain_access moves to the very end. Runs after every hook_form_alter so
 * the weight assignments aren't overwritten.
 */
function _access_events_eventinstance_after_build(array $element, \Drupal\Core\Form\FormStateInterface $form_state) {
  if (isset($element['domain_access'])) {
    $element['domain_access']['#weight'] = 99;
  }
  // Place the post-survey-sent indicators right after the post-survey
  // accordion so they render in context. Setting these in form_alter is
  // overwritten by later hooks; #after_build wins.
  if (isset($element['field_post_survey_sent'])) {
    $element['field_post_survey_sent']['#weight'] = 28.5;
  }
  if (isset($element['field_post_survey_reminder_sent'])) {
    $element['field_post_survey_reminder_sent']['#weight'] = 28.6;
  }
  return $element;
}

/**
 * Attaches token-documentation #prefix content to the three event email body
 * fields. Used by both the series and the instance form_alters so editors see
 * the same available-tokens reference whether they're authoring at series
 * level or overriding at instance level.
 */
function _access_events_attach_email_token_prefixes(array &$form) {
  $registration_tokens = '<p class="text-sm mt-2"><strong>Available tokens:</strong> <code>{{ name }}</code>, <code>{{ title_link }}</code>, <code>{{ start_date }}</code>, <code>{{ screen_survey_url }}</code></p>';
  if (isset($form['field_screen_survey_email_text'])) {
    $form['field_screen_survey_email_text']['#prefix'] = t('This is the full email body sent when someone registers. You can customize the entire email using the tokens below.') . $registration_tokens;
  }

  $approval_tokens = '<p class="text-sm mt-2"><strong>Available tokens:</strong> <code>{{ name }}</code>, <code>{{ title_link }}</code>, <code>{{ start_date }}</code>, <code>{{ location }}</code>, <code>{{ event_start_time }}</code>, <code>{{ event_end_time }}</code>, <code>{{ pre_survey_url }}</code></p>';
  if (isset($form['field_pre_survey_email_text'])) {
    $form['field_pre_survey_email_text']['#prefix'] = t('This is the full email body sent when a registration is approved. You can customize the entire email using the tokens below.') . $approval_tokens;
  }

  $post_survey_tokens = '<p class="text-sm mt-2"><strong>Available tokens:</strong> <code>{{ name }}</code>, <code>{{ title }}</code>, <code>{{ post_survey_url }}</code></p>';
  if (isset($form['field_post_survey_email_text'])) {
    $form['field_post_survey_email_text']['#prefix'] = t('This is the full email body sent near the end of the event with a post-survey link. A reminder is sent 3 days later if unused. You can customize the entire email using the tokens below.') . $post_survey_tokens;
  }
}

/**
 * Attaches the leaving-published/arriving-published moderation warning to an
 * eventseries/eventinstance entity-edit form, ahead of the moderation_state
 * widget.
 *
 * Shown unconditionally based on the entity's CURRENT (last-saved) state —
 * not the value the editor eventually picks, which is not known until the
 * form is submitted: a currently-published entity always carries the
 * leaving-published warning (any transition away from published is a
 * cancel), and a currently-NOT-published entity always carries the
 * arriving-published warning (choosing Published is what would republish
 * it). A brand-new entity (add form) gets neither: isNew() has no saved
 * state to leave, and — for a series — no recurrence configuration yet to
 * compute an effective creation set from, so this is a no-op there; see the
 * isNew() guard below.
 *
 * No '#cache' max-age override here: unlike the standalone moderation form
 * (see _access_events_attach_standalone_moderation_warnings()), a full
 * entity-edit form is already per-user/per-entity and not render-cached the
 * same way, so the counts computed here are safe to compute once per
 * request without an explicit cache-bust.
 */
function _access_events_attach_moderation_warnings(array &$form, $entity, bool $isProcessingInput = FALSE): void {
  if (!$entity instanceof EventSeries && !$entity instanceof EventInstance) {
    return;
  }
  if (!isset($form['moderation_state'])) {
    return;
  }
  // A brand-new entity (add form) has no saved state to leave (the leaving-
  // published branch never applies) and, for a series, no recurrence
  // configuration yet to compute an effective creation set from (the
  // arriving-published branch would call EffectiveCreationSet::compute()
  // against a series with no recur type). Nothing meaningful to warn about
  // either way — skip entirely.
  if ($entity->isNew()) {
    return;
  }

  $formWarnings = \Drupal::service('access_events.form_warnings');
  $warningText = $entity->isPublished()
    ? $formWarnings->leavingPublishedWarning($entity)
    : $formWarnings->arrivingPublishedWarning($entity);

  // Draft-on-dark is a separate, always-shown disclosure (out of scope for the
  // registrant rework); it is NOT gated on registrant count.
  $draftOnDark = ($entity instanceof EventInstance
    && $entity->get('moderation_state')->value === 'archived'
    && isset($form['moderation_state']['widget'][0]['state']['#options']['draft']))
    ? (string) $formWarnings->draftOnDarkWarning()
    : NULL;

  if ($warningText === NULL && $draftOnDark === NULL) {
    return;
  }

  // Nested-in-widget copy (B): renders right next to the "Change to" select,
  // travelling with the widget wherever field_group/#after_build moves it.
  $markup = '';
  if ($warningText !== NULL) {
    $markup .= '<div class="messages messages--warning">' . Html::escape((string) $warningText) . '</div>';
  }
  if ($draftOnDark !== NULL) {
    $markup .= '<div class="messages messages--warning">' . Html::escape($draftOnDark) . '</div>';
  }
  $form['moderation_state']['widget'][0]['state']['#suffix'] =
    ($form['moderation_state']['widget'][0]['state']['#suffix'] ?? '') . $markup;

  // Top-of-page copy (A): the registrant warning only (not the draft-on-dark
  // mechanics note). Added on GET render only — added on every build it would
  // re-stack on AJAX rebuilds, since Messenger dedupes only within one request.
  if ($warningText !== NULL && !$isProcessingInput) {
    \Drupal::messenger()->addWarning($warningText);
  }
}

/**
 * Attaches the schedule-change disclosure to a series EDIT form, up front
 * near the recurrence fields.
 *
 * A schedule (recurrence pattern or dates) change on an existing series
 * regenerates its occurrences from the recur config — see
 * access_events_recurring_events_event_instances_pre_create_alter() for the
 * rebuild itself and EventSeriesRescheduleBlockConstraint for the refusal
 * that applies when the series has registrations. Neither of those fires
 * until the form is actually submitted, so an editor opening the edit form
 * has no way to know any of this is coming — this disclosure states it up
 * front, before they touch the recurrence fields, using
 * FormWarnings::scheduleChangeWarning() to decide whether anything on this
 * series is actually at risk (a NULL return means nothing qualifies, and no
 * warning is attached).
 *
 * Static render (no AJAX): the warning reflects the series' CURRENT (last-
 * saved) occurrences and recur config, not whatever the editor has not yet
 * typed into the form — recomputing it live as fields change would need
 * AJAX wiring this task does not add, and would anyway not know a fully
 * hypothetical, not-yet-submitted recur config's effective set without
 * running the same compute() against unsaved values. '#cache' =>
 * ['max-age' => 0]: this reads the series' live occurrences and registrant
 * count, both of which can change between one render and the next for the
 * same route.
 */
function _access_events_attach_schedule_change_warning(array &$form, $entity): void {
  if (!$entity instanceof EventSeries || $entity->isNew()) {
    return;
  }
  if (!isset($form['recur_type'])) {
    return;
  }

  $formWarnings = \Drupal::service('access_events.form_warnings');
  $warningText = $formWarnings->scheduleChangeWarning($entity);
  if ($warningText === NULL) {
    return;
  }

  $form['access_events_schedule_change_warning'] = [
    '#type' => 'markup',
    '#markup' => '<div class="messages messages--warning">' . Html::escape((string) $warningText) . '</div>',
    '#weight' => isset($form['recur_type']['#weight']) ? $form['recur_type']['#weight'] - 1 : -90,
    '#cache' => ['max-age' => 0],
  ];
}

/**
 * Alters the standalone content_moderation_entity_moderation_form
 * (core's \Drupal\content_moderation\Form\EntityModerationForm) for
 * eventseries/eventinstance.
 *
 * This form is a bare state-change picker — a select of valid target states
 * plus a log-message field — reached from an entity's "moderation" local
 * task. It never carries the full entity-edit form's fields, so none of the
 * entity-edit-form treatments above apply here; this function is the
 * complete, self-contained treatment for this one form.
 *
 * NO leaving-published warning is attached here: core's EntityModerationForm
 * EXCLUDES self-transitions and hides entirely when the current state has no
 * valid outbound transition at all (see buildForm()'s early return), but it
 * still renders on a PUBLISHED default entity whenever any transition away
 * from published is valid — so in principle a "leaving published" warning
 * COULD apply. It is intentionally omitted anyway, per this task's brief:
 * this form is reached from a moderation-focused workflow where the
 * transition's own label (Archive, Request Adjustment, ...) already signals
 * what is about to happen, and covering every one of core's dynamically-
 * generated target-state options with bespoke per-transition wording is out
 * of scope here.
 *
 * validate() is NEVER called on this form's entity: EntityModerationForm::
 * submitForm() calls $entity->save() directly (see core's source), and
 * ContentEntityInterface::save() does not itself run validate() — only
 * \Drupal\Core\Entity\ContentEntityForm::validateForm() does that, and this
 * form does not extend ContentEntityForm. So the schedule-rebuild refusal,
 * the request-adjustment refusal, and the occurrence-publish-under-
 * unpublished-event refusal never see a submission through this form at
 * all; the presave backstops (access_events_eventseries_presave(),
 * EventStateReactions::instancePresave()) are the only thing that would
 * refuse a bad save here, and they throw an uncaught exception rather than
 * a clean form error. The
 * validate handlers this function attaches close that gap: they run the
 * SAME checks the constraints run (via the validators' own checkViolations()/
 * checkViolation() methods, never a re-typed copy of the message strings)
 * and report failures as ordinary $form_state->setErrorByName() messages.
 */
function _access_events_standalone_moderation_form_alter(array &$form, FormStateInterface $form_state): void {
  // No-op guard: a future core change, or any other entity type this form
  // ends up reused for, might not carry a new_state element at all (core's
  // own buildForm() returns the bare $form with no new_state key when there
  // are zero valid target states) — every treatment below assumes new_state
  // exists, so bail out cleanly rather than let an isset()-less array access
  // fatal the whole form's render.
  if (!isset($form['new_state'])) {
    return;
  }

  $entity = $form_state->get('entity');
  if (!$entity instanceof EventSeries && !$entity instanceof EventInstance) {
    return;
  }

  $currentState = $entity->get('moderation_state')->value;

  if ($entity instanceof EventInstance && $currentState === 'archived') {
    // Re-add the current (archived) state, preselected. Core's
    // getValidTransitions() excludes self-transitions (transition->to() ===
    // current_state) from $target_states entirely, so an archived
    // occurrence's picker never offers "stay Archived" as an option — every
    // other option is some kind of move. Re-adding it here as the FIRST,
    // preselected option means an operator who opens this form just to look
    // (or to set a log message without actually changing state) submits
    // Apply and gets back exactly what they had, instead of being forced to
    // pick SOME other state. This works because core's submitForm() applies
    // whatever value FormAPI accepted for the SELECT element unvalidated
    // against "is this actually a legal transition" — Select's own
    // validation only checks the value is a KEY PRESENT in #options (see
    // \Drupal\Core\Render\Element\Select), which re-adding it here
    // satisfies; submitForm() then just does $entity->set('moderation_state',
    // $new_state) and saves, with no separate transition-validity check.
    $form['new_state']['#options'] = [$currentState => $form['current']['#markup'] ?? t('Archived')] + $form['new_state']['#options'];
    $form['new_state']['#default_value'] = $currentState;
  }

  if ($entity instanceof EventInstance && $currentState === 'needs_adjustment') {
    // Reorder a non-publishing option first. Transitions are weight-sorted
    // (see \Drupal\workflows\Plugin\WorkflowTypeBase::labelWeightMultisort())
    // and, in this workflow, the publish transition (weight 1) is the
    // lowest-weight transition valid FROM needs_adjustment whenever an
    // operator holds the publish permission — so without intervention it is
    // always #options' first entry, and a plain <select> with no explicit
    // #default_value preselects its first option. An operator who opens this
    // form, glances at the log-message field, and clicks Apply without
    // deliberately choosing a state would silently republish a needs-
    // adjustment occurrence. Promote the FIRST non-'published' option (by
    // #options' existing order — whatever core's weight-sort already put
    // there) ahead of 'published' instead, so the accidental-default lands
    // on something that is not a publish.
    $options = $form['new_state']['#options'];
    $firstKey = array_key_first($options);
    if ($firstKey === 'published') {
      $nonPublishingOptions = array_diff_key($options, ['published' => TRUE]);
      $firstNonPublishingKey = array_key_first($nonPublishingOptions);
      if ($firstNonPublishingKey !== NULL) {
        $form['new_state']['#options'] = [$firstNonPublishingKey => $options[$firstNonPublishingKey]] + $options;
      }
    }
  }

  // Inline warnings: arriving-at-published (the currently-selectable
  // 'published' option's implication), and the choosing-Draft-on-dark
  // warning — shown for ANY currently-archived occurrence whose select
  // offers a draft option, regardless of individually_cancelled. The series
  // restore sweep (EventStateReactions::sweepRestore()) only republishes
  // instances it finds still in the archived state, and it already skips
  // flagged (individually_cancelled) ones on its own — so a flagged
  // occurrence was never going to return via that sweep either way, but an
  // UNFLAGGED archived occurrence would have. Moving either kind to Draft
  // takes it out of the archived state the sweep queries for, stranding it
  // from that mechanism regardless of the flag. '#cache' => ['max-age' => 0]
  // on the wrapping element: this form (and the counts it shows) is specific
  // to the CURRENT state of the entity and the notification-gate config,
  // both of which can change between one render and the next for the same
  // route — render caching this element would risk showing a stale
  // count/gate-state to a subsequent viewer of the same page.
  $formWarnings = \Drupal::service('access_events.form_warnings');
  $warningLines = [];

  if (isset($form['new_state']['#options']['published'])) {
    $arriving = $formWarnings->arrivingPublishedWarning($entity);
    if ($arriving !== NULL) {
      $warningLines[] = (string) $arriving;
    }
  }

  if ($entity instanceof EventInstance
    && $currentState === 'archived'
    && isset($form['new_state']['#options']['draft'])) {
    $warningLines[] = (string) $formWarnings->draftOnDarkWarning();
  }

  if ($warningLines) {
    $markup = '';
    foreach ($warningLines as $line) {
      $markup .= '<div class="messages messages--warning">' . Html::escape($line) . '</div>';
    }
    $form['access_events_moderation_warnings'] = [
      '#type' => 'markup',
      '#markup' => $markup,
      '#weight' => -100,
      '#cache' => ['max-age' => 0],
    ];
  }

  $form['#validate'][] = 'access_events_standalone_moderation_validate';
}

/**
 * Validate handler for content_moderation_entity_moderation_form.
 *
 * Runs the SAME checks the EventSeriesRescheduleBlock constraint (the
 * schedule-rebuild refusal and the request-adjustment refusal) and the
 * EventInstancePublishGuard constraint (the occurrence-publish-under-
 * unpublished-event refusal) run — via each validator's own
 * checkViolations()/checkViolation() method, never a re-typed copy of the
 * message strings — against a candidate entity built from the entity core's
 * EntityModerationForm will actually save: the one it stashed on form_state
 * ($form_state->get('entity')), which is the LATEST revision and may carry
 * pending field changes (e.g. a rescheduled date on a pending draft) that
 * loadUnchanged() (the default revision) would not see. Applying the
 * submitted new_state to a clone of that entity is what lets the constraint
 * checks read the real config the save will present. This
 * _access_events_standalone_moderation_form_alter()'s docblock for why), so
 * without this handler the ONLY thing catching a disallowed transition here
 * would be a presave hook throwing an uncaught exception instead of a clean
 * form error.
 */
function access_events_standalone_moderation_validate(array &$form, FormStateInterface $form_state): void {
  $entity = $form_state->get('entity');
  if (!$entity instanceof EventSeries && !$entity instanceof EventInstance) {
    return;
  }

  $newState = $form_state->getValue('new_state');
  if (!$newState) {
    return;
  }

  // Clone the entity core will save (the latest revision on form_state, which
  // may carry pending field changes) and apply the submitted new_state, so the
  // constraint checks see the config the save will actually present rather than
  // the default revision's.
  $candidate = clone $entity;
  $candidate->set('moderation_state', $newState);

  if ($candidate instanceof EventSeries) {
    $constraint = new EventSeriesRescheduleBlockConstraint();
    $validator = EventSeriesRescheduleBlockConstraintValidator::create(\Drupal::getContainer());
    foreach ($validator->checkViolations($candidate, $constraint) as $message) {
      $form_state->setErrorByName('new_state', $message);
    }
  }
  elseif ($candidate instanceof EventInstance) {
    $validator = EventInstancePublishGuardConstraintValidator::create(\Drupal::getContainer());
    if ($validator->checkViolation($candidate)) {
      $constraint = new EventInstancePublishGuardConstraint();
      $form_state->setErrorByName('new_state', $constraint->message);
    }
  }
}

/**
 * Validate handler for the eventseries/eventinstance revision revert confirm
 * forms (recurring_events' own EventSeriesRevisionRevertForm /
 * EventInstanceRevisionRevertForm — form ids eventseries_revision_revert_
 * confirm / eventinstance_revision_revert_confirm), and their per-translation
 * variants (EventSeriesRevisionRevertTranslationForm /
 * EventInstanceRevisionRevertTranslationForm — form ids
 * eventseries_revision_revert_translation_confirm /
 * eventinstance_revision_revert_translation_confirm). The translation forms
 * extend the plain revert forms and pass the same raw revision id as
 * buildForm()'s first argument, so args[0] carries the revision id for all
 * four.
 *
 * Appended (not prepended): FormBuilder seeds a form's #validate array
 * (from the form object's own getFormId()-based defaults, i.e. core's
 * ConfirmFormBase::validateForm() chain) BEFORE hook_form_alter() runs, so a
 * handler pushed onto #validate here always runs AFTER whatever core's own
 * revert form already validates.
 *
 * Reverting to an old revision makes THAT revision's moderation_state the
 * new default — an old revision can carry a moderation_state that, applied
 * today, would trip the exact same schedule-rebuild, request-adjustment, or
 * occurrence-publish-under-unpublished-event refusals a live edit would.
 * Neither recurring_events' revert form nor core's ConfirmFormBase runs
 * $entity->validate() (a plain ConfirmFormBase, like the standalone
 * moderation form above), so without this handler a disallowed revert would
 * only be caught by a presave hook throwing an uncaught exception.
 *
 * The reverted-to revision is not exposed via $form_state->getFormObject()->
 * getEntity() (recurring_events' revert form classes are plain
 * ConfirmFormBase, not ContentEntityForm — they hold the revision on a
 * protected $revision property with no getter). It IS available from
 * $form_state->getBuildInfo()['args'][0] — the raw revision id passed as
 * buildForm()'s own $eventseries_revision/$eventinstance_revision parameter,
 * which FormBuilder records into build-info args before invoking buildForm()
 * — mirroring exactly what the revert form's own buildForm() does with it
 * (loadRevision()).
 */
function access_events_revision_revert_validate(array &$form, FormStateInterface $form_state): void {
  $args = $form_state->getBuildInfo()['args'] ?? [];
  $revisionId = $args[0] ?? NULL;
  if (!$revisionId) {
    return;
  }

  $formId = $form_state->getFormObject()->getFormId();
  $entityType = str_starts_with($formId, 'eventseries') ? 'eventseries' : 'eventinstance';
  $storage = \Drupal::entityTypeManager()->getStorage($entityType);
  if (!method_exists($storage, 'loadRevision')) {
    return;
  }
  $revision = $storage->loadRevision($revisionId);
  if (!$revision instanceof EventSeries && !$revision instanceof EventInstance) {
    return;
  }

  if ($revision instanceof EventSeries) {
    $constraint = new EventSeriesRescheduleBlockConstraint();
    $validator = EventSeriesRescheduleBlockConstraintValidator::create(\Drupal::getContainer());
    foreach ($validator->checkViolations($revision, $constraint) as $message) {
      $form_state->setErrorByName('', $message);
    }
  }
  else {
    $validator = EventInstancePublishGuardConstraintValidator::create(\Drupal::getContainer());
    if ($validator->checkViolation($revision)) {
      $constraint = new EventInstancePublishGuardConstraint();
      $form_state->setErrorByName('', $constraint->message);
    }
  }
}

/**
 * Returns default email body templates for event registration emails.
 *
 * @return array
 *   Keyed by 'registration', 'approval', 'post_survey'.
 */
function _access_events_email_templates() {
  return [
    'registration' => '<p>Dear {{ name }},</p>
<p>Thank you for registering for <strong>{{ title_link }}</strong> scheduled for {{ start_date }}. Your registration has been submitted and is under review.</p>
<p>You will receive another email once your registration has been reviewed and approved. Approval typically takes 1-2 business days.</p>
{% if screen_survey_url %}<p><a href="{{ screen_survey_url }}">{{ screen_survey_url }}</a></p>{% endif %}
<p>____<br>This message is sent through the ACCESS-CI event registration system.</p>',

    'approval' => '<p>Dear {{ name }},</p>
<p>Congratulations! Your registration for <strong>{{ title_link }}</strong> on {{ start_date }} has been confirmed.</p>
<p>Here are the details:</p>
<ul><li><strong>Location (if applicable):</strong> {{ location }}</li>
<li><strong>Time:</strong> {{ event_start_time }} - {{ event_end_time }}</li></ul>
{% if pre_survey_url %}<p><a href="{{ pre_survey_url }}">{{ pre_survey_url }}</a></p>{% endif %}
<p>We are glad you are going to attend!</p>
<p>____<br>This message is sent through the ACCESS-CI event registration system.</p>',

    'post_survey' => '<p>Dear {{ name }},</p>
<p>Thank you for participating in <strong>{{ title }}</strong>. We\'d appreciate it if you participated in our survey.</p>
{% if post_survey_url %}<p><a href="{{ post_survey_url }}">{{ post_survey_url }}</a></p>{% endif %}
<p>____<br>This message is sent through the ACCESS-CI event registration system.</p>',
  ];
}

/**
 * Render an email body template with Twig variables.
 *
 * @param string $template_text
 *   The Twig template string (HTML with {{ tokens }}).
 * @param array $variables
 *   Variables to pass to the template.
 *
 * @return string
 *   The rendered HTML.
 */
function _access_events_render_email_template($template_text, array $variables) {
  if (empty($template_text)) {
    return '';
  }
  try {
    $twig = \Drupal::service('twig');
    $template = $twig->createTemplate($template_text);
    return $template->render($variables);
  }
  catch (\Exception $e) {
    \Drupal::logger('access_events')->error('Failed to render email template: @error', ['@error' => $e->getMessage()]);
    return $template_text;
  }
}


/**
 * Implements hook_entity_base_field_info().
 */
function access_events_entity_base_field_info(EntityTypeInterface $entity_type) {
  if ($entity_type->id() !== 'eventinstance') {
    return [];
  }
  $fields['individually_cancelled'] = \Drupal\Core\Field\BaseFieldDefinition::create('boolean')
    ->setLabel(t('Individually cancelled'))
    ->setDescription(t('This occurrence was cancelled on purpose, independent of the series. It stays archived when the series is restored.'))
    ->setDefaultValue(0)
    ->setRevisionable(FALSE)
    ->setDisplayConfigurable('form', FALSE)
    ->setDisplayConfigurable('view', FALSE);
  return $fields;
}

/**
 * Implements hook_entity_base_field_info_alter().
 */
function access_events_entity_base_field_info_alter(&$fields, EntityTypeInterface $entity_type) {
  if ($entity_type->id() === 'eventseries' && isset($fields['event_registration'])) {
    $fields['event_registration']->setDescription('');
  }
}

/**
 * Implements hook_entity_type_alter().
 */
function access_events_entity_type_alter(array &$entity_types) {
  // Blocks a recurrence/date change on an eventseries that still has future
  // registrants — recurring_events rebuilds ALL instances on such a change,
  // hard-deleting the existing instances and their registrants.
  $entity_types['eventseries']->addConstraint('EventSeriesRescheduleBlock');

  // Blocks publishing an occurrence while its parent series is not
  // published. Mirrors the presave throw in
  // EventStateReactions::instancePresave() for save paths that run
  // validate() (editor forms, the CRUD API).
  $entity_types['eventinstance']->addConstraint('EventInstancePublishGuard');
}

/**
 * Recursively replace conditions on multi-value JOIN aliases with EXISTS subqueries.
 *
 * Walks the condition tree. When a condition references a multi-value table
 * alias (e.g., "t_2.value = 'foo'"), it replaces it with an EXISTS subquery
 * on the db_query and removes the original condition.
 *
 * @param array &$conditions
 *   The conditions array (by reference) from a ConditionInterface.
 * @param array $alias_to_table
 *   Map of alias => table name for multi-value tables.
 * @param \Drupal\Core\Database\Query\SelectInterface $db_query
 *   The main DB query (EXISTS subqueries are added here).
 */
function access_events_replace_mv_conditions(array &$conditions, array $alias_to_table, \Drupal\Core\Database\Query\SelectInterface $db_query) {
  $keys_to_remove = [];

  foreach ($conditions as $key => &$condition) {
    if ($key === '#conjunction') {
      continue;
    }
    if (!is_array($condition)) {
      continue;
    }

    $field = $condition['field'] ?? NULL;

    // Recurse into nested condition groups.
    if ($field instanceof \Drupal\Core\Database\Query\ConditionInterface) {
      $nested = &$field->conditions();
      access_events_replace_mv_conditions($nested, $alias_to_table, $db_query);
      continue;
    }

    // Check if this condition references a multi-value alias.
    if (!is_string($field)) {
      continue;
    }
    foreach ($alias_to_table as $alias => $table_name) {
      if (strpos($field, $alias . '.') === 0) {
        // Add EXISTS subquery to the main query.
        $subquery = \Drupal::database()->select($table_name, 'mv');
        $subquery->addExpression('1');
        $subquery->where('mv.item_id = t.item_id');
        $subquery->condition('mv.value', $condition['value'], $condition['operator']);
        $db_query->exists($subquery);

        // Mark for removal.
        $keys_to_remove[] = $key;
        break;
      }
    }
  }

  // Remove replaced conditions.
  foreach ($keys_to_remove as $key) {
    unset($conditions[$key]);
  }
}

/**
 * Implements hook_views_data_alter().
 *
 * Use a plain-text handler for event_summary so the events REST API returns
 * decoded text rather than HTML-escaped values.
 */
function access_events_views_data_alter(array &$data) {
  $table = 'search_api_datasource_events_entity_eventinstance';
  if (isset($data[$table]['event_summary']['field']['id']) && $data[$table]['event_summary']['field']['id'] === 'search_api') {
    $data[$table]['event_summary']['field']['id'] = 'access_events_search_api_plain_text';
  }
}
