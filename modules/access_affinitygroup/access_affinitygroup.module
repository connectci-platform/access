<?php

/**
 * @file
 * Module for affinity group.
 *
 * Each affinity group (AG) has a dedicated "List" in Constant Contact, and
 * each user is a Constant Contact (CC) "Contact".
 * We add a user to CC when the user logs in, if they don't already have a
 * constant contact id stored on the user form.
 * When a user Joins or Leaves an AG, we add or remove the user from
 * the corresponding CC list.
 * When an AG is edited or created, we add the list to CC if not already done.
 * Each AG should have a 'list_id' item that was generated by CC.
 * Note: The list in Constant Contact is stored by the AG name, so relationship
 * to CC list is broken if AG name changes.
 *
 * Optional Discussion Group Email list:
 * We create a Simplelists group list and add AG members to that list after
 * creating a Simplelists contact; same when user joins an AG.
 *
 * Code in this module also implements the following:
 *  - Coordinators for Affinity Groups have their
 *    "Affinity Group Leader" role updated
 *  - Whenever an Affinity Group is saved, a taxonomy term with the same
 *    name is created.
 *
 * Note: dependency on title of 'ACCESS Support' Affinity group. Change code if
 * title changes.
 */

use Drupal\access_affinitygroup\Plugin\AllocationsUsersImport;
use Drupal\access_affinitygroup\Plugin\ConstantContactApi;
use Drupal\access_affinitygroup\Plugin\SimpleListsApi;
use Drupal\access_affinitygroup\Plugin\EmailWrapper;
use Drupal\block\Entity\Block;
use Drupal\Component\Utility\Xss;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Url;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\cssn\Plugin\Util\EndUrl;
use Drupal\node\Entity\Node;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\Entity\Term;
use Drupal\user\Entity\User;
use Drupal\user\UserInterface;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\Component\Utility\Html;

/**
 * Filter Affinity Groups for the current domain.
 *
 * @param ViewExecutable $view
 * @param QueryPluginBase $query
 * @return void
 */
function access_affinitygroup_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() === 'affinity_group_search' && $view->current_display === 'page_1') {
    $domain_id = \Drupal::service('access_misc.sitetools')->getDomainId();
    if ($domain_id) {
      $query->addCondition('field_domain_access', $domain_id, '=');
    }
  }
}

/**
 * Implements hook_search_api_query_alter().
 */
function access_affinitygroup_search_api_query_alter(\Drupal\search_api\Query\QueryInterface &$query) {
  // Check if the query is for the affinity_group index.
  if ($query->getIndex()->id() !== 'affinity_groups') {
    return;
  }
  $user = \Drupal::currentUser();
  $user_id = $user->id();
  $roles = $user->getRoles();
  if (in_array('administrator', $roles)) {
    return;
  }
  $condition_group = $query->createConditionGroup('OR');
  $condition_group->addCondition('field_ag_private', FALSE);
  $condition_group->addCondition('field_coordinator', $user_id);
  $condition_group->addCondition('field_ag_private_users', $user_id);
  $query->addConditionGroup($condition_group);
}

/**
 * Implements hook_preprocess_views_view_field().
 */
function access_affinitygroup_preprocess_views_view_field(&$variables) {
  $view = $variables['view'];

  $field = $variables['field'];
  // Override view /admin/structure/views/view/affinity_group_search ID to show Join flag.
  // Details output on CI links search on /affinity_group page.
  if ($view->id() == 'affinity_group_search' && ($view->current_display == 'page_1' && $field->options['id'] == 'nid')) {
    $nid = $variables['output']->__toString();
    // Load Entity node from $nid.
    $node = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
    $tid = $node->get('field_affinity_group')->getValue();
    $tid = $tid[0]['target_id'];

    $flag_ag = \Drupal::service('flag.link_builder')->build('taxonomy_term', $tid, 'affinity_group', 'full');
    $flag_ag['#attributes']['class'][] = 'btn-sm btn-small btn-secondary-outline py-0 px-4';
    $flag_ag = \Drupal::service('renderer')->renderPlain($flag_ag);

    // Attach a custom cache tag to the output.
    $variables['#cache']['tags'][] = 'affinity_group_field_' . $tid;

    $current_user = \Drupal::currentUser();
    if ($current_user->isAnonymous()) {
      $output['string'] = [
        '#type' => 'inline_template',
        '#template' => '<a href="{{ link_url }}" class="btn btn-sm btn-small btn-secondary-outline btn-md-teal py-0 px-4" title="{{ title }}"><small>{{ button_text }}</small></a>',
        '#context' => [
          'link_url' => '/user/login?destination=/affinity-groups',
          'title' => t('Login to join'),
          'button_text' => t('Join'),
        ],
      ];
      $variables['output'] = $output;
    } else {
      $variables['output'] = $flag_ag;
    }
  }
}

/**
 * Implements hook_block_access().
 * Hide views_block__affinity_group_block_7 block programmatically.
 */
function access_affinitygroup_block_access(Block $block, $operation, AccountInterface $account) {
  if ($block->getPluginId() == 'views_block:affinity_group-block_7' || $block->getPluginId() == 'affinity_contact_group') {
    // Load entity node from current node.
    $node = \Drupal::routeMatch()->getParameter('node');
    if ($node instanceof NodeInterface) {
      $type = $node->getType();
      if ($type == 'affinity_group') {
        $coordinators = $node->get('field_coordinator')->getValue();
        $current_user = \Drupal::currentUser();
        $uid = $current_user->id();
        $roles = $current_user->getRoles();
        $hide_block = TRUE;
        // Show block to coordinators.
        foreach ($coordinators as $coordinator) {
          if (array_key_exists('target_id', $coordinator) && $coordinator['target_id'] == $uid) {
            $hide_block = FALSE;
          }
        }
        // Show block to administrators.
        if (in_array('administrator', $roles)) {
          $hide_block = FALSE;
        }
        if ($hide_block) {
          return AccessResult::forbidden();
        }
      }
    }
  }
}

/**
 * Implements hook_entity_view().
 */
function access_affinitygroup_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  $type = $entity->bundle();
  if ($type == 'affinity_group') {
    $build['#attached']['library'][] = 'access_affinitygroup/extra_styles';
  }
}

/**
 * Implements hook_entity_presave().
 * Handles type=infrastructure_news or affinity_group.
 * For affinity_group:
 *  Handles either
 *  case 1) User clicked Join flag on Affinity Group:
 *    We call api to add user to corresponding email list.
 *
 *   Join and Leave AG are implemented using a drupal Flag. Each AG
 *   has a corresponding flag that can be set per-user, signifying
 *   whether the user belongs to the AG.
 *
 *  case 2) Admin user saved Affinity Group form:
 *    If the AG does not already have a list_id from CC,
 *    we call api to create the email list,
 *    update AG Leader roles for added or removed coordinators,
 *    Ensure every Affinity Group name has a corresponding taxonomy term.
 */
function access_affinitygroup_entity_presave(EntityInterface $entity) {

  $type = $entity->bundle();
  if ($type == 'affinity_group') {

    if (method_exists($entity, 'getFlaggableType')) {

      // Case 1: User did Join the AG (using the Join button or link)
      // The flag sits on a taxonomy; the taxonomy id is used to find the AG node
      // which we need to build the JSON to send to api.
      $taxonomyId = $entity->get('entity_id')->getValue()[0]['value'];
      $currentUser = \Drupal::currentUser();
      $userId = $currentUser->id();

      // Need to exit if we are here during the allocations import processing,
      // which can either be run via cron or from admin setting it off on the
      // constant contact admin form.
      if ($userId === 1 || $userId === 0) {
        return;
      }
      $userDetails = User::load($userId);
      subscribeToSimpleLists($taxonomyId, $userDetails, TRUE);
      subscribeToCCList($taxonomyId, $userDetails);

      // If present, remove this AG from this user's block list.
      removeBlockedAG($taxonomyId, $userDetails);
    } else {
      // Case 2: Affinity group edit was saved by admin user.
      // slug is a required field.
      $x = $entity->get('field_group_slug')->getValue()[0]['value'];
      $entity->set('field_group_slug', strtolower(trim($x)));

      update_ag_leader_roles($entity);
      add_ag_taxonomy_term($entity);

      check_ext_email_list($entity);

      // Add list to Constant Contact if this has not already been done.
      // The list_id field will be set with Constant Contact's Id for this list.
      if (!isCCEnabled()) {
        showStatus("Constant Contact interface has been disabled.");
        return;
      }

      // Get all existing CC lists.
      $cca = new ConstantContactApi();
      $lists = $cca->apiCall('/contact_lists');
      if (empty($lists)) {
        return;
      }

      // Debug info: here you can see all lists CC knows about along with their List IDs
      // kint($lists);
      // look for this AG in the list of CC lists (title== listname)
      $title = $entity->getTitle();
      $list_exists = FALSE;
      foreach ($lists->lists as $list) {
        if ($list->name == $title) {
          $list_exists = TRUE;
          break;
        }
      }
      // We didn't find an email list id for this AG - make it now.
      if (!$list_exists) {
        $get_fields = $entity->getFields();
        $summary = $get_fields['body']->summary;
        // Api max is 255 characters.
        $summary = (strlen($summary) > 255) ? substr($summary, 0, 255) : $summary;
        $post_data = [
          'name' => $title,
          'favorite' => 0,
          'description' => $summary,
        ];
        $post_data = json_encode($post_data);

        // Create Constant contact list named with AG title.
        $created_list = $cca->apiCall('/contact_lists', $post_data, 'POST');

        if (!empty($created_list)) {
          $list_id = $created_list->list_id ? Xss::filter($created_list->list_id) : '';
        }

        if (!empty($list_id)) {
          $entity->set('field_list_id', $list_id);
        } else {
          showStatus('Bad list id received from Constant Contact.');
        }
      }
    }
  }
}

/**
 * Implements hook_views_pre_view() for node templates.
 */
function access_affinitygroup_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  if ($view->id() == 'affinity_groups_with_tag' && $view->getDisplay()->view->element['#display_id'] == 'block_2') {
    $view_filters = $view->display_handler->getOption('filters');
    $domain = \Drupal::service('access_misc.sitetools')->getDomainId();

    $view_filters['field_domain_access_target_id']['value'] = [
      $domain => $domain
    ];

    $view->display_handler->setOption('filters', $view_filters);
  }
}

/**
 * Implements hook_views_pre_render().
 *
 * Used in this case to add the CiDeR resource titles & descriptions to the view.
 *
 * The affinity group view has a custom text field that drupal labeled
 * 'nothing' -- this function updates that field with html listing any associated
 * CiDeR resources, both their title & description.
 */
function access_affinitygroup_views_pre_render(ViewExecutable $view) {

  if ($view->id() == 'affinity_group_search') {
    $view->element['#attached']['library'][] = 'access_affinitygroup/ag_view';
  }

  if ($view->id() == 'affinity_group_members') {
    // Afinity group user list change title to match AG title.
    $url = new EndUrl();
    if ($view->current_display == 'page_1') {
      $url_end = $url->getUrlEnd();
      $url_end = urldecode($url_end);
      $view->setTitle($url_end);
    }
    if ($view->current_display == 'data_export_1') {
      $url_penultimate = $url->getUrlArg('4');
      if ($url_penultimate) {
        $url_penultimate = urldecode($url_penultimate);
        $url_penultimate = str_replace(' ', '_', $url_penultimate);
        $view->setTitle($url_penultimate);
      }
    }
  }
  if ($view->id() == 'affinity_group' && $view->current_display == 'group') {

    foreach ($view->result as $value) {

      $cider_ids = $value->_entity->get('field_cider_resources')->getValue();
      $node_storage = \Drupal::entityTypeManager()->getStorage('node');
      $cider_text = '';

      foreach ($cider_ids as $cider_id) {
        if (array_key_exists('target_id', $cider_id)) {
          $node = $node_storage->load($cider_id['target_id']);
          $cider_text .= '<h3>' . $node->get('title')->value . '</h3><p>'
            . $node->get('body')->value . '</p>';
        }
      }

      foreach ($view->field as $id => $field) {
        if ($id == 'nothing') {
          $field->options['alter']['text'] = $cider_text;
        }
      }
    }
  }
}

/**
 * - update AG Leader roles for added or removed coordinators.
 */
function update_ag_leader_roles($entity) {
  // Get all coordinators for this AG.
  $coordinators = $entity->get('field_coordinator')->getValue();

  // Add 'affinity_group_leader' role to all coordinators.
  $coordinator_ids = [];
  foreach ($coordinators as $coordinator) {
    $coordinator_id = $coordinator['target_id'];
    $coordinator_ids[] = $coordinator_id;
    $user = User::load($coordinator_id);
    if (!$user) {
      continue;
    }
    $user->addRole('affinity_group_leader');
    $user->save();
  }

  // If removing a coordinator, remove the leader role (if not a leader anywhere else)
  update_removed_ag_leader_roles($entity, $coordinator_ids);
}

/**
 *
 */
function update_removed_ag_leader_roles($entity, $coordinator_ids) {
  // Get the original list of coordinators.
  $original_coordinators = $entity->original
    ? $entity->original->get('field_coordinator')->getValue()
    : NULL;

  // Build an array of all removed coordinators.
  $removed_coordinator_ids = [];
  if ($original_coordinators) {
    foreach ($original_coordinators as $original_coordinator) {
      $original_coordinator_id = $original_coordinator['target_id'];
      if (!in_array($original_coordinator_id, $coordinator_ids)) {
        $removed_coordinator_ids[] = $original_coordinator_id;

        // $msg = "user id $original_coordinator_id removed";
        // \Drupal::messenger()->addStatus($msg);
      }
    }
  }

  // If any coordinators removed, possibly remove their leader role.
  if (count($removed_coordinator_ids)) {

    // Get all affinity group coordinators on other affinity groups.
    $storage = \Drupal::service('entity_type.manager')->getStorage('node');
    $all_affinity_groups = $storage->loadByProperties([
      'type' => 'affinity_group',
    ]);

    $all_other_coordinator_ids = [];

    foreach ($all_affinity_groups as $affinity_group) {

      if ($entity->id() == $affinity_group->id()) {
        // \Drupal::messenger()->addStatus('in possibly remove, skipping group id = ' . $entity->id());
        continue;
      }
      $coordinators = $affinity_group->get('field_coordinator')->getValue();
      foreach ($coordinators as $coordinator) {
        $all_other_coordinator_ids[] = $coordinator['target_id'];
      }
    }

    // \Drupal::messenger()->addStatus('all other ag coord ids = ' . print_r($all_other_coordinator_ids, true));
    // \Drupal::messenger()->addStatus('all removed coord ids = ' . print_r($removed_coordinator_ids, true));
    // Foreach removed coordinator,
    //    if not a coordinator on any other affinity group,
    //       remove the leader role.
    foreach ($removed_coordinator_ids as $removed_coordinator_id) {
      $user = User::load($removed_coordinator_id);
      if ($user) {
        if (!in_array($removed_coordinator_id, $all_other_coordinator_ids)) {
          $user->removeRole('affinity_group_leader');
          $user->save();
          \Drupal::messenger()->addStatus('Removed Affinity Group Leader role for ' . $user->getAccountName());
        } else {
          \Drupal::messenger()->addStatus('Not removing Affinity Group Leader role for ' . $user->getAccountName()
            . ' because coordinator for another Affinity Group');
        }
      }
    }
  }
}

/**
 *
 */
function add_ag_taxonomy_term($entity) {
  $ag_title = $entity->getTitle();
  $exists = !empty(ag_taxonomy_lookup($ag_title));
  $tid = NULL;
  if ($exists) {
    $tid = array_keys(ag_taxonomy_lookup($ag_title))[0];
  } else {
    $tid = create_ag_taxonomy_term($ag_title);
  }

  // Set entity's field_affinity_group to new term.
  $entity->set('field_affinity_group', $tid);
}

/**
 * SubscribeToSimpleLists.
 * If "external email" (discussion email list) is in use,
 * Add user to SimpleLists email list associated
 * with the Affinity Group for which this taxonomyId is flaged by the user.
 * (the user hit the Join button on  the AG page.)
 * Audeience for errors is end user; errors also logged.
 *
 * @param int $flagEntityId
 *   The taxonomy term ID for the affinity group.
 * @param \Drupal\user\Entity\User $user
 *   The loaded user entity.
 * @param bool $isSubscribe
 *   TRUE to subscribe, FALSE to unsubscribe.
 *
 * @return void
 *   Error display handled within.
 */
function subscribeToSimpleLists($flagEntityId, $user, $isSubscribe) {
  // Get the ag for this flag (that the user joined)
  $query = \Drupal::entityQuery('node');
  $node_ids = $query
    ->condition('field_affinity_group', $flagEntityId)
    ->accessCheck(FALSE)
    ->execute();
  $aval = array_values($node_ids);
  if (empty($aval)) {
    \Drupal::logger('access_affinitygroup')->error('No Affinity Group found for flag id @flagEntityId', [
      '@flagEntityId' => $flagEntityId
    ]);
    return;
  }
  $nid = $aval[0];
  $ag = Node::load($nid);

  if ($ag == NULL) {
    return;
  }

  if (!$ag->get('field_use_ext_email_list')->getValue()[0]['value']) {
    \Drupal::logger('access_affinitygroup')->info('Affinity group @title (flag id @flagEntityId) does not have external email lists enabled. Skipping email list subscription.', [
      '@title' => $ag->getTitle(),
      '@flagEntityId' => $flagEntityId
    ]);
    return;
  }

  $simpleListsName = "";
  if ($ag->hasField('field_ext_email_list')) {
    $simpleListsNameA = $ag->get('field_ext_email_list')->getValue();
    if (!empty($simpleListsNameA)) {
      $simpleListsName = $simpleListsNameA[0]['value'];
    }
  }
  if (!empty($simpleListsName)) {
    $msg = "";
    $simpleListsApi = new SimpleListsApi();

    // Subscribe user to simplist list, creating simplist contact first if needed.
    if ($isSubscribe) {
      $msg = "";
      // Check if contact exists in simplelist account, if not, then create. If so, add to list if needed.
      $simpleListsId = $simpleListsApi->getUserListNames($user->getEmail(), $listMemberships, $msg);
      if (empty($simpleListsId)) {
        // New contact, including list membership.
        $userDet = User::load($user->id());
        $simpleListsId = $simpleListsApi->addUser(
          $user->id(),
          $user->getEmail(),
          $userDet->get('field_user_first_name')->getString(),
          $userDet->get('field_user_last_name')->getString(),
          strtok($simpleListsName, '@'),
          $msg
        );
        $listMemberships = '';
        if (empty($simpleListsId)) {
          $s = "SimpleLists email list: error while adding user to SimpleLists account. " . $msg;
          \Drupal::logger('access_affinitygroup')->error($s);
          return;
        }
      } else {
        // We had an existing contact.
        if (in_array($simpleListsName, $listMemberships)) {
          return;
        } else {
          // Add the existing contact to list.
          $status = $simpleListsApi->updateUserToList($simpleListsId, strtok($simpleListsName, '@'), $msg);
          if (!$status) {
            \Drupal::logger('access_affinitygroup')->error("SimpleLists external email list: error while adding to $simpleListsName " . $msg);
            return;
          }
        }
      }
      \Drupal::logger('access_affinitygroup')->info("Simplelists $simpleListsName added " . $user->getEmail() . "-" . $user->id() . " to:  . $simpleListsName");
    } else {
      // Remove contact from the list.
      $status = $simpleListsApi->removeUserFromList($user->getEmail(), strtok($simpleListsName, '@'), $msg);
      if (!$status) {
        $s = "Simplelists external email: error while removing from $simpleListsName (" . $user->getEmail() . ")" . $msg;
        \Drupal::logger('access_affinitygroup')->error($s);
        // Removal fail silently, but do log.
      }
    }
  }
}

/**
 * When an Affinity Group admin checks the Discussion emails list box.
 * See if we need to add a simplelists list.
 * If adding a list, add the members of the affinity group to the list.
 * Assume that an empty field_ext_email_list means no list of this name in
 * the simplelists account.
 * Assume this is a website admin that would be seering these messages when
 * they check on the group discussion email box.
 */
function check_ext_email_list($entity) {
  $simpleListsName = "";
  $simpleListsNameA = $entity->get('field_ext_email_list')->getValue();
  if (!empty($simpleListsNameA)) {
    $simpleListsName = $simpleListsNameA[0]['value'];
  }

  if ($entity->get('field_use_ext_email_list')->getValue()[0]['value']) {
    // Create the list if not already there. Nonempty field signifies list created.
    // Use the slug field to name the list.
    if ($simpleListsName === "") {
      try {
        $simpleListsApi = new SimpleListsApi();

        $slugA = $entity->get('field_group_slug')->getValue();
        if (!empty($slugA)) {
          $slug = $slugA[0]['value'];
        }
        if (empty($slug)) {
          showStatus("Simplelists email list not created. Please add a Short Name that can be used in an email address.");
          return;
        }
        $listAddress = $simpleListsApi->makeListAddress($slug);

        // Msg + status returned. Here, slug is set to normalized name.
        $status = $simpleListsApi->createList($slug, $entity->getTitle(), $msg);
        showStatus('New simpleLists email list: ' . $msg . ' ' . $listAddress);

        if ($status) {
          $entity->set('field_ext_email_list', $listAddress);

          // Take the list of flagged members and add to the new simplelists.
          $term = $entity->get('field_affinity_group');
          $agMembers = \Drupal::service('flag')->getFlaggingUsers($term->entity);

          if (count($agMembers) > 0) {
            $listAddCount = 0;
            $newCount = 0;
            $index = 0;
            foreach ($agMembers as $oneMember) {
              try {
                $index++;
                $msg = '';
                // Check if contact exists in simplelist account, if not, then create. If so, add to list if needed.
                $simpleListsId = $simpleListsApi->getUserListNames($oneMember->getEmail(), $listMemberships, $msg);
                if (empty($simpleListsId)) {
                  // Need new contact; add with list membership.
                  $userDet = User::load($oneMember->id());
                  $simpleListsId = $simpleListsApi->addUser(
                    $oneMember->id(),
                    $oneMember->getEmail(),
                    $userDet->get('field_user_first_name')->getString(),
                    $userDet->get('field_user_last_name')->getString(),
                    $slug,
                    $msg
                  );
                  $listMemberships = '';
                  if (empty($simpleListsId)) {
                    showStatus("SimpleLists error adding contact at $index; uid: " . $oneMember->id() . " " . $msg);
                  } else {
                    $newCount++;
                    $listAddCount++;
                  }
                } else {
                  // Add the existing contact to list.
                  $status = $simpleListsApi->updateUserToList($simpleListsId, $slug, $msg);
                  if (!$status) {
                    showStatus("SimpleLists: error adding contact to $slug " . $msg);
                  } else {
                    $listAddCount++;
                  }
                }
              } catch (Exception $e) {
                showstatus("SimpleLists: exception for $slug at index $index uid " . $oneMember->id() . $msg);
                break;
              }
            } // foreach
          }
          // Everything ok after list create and contact adds.
          showStatus("Simplelists: $newCount new contacts;  $listAddCount added to $listAddress.");
        }
      } catch (Exception $e) {
        showStatus("Simplelists: Exception creating $listAddress " . $e->getMessage());
      }
    }
  } else {
    // Unchecked box: Delete the simplelists external email list if exists.
    $error = TRUE;
    if ($simpleListsName !== "") {
      try {
        $simpleListsApi = new SimpleListsApi();
        $status = $simpleListsApi->deleteList(strtok($simpleListsName, '@'), $msg);
        if ($status) {
          $entity->set('field_ext_email_list', '');
          $error = FALSE;
          showStatus("Simplelists email list $simpleListsName deleted.");
        }
      } catch (Exception $e) {
        $msg = $e->getMessage();
      }
      if ($error) {
        showStatus("Simplelists email list: Error while deleting $simpleListsName " . $msg);
      }
    }
  }
}

/**
 *
 */
function ag_taxonomy_lookup($ag_title) {
  $lookup = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['name' => $ag_title, 'vid' => 'affinity_groups']);
  return $lookup;
}

/**
 *
 */
function create_ag_taxonomy_term($ag_title) {
  $term = Term::create([
    'vid' => 'affinity_groups',
    'name' => $ag_title,
  ]);
  $term->save();
  return $term->tid->value;
}

/**
 * Call CC API to add user to the email list corresponding to the entityId.
 */
function subscribeToCCList($taxonomyId, $userDetails) {
  if (!isCCEnabled()) {
    showStatus("Can't add user to email list; Constant Contact interface has been disabled.");
    return;
  }

  $postJSON = makeListMembershipJSON($taxonomyId, $userDetails);
  if (empty($postJSON)) {
    showStatus("Can't add user to email list; check if user is missing Constant Contact ID.");
  } else {
    $cca = new ConstantContactApi();
    $ccResponse = $cca->apiCall('/activities/add_list_memberships', $postJSON, 'POST');
  }
}

/**
 * Implements hook_entity_delete().
 * * Handles either
 *   Case 1) User did Leave on Affinity Group
 *    Remove user from the email list.
 *   Case 2) Admin deleted Affinity Group
 *    Delete the corresponding CC email list.
 *
 * See notes above on presave for Join flag for Leave.
 */
function access_affinitygroup_entity_delete(EntityInterface $entity) {
  $type = $entity->bundle();
  if ($type == 'affinity_group') {

    if (method_exists($entity, 'getFlaggableType')) {

      // Case 1: User did Leave AG. This flag is related to a taxonomy; the taxonomy
      // id is used to find the AG node related to the taxonomy and then the CC
      // list_id within the node for json to send to api.
      $taxonomyId = $entity->get('entity_id')->getValue()[0]['value'];
      if (empty($taxonomyId)) {
        return;
      }

      $currentUser = \Drupal::currentUser();
      $userId = $currentUser->id();
      $userDetails = User::load($userId);

      subscribeTosimpleLists($taxonomyId, $userDetails, FALSE);

      $postJSON = makeListMembershipJSON($taxonomyId, $userDetails);
      if (!empty($postJSON) && isCCEnabled()) {
        $cca = new ConstantContactApi();
        $ccResponse = $cca->apiCall('/activities/remove_list_memberships', $postJSON, 'POST');
      }
      // Put this AG on this user's block list if not already there.
      addBlockedAG($taxonomyId, $userDetails);
    } else {
      // Case 2: AG getting deleted. Remove simplelists & constant contact lists.
      $simpleListsName = "";
      $simpleListsNameA = $entity->get('field_ext_email_list')->getValue();
      if (!empty($simpleListsNameA)) {
        $simpleListsName = $simpleListsNameA[0]['value'];
      }
      if ($simpleListsName !== "") {
        $simpleListsApi = new SimpleListsApi();
        $simpleListsApi->deleteList(strtok($simpleListsName, '@'), $msg);
        showStatus("Deleted Simplelists: " . $simpleListsName);
      }

      if (!isCCEnabled()) {
        return;
      }
      $title = $entity->getTitle();
      $cca = new ConstantContactApi();
      $lists = $cca->apiCall('/contact_lists');
      $list_exists = FALSE;
      foreach ($lists->lists as $list) {
        if ($list->name == $title) {
          // Constant Contact contains affinity group
          // title in list.
          $list_id = $list->list_id;
          break;
        }
      }

      if (isset($list_id)) {
        $post_data = [
          'list_id' => $list_id,
        ];
        $post_data = json_encode($post_data);
        $cca->apiCall("/contact_lists/$list_id", $list_id, 'DELETE');
      }
    }
  }
}

/**
 * User is leaving an ag; add to, if not already on, blocked list.
 */
function addBlockedAG($agTaxonomyId, $userDetails) {
  $userBlockedAgTids = [];
  $userBlockedArray = $userDetails->get('field_blocked_ag_tax')->getValue();
  foreach ($userBlockedArray as $userBlock) {
    $userBlockedAgTids[] = $userBlock['target_id'];
  }

  if (!in_array($agTaxonomyId, $userBlockedAgTids)) {
    $userDetails->get('field_blocked_ag_tax')->appendItem($agTaxonomyId);
    $userDetails->save();
  }
}

/**
 * User is joining an ag; remove if on the blocked list.
 */
function removeBlockedAG($agTaxonomyId, $userDetails) {
  $userBlockedTaxIds = [];
  // Make list minus the newly joined ag.
  $userBlockedArray = $userDetails->get('field_blocked_ag_tax')->getValue();
  $wasBlocked = FALSE;
  foreach ($userBlockedArray as $userBlock) {
    if (isset($userBlock['target_id'])) {
      if ($userBlock['target_id'] !== $agTaxonomyId) {
        $userBlockedTaxIds[] = $userBlock['target_id'];
      } else {
        $wasBlocked = TRUE;
      }
    }
  }

  // Update the user with fresh block list only if ag was on block list.
  if ($wasBlocked) {
    $userDetails->set('field_blocked_ag_tax', $userBlockedTaxIds);
    $userDetails->save();
  }
}

/**
 * Prepares json for api call that for adds or deletes CC user from
 * a CC list.  The json contains 2 CC ids: the user (contact) and the
 * list id.
 * Called from code where we have the entity id of the Join/Leave flag
 * corresponding to the Affinity Group. We use this entity id to find the
 * node (AG) containing the CC list id.
 */
function makeListMembershipJSON($flagEntityId, $userDetails) {
  $ccIdField = $userDetails->get('field_constant_contact_id')->getValue();
  if (!empty($ccIdField)) {
    $user_cc_id = $ccIdField[0]['value'];
    $constantcontactapi = new ConstantContactApi();
    $user_cc_id = $constantcontactapi->getUserCcId($user_cc_id);
  }

  if (empty($user_cc_id)) {
    return NULL;
  }

  // Find the AG node that stores the entity Id of the flag; that
  // is the one and only AG that corresponds to this flag.
  $query = \Drupal::entityQuery('node');
  $node_ids = $query
    ->condition('field_affinity_group', $flagEntityId)
    ->accessCheck(FALSE)
    ->execute();

  $aval = array_values($node_ids);
  if (empty($aval)) {
    \Drupal::logger('cron_affinitygroup')->warning('No affinity group node found with field_affinity_group referencing taxonomy term ' . $flagEntityId . '. Cannot process Constant Contact membership.');
    return NULL;
  }
  $nid = $aval[0];

  $ag = Node::load($nid);

  // Finally we can get out the CC list id stored in the AG node.
  $fieldVal = $ag->get('field_list_id')->getValue();
  if (!empty($fieldVal)) {
    $list_cc_id = $fieldVal[0]['value'];
  }

  if (empty($list_cc_id)) {
    \Drupal::logger('cron_affinitygroup')->notice('Missing Constant Contact List Id for Affinity Group.');
    return NULL;
  }

  $post_data = [
    'source' => [
      'contact_ids' => [$user_cc_id],
    ],
    'list_ids' => [$list_cc_id],
  ];
  $post_data = json_encode($post_data);
  return $post_data;
}

/**
 * Implements hook_user_login().
 * Add user to Constant Contact if we don't have a CC ID stored yet.
 */
function access_affinitygroup_user_login(UserInterface $account) {
  $current_user = \Drupal::currentUser();

  $user_id = $current_user->id();
  $user_detail = User::load($user_id);

  $cca_user_id = NULL;
  $field_val = $user_detail->get('field_constant_contact_id')->getValue();
  if (!empty($field_val)) {
    $cca_user_id = $field_val[0]['value'];
  }

  // If user did not already have the CC id, try to add to CC.
  if (empty($cca_user_id) || !json_validate($cca_user_id)) {
      $user_cc_id = [
        'test' => '',
        'openondemand' => '',
        'support' => '',
      ];

    $constantcontactapi = new ConstantContactApi();
    $env = $constantcontactapi->getEnvironment();

    $firstName = $user_detail->get('field_user_first_name')->getString();
    $lastName = $user_detail->get('field_user_last_name')->getString();


    $user_cc_id[$env] = addUserToConstantContact($current_user->getEmail(), $firstName, $lastName);

    if (empty($user_cc_id[$env])) {
      showStatus("Could not add user to Constant Contact.");
    } else {
      $user_cc_id = json_encode($user_cc_id);
      $user_detail->set('field_constant_contact_id', $user_cc_id);
      $user_detail->save();
    }
  } else {
    $constantcontactapi = new ConstantContactApi();
    $env = $constantcontactapi->getEnvironment();
    $user_cc_id = $user_detail->get('field_constant_contact_id')->getString();
    $user_cc_id = json_decode($user_cc_id, TRUE);

    if (empty($user_cc_id[$env])) {
      $user_cc_id[$env] = addUserToConstantContact($current_user->getEmail(), $firstName, $lastName);
      // Flatten if Array for $user_cc_id[$env]
      $user_cc_id[$env] = is_array($user_cc_id[$env]) ? implode(',', $user_cc_id[$env]) : $user_cc_id[$env];
      if (empty($user_cc_id[$env])) {
        showStatus("Could not add user to Constant Contact.");
      } else {
        $user_cc_id = json_encode($user_cc_id);
        $user_detail->set('field_constant_contact_id', $user_cc_id);
        $user_detail->save();
      }
    }

    // This else just for debugging in early stages
    // showStatus("Login and NOT attempting add of new constant contact id.");.
  }
}

/**
 * Implements hook_user_presave().
 * If user's email address changes, tell simplelists email.
 */
function access_affinitygroup_user_presave($uu) {
  if (isset($uu->original) && ($uu->original->getEmail() <> $uu->getEmail())) {
    $msg = "";
    $simpleListsApi = new SimpleListsApi();
    \Drupal::logger('access_affinitygroup')->debug("User email changed: " . $uu->getEmail() . ' from ' . $uu->original->getEmail());
    $status = $simpleListsApi->updateUserEmailAddress($uu->original->getEmail(), $uu->getEmail(), $msg);

    // email not found in simplelists account.
    if (!isset($status)) {
      return;
    }

    // User is a contact in simplelists. Change email address.
    $displayMsg =  $uu->getEmail() . ' from ' . $uu->original->getEmail() . ' (' . $uu->id() . ')';
    if ($status) {
      $displayMsg = "SimpleLists email changed.  $displayMsg";
      \Drupal::logger('access_affinitygroup')->debug($displayMsg);
    } else {
      $displayMsg = "SimpleLists error: $msg. $displayMsg";
      \Drupal::logger('access_affinitygroup')->error($displayMsg);
      showStatus($displayMsg);
    }
  }
}
/**
 * Add user to the Constant Contact account.
 * If user is already in the account, the existing ID will be returned here.
 * Return the new ID if successful.
 */
function addUserToConstantContact($userEmail, $firstName, $lastName, $noDisplay = FALSE) {
  if (!isCCEnabled()) {
    if (!$noDisplay) {
      showStatus("Constant Contact interface has been disabled.");
    }
    return;
  }
  $cca = new ConstantContactApi();
  if ($noDisplay) {
    $cca->setSupressErrDisplay(TRUE);
  }
  $ccaUserId = $cca->addContact($firstName, $lastName, $userEmail);
  return $ccaUserId;
}

/**
 *
 */
function showStatus($logmsg) {
  \Drupal::messenger()->addStatus($logmsg);
}

/**
 * Implements hook_cron().
 * Two functions:
 * 1) Refreshes the authorization. If not run, token expires and we'll get
 * 'not authorized' return code from api calls.
 * 2) User Allocations Import
 */
function access_affinitygroup_cron() {
  $email_recruit = FALSE;
  // Check if we should send recruitment emails (once per day)
  $last_recruit_run = \Drupal::state()->get('access_affinitygroup.last_recruit_email', 0);
  $current_time = time();
  $hours_since_last = ($current_time - $last_recruit_run) / 3600;

  // Send if it's been more than 23 hours since last run (or force for testing on non-live)
  $env = getenv('PANTHEON_ENVIRONMENT');
  if ($hours_since_last > 23 || ($env !== 'live' && $hours_since_last > 0.1)) {
    $email_recruit = TRUE;
    \Drupal::state()->set('access_affinitygroup.last_recruit_email', $current_time);
  }

  if ($email_recruit) {
    // Get 'state' taxonomy term IDs for recruiting states.
    $recruiting_term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['name' => 'recruiting']);
    $in_progress_recruiting_term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['name' => 'In Progress and Recruiting']);

    $term_ids = [];
    if ($recruiting_term) {
      $term_ids[] = array_keys($recruiting_term)[0];
    }
    if ($in_progress_recruiting_term) {
      $term_ids[] = array_keys($in_progress_recruiting_term)[0];
    }

    // Get all mentorship nodes currently in recruiting states that are approved and published
    $query = \Drupal::entityQuery('node')
      ->condition('type', 'mentorship_engagement')
      ->condition('field_me_state', $term_ids, 'IN')
      ->condition('field_ccmnet_approved', 1)
      ->condition('status', 1)
      ->accessCheck(FALSE);
    $all_recruiting_nids = $query->execute();

    // Get list of mentorships we've already notified about
    $notified_mentorships = \Drupal::state()->get('access_affinitygroup.notified_mentorships', []);

    // Only include mentorships we haven't notified about yet
    $new_nids = array_diff($all_recruiting_nids, $notified_mentorships);

    if ($new_nids) {
      \Drupal::logger('access_affinitygroup')->info('Found @count NEW mentorship engagements in recruiting states for email notification', ['@count' => count($new_nids)]);

      // Sort mentorships by whether they're looking for mentors or mentees
      $seeking_mentors = [];
      $seeking_mentees = [];

      foreach ($new_nids as $nid) {
        $node = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
        $node_title = $node->getTitle();
        $options = ['absolute' => FALSE];
        $link_build = Url::fromRoute('entity.node.canonical', ['node' => $nid], $options);
        $url = 'https://ccmnet.org' . $link_build->tostring(TRUE)->getGeneratedUrl();
        $link_item = '<li><a href="' . $url . '">' . $node_title . '</a></li>';

        // Check what they're looking for
        $looking_for = $node->get('field_me_looking_for')->getValue();
        if (!empty($looking_for) && $looking_for[0]['value'] === 'mentor') {
          $seeking_mentors[] = $link_item;
        } else {
          $seeking_mentees[] = $link_item;
        }
      }

      $body = "";

      if (!empty($seeking_mentors)) {
        $body .= "<h3>Looking for Mentors:</h3><ul>" . implode('', $seeking_mentors) . "</ul>";
      }

      if (!empty($seeking_mentees)) {
        $body .= "<h3>Looking for Mentees:</h3><ul>" . implode('', $seeking_mentees) . "</ul>";
      }

      // Send email notification
      $title = t('New mentorship engagements are available on the CCMNet portal');
      $node = \Drupal::entityTypeManager()->getStorage('node')->load(5951);
      $ccListIds = [$node->get('field_list_id')->getValue()[0]['value']];
      $agNames = [$node->getTitle()];
      $pubDate = date('m/d/Y');
      $email_link = 'https://ccmnet.org/mentorships?f%5B0%5D=state%3A827&f%5B1%5D=state%3A886';

      emailToAffinityGroups($body, "$title", $pubDate, $agNames, $email_link, $ccListIds, 1, NULL);
      \Drupal::logger('access_affinitygroup')->info('Sent CCMNet recruitment email to affinity group: @group for @count new mentorships', ['@group' => implode(', ', $agNames), '@count' => count($new_nids)]);

      // Update our list of notified mentorships (add the new ones)
      $updated_notified = array_merge($notified_mentorships, $new_nids);
      \Drupal::state()->set('access_affinitygroup.notified_mentorships', $updated_notified);
    }
    else {
      \Drupal::logger('access_affinitygroup')->info('No NEW mentorship engagements found in recruiting states for email notification (total recruiting: @total, already notified: @notified)', [
        '@total' => count($all_recruiting_nids),
        '@notified' => count($notified_mentorships)
      ]);
    }

    // Clean up old notified mentorships that are no longer in recruiting states
    // This prevents the list from growing indefinitely
    $current_notified = \Drupal::state()->get('access_affinitygroup.notified_mentorships', []);
    $still_valid_notified = array_intersect($current_notified, $all_recruiting_nids);
    if (count($still_valid_notified) != count($current_notified)) {
      \Drupal::state()->set('access_affinitygroup.notified_mentorships', $still_valid_notified);
      \Drupal::logger('access_affinitygroup')->info('Cleaned up notified mentorships list: removed @removed items', ['@removed' => count($current_notified) - count($still_valid_notified)]);
    }
  }


  try {

    // 1. Refresh the Constant Contact Token
    if (shouldRun('token')) {

      $currentTime = \Drupal::time()->getCurrentTime();
      \Drupal::state()->set('access_affinitygroup.crontime-t', $currentTime);
      \Drupal::logger('access_affinitygroup')->notice('Cron: token refresh ' . date("Y-m-d H:i:s", $currentTime));

      $support = new ConstantContactApi('support');
      $support->newToken();

      $ood = new ConstantContactApi('openondemand');
      $ood->newToken();
    }

    // 2. call xdusage api to get users and create/update their
    // allocations and associated affinity groups.
    if (shouldRun('users')) {
      $currentTime = \Drupal::time()->getCurrentTime();
      \Drupal::state()->set('access_affinitygroup.crontime-u', $currentTime);
      \Drupal::logger('cron_affinitygroup')->notice('Running cron: alloc imports' . date("Y-m-d H:i:s", $currentTime));

      // Run one slice of the imports; parameters are state variables.
      $aui = new AllocationsUsersImport();
      $aui->runCronSlice();
    }
  } catch (Exception $e) {
    \Drupal::logger('cron_affinitygroup')->notice('exception in cron: ' . $e->getMessage());
  }
}

/**
 * Test if the cron function should run: either 'token' for refresh cc token,
 * or 'users' for running the allocations api.
 */
function shouldRun($function) {

  $currentTime = \Drupal::time()->getCurrentTime();
  if ($function == 'token') {

    if (!isCCEnabled()) {
      return FALSE;
    }

    $lastRun = \Drupal::state()->get('access_affinitygroup.crontime-t', 0);
    $hoursDiff = round(($currentTime - $lastRun) / 3600, 1);

    // Run if it's been at least 6 hours since the last run.
    if ($hoursDiff >= 6) {
      return TRUE;
    }
  } elseif ($function == 'users') {

    if (\Drupal::state()->get('access_affinitygroup.allocCronDisable', FALSE)) {
      return FALSE;
    }

    $lastRun = \Drupal::state()->get('access_affinitygroup.crontime-u', 0);
    $hoursDiff = round(($currentTime - $lastRun) / 3600, 1);
    $hour = date('H', $currentTime);

    $startAt = \Drupal::state()->get('access_affinitygroup.allocCronStartAt', 0);

    // If the start is 0 but we alaready started running alloctions today, we are done.
    if (date('Ymd') === date('Ymd', $lastRun) && $startAt === 0) {
      return FALSE;
    }
    // Only run if the hour is inclusively between 1 and 5 am.
    if ($hour >= 1 && $hour <= 5) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Boolean check if user has a CC Id for the specified environment.
 * If no environment specified, uses current environment.
 */
function needsCCId($u, $environment = NULL) {
  $ccId = NULL;
  $fVal = $u->get('field_constant_contact_id')->getValue();
  if (!empty($fVal)) {
    $ccIdJson = $fVal[0]['value'];
    if (json_validate($ccIdJson)) {
      $ccIdArray = json_decode($ccIdJson, TRUE);
      if ($environment === NULL) {
        $cca = new \Drupal\access_affinitygroup\Plugin\ConstantContactApi();
        $environment = $cca->getEnvironment();
      }
      $ccId = $ccIdArray[$environment] ?? '';
    } else {
      // Handle legacy single CC ID (for backwards compatibility)
      $ccId = $ccIdJson;
    }
  }
  return empty($ccId);
}

/**
 * Default, if the config setting has not been set for some reason, is false.
 */
function isCCEnabled() {
  $config = \Drupal::configFactory()->getEditable('access_affinitygroup.settings');
  $disabled = $config->get('noConstantContactCalls');

  if (isset($disabled)) {
    return !$disabled;
  }
  return FALSE;
}

/**
 * Email emailText to each AG email group in ccListIds array.
 * Subject of email is emailTitle.
 * See makeNewsHTML for meaning of other arguments.
 *
 * Steps to send email campaign from Constant Contact:
 * Setup:
 * - Make a POST request to create an email campaign and campaign activities.
 * - Make a GET request to retrieve the primary_email email campaign activity.
 * Send:
 * - Make a PUT request to update the email campaign activity and add recipients.
 * - Make a POST request to schedule the email campaign activity.
 */

/**
 * EmailText - body of email. This will be wrapped with email html template
 *  emailTitle
 *  pubDate - published date for display in email
 *  agNames - array of affinity group names for broadcast (for display in email)
 *  ccListIds - array of constant contact list ids corresponding to the affinity groups
 *  communityTemplate - which email template to use.
 *             If true, we use community template, otherwise use the ACCESS Support template.
 */
function emailToAffinityGroups($emailText, $emailTitle, $pubDate, $agNames, $newsUrl, $ccListIds, $communityTemplate, $logoUrl) {
  // For CC, must be unique name for campaign.
  $campaignName = uniqid('Community Announcement: ' . $agNames[0] . '- ' . $pubDate . ' ', FALSE);

  // Either use email template for access or community.
  $wrapper = new EmailWrapper();
  if ($communityTemplate) {
    $emailHtml = $wrapper->ccCommunityNewsHTML($emailText, $emailTitle, $pubDate, $agNames, $newsUrl, $logoUrl);
  } else {
    $emailHtml = $wrapper->ccAccessNewsHTML($emailText, $emailTitle, $pubDate, $agNames, $newsUrl);
  }

  $ccResponse = setupEmailCampaign($emailTitle, $emailHtml, $campaignName);

  if (!empty($ccResponse)) {
    $campaignId = $ccResponse->campaign_id;
    $campaignActivityId = $ccResponse->campaign_activities[0]->campaign_activity_id;
    sendEmailCampaign($campaignId, $campaignActivityId, $ccListIds);
  }
}

/**
 * Create the Constant Contact email campaign, which is the initial setup.
 * Nothing is sent at this point. Returns the response which included the
 * campaign id and campaign activity id needed for step leading to send.
 * campaignName must be unique to the cc account.
 * Return: api response, or NULL if constant contact is disabled.
 */
function setupEmailCampaign($emailSubject, $emailHtml, $campaignName) {
  if (!isCCEnabled()) {
    return NULL;
  }

  $cca = new ConstantContactApi();
  $from_name = $cca->getFromName();
  $email = $cca->getEmail();

  $postData = [
    'name' => $campaignName,
    'email_campaign_activities' => [
      [
        'format_type' => 5,
        'from_name' => $from_name,
        'from_email' => $email,
        'reply_to_email' => $email,
        'subject' => $emailSubject,
        'preheader' => $emailSubject,
        'html_content' => $emailHtml,
      ],
    ],
  ];

  // note: could include irl addr in postData if we want to change it, but don't have to
  // as cc uses addr on record for footer address in email.
  $postData = json_encode($postData);
  $cca = new ConstantContactApi();
  $ccResponse = $cca->apiCall('/emails', $postData, 'POST');

  return $ccResponse;
}

/**
 * Take the campaign and campaign activity ids from the campaign setup api call,
 * set up the recipient lists, and finally, schedule for immediate sendoff.
 * ccListIds: array of CC email List Ids, one for each AG
 */
function sendEmailCampaign($campaignId, $campaignActivityId, $ccListIds) {
  if (!isCCEnabled()) {
    showStatus("Constant Contact interface has been disabled.");
    return;
  }
  // first, get the activity object.
  $sent = FALSE;
  $cca = new ConstantContactApi();
  $ccActivity = $cca->apiCall("/emails/activities/$campaignActivityId");

  if (!empty($ccActivity)) {

    // Update activity obj with the destination cc email lists in
    // an array with list_id from each AG group to receive news.
    $ccActivity->contact_list_ids = $ccListIds;

    $ccActivity = json_encode($ccActivity);
    $ccResponse = $cca->apiCall("/emails/activities/$campaignActivityId", $ccActivity, 'PUT');

    if (!empty($ccResponse)) {
      // finally, send it, scheduled with 0 signifying: now.
      $schedule = ['scheduled_date' => '0'];
      $schedule = json_encode($schedule);
      $ccResponse = $cca->apiCall("/emails/activities/$campaignActivityId/schedules", $schedule, 'POST');
      $sent = ($ccResponse != NULL);
    }
  }
  if ($sent) {
    showStatus("Your message was sent to this Affinity Group.");
  } else {
    showStatus("Error while trying to email announcement to affinity group.");
  }
}

/**
 * hook_form_alter.
 *
 * For one of two form types:
 * 1) node_affinity_group_edit_form:
 *  -- Make the associated cider resources field read-only for non-administrator users
 *  -- hide recommended + associated cider resources fields depending on category
 * 2) webform_submission_affinity_group_contact_add_form: sets up form for
 *    sending one email to affinity group.
 */
function access_affinitygroup_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if ($form_id == 'node_affinity_group_edit_form' || $form_id == 'node_affinity_group_form') {
    $form['field_persona_source']['#group'] = 'advanced';

    $form['field_tags_replace'] = [
      '#type' => 'container',
      '#attributes' => [
        'id' => 'field-tags-replace',
        'data-suggest' => '0',
      ],
      '#weight' => 3,
    ];

    $form['field_tags_replace']['field_suggest'] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => [
          'bg-light-teal',
          'my-5',
          'p-5'
        ]
      ],
    ];

    $form['field_tags_replace']['field_suggest']['tag_list'] = [
      '#markup' => "<div id='match-tag-list' class='mb-3'>Get tag suggestions based on your description and then curate as necessary.</div>",
    ];
    $form['field_tags_replace']['field_suggest']['replace_button'] = [
      '#type' => 'button',
      '#value' => t('Suggest Tags'),
      '#limit_validation_errors' => array(),
      '#attributes' => [
        'class' => [
          'ml-0'
        ],
      ],
      '#ajax' => [
        'callback' => 'access_affinitygroup_replace_section_callback',
        'wrapper' => 'field-tags-replace',
      ],
    ];
    $form['field_tags_replace']['user_message'] = [
      '#markup' => "",
    ];

    $add_tags = \Drupal::service('access_misc.addtags');
    $output = $add_tags->getView();

    $form['custom_tags'] = [
      '#markup' => "<div id='tag-suggestions'></div>
                    <details open class='tags'>
                     <summary><label class='js-form-required form-required'>Select relevant tags</label></summary>
                      $output
                    </details>",
      '#weight' => 3,
      '#allowed_tags' => [
        'button',
        'details',
        'summary',
        'label',
        'span',
        'div',
        'h2',
      ],
    ];

    // Attach javascript.
    $form['#attached']['library'][] = 'access_misc/node_add_tags';
    $form['#validate'][] = 'access_affinitygroup_edit_validate';

    $form['#attached']['library'][] = 'access_affinitygroup/ag_node_form';

    $form['actions']['submit']['#submit'][] = 'access_affinitygroup_edit_submit';
  }

  if ($form_id == 'node_affinity_group_form') {
    // Set field_domain_access default to all domains.
    foreach ($form['field_domain_access']['widget']['#options'] as $key => $value) {
      // if key is not an array.
      if (!is_array($value)) {
        $form['field_domain_access']['widget']['#default_value'][] = $key;
      }
    }
  }

  if ($form_id == 'node_affinity_group_edit_form') {

    $current_user = \Drupal::currentUser();
    $roles = $current_user->getRoles();
    if (!in_array('administrator', $roles)) {
      $form['title']['#disabled'] = TRUE;
      $form['field_cider_resources']['#disabled'] = TRUE;
      $form['field_use_ext_email_list']['#disabled'] = TRUE;
      $form['field_group_slug']['#disabled'] = TRUE;
      $form['field_group_id']['#disabled'] = TRUE;
      $form['field_use_ext_email_list']['#access'] = FALSE;
      $form['field_group_slug']['#access'] = FALSE;
      $form['field_group_id']['#access'] = FALSE;
      $form['field_affinity_group_category']['#access'] = FALSE;
    }
    $form['field_ext_email_list']['#disabled'] = TRUE;

    $token = \Drupal::token();
    $domain_name = Html::getClass($token->replace(t('[domain:name]')));
    if ($domain_name != 'access-support') {
      $form['field_recommended_access_res']['#access'] = FALSE;
      $form['field_cider_resources']['#access'] = FALSE;
    } else {
      // Only AGs set to Community should see Reccomended Ciders;
      // only AGs set to ACCESS RP category should see Associated Ciders.
      $category = $form['field_affinity_group_category']['widget']['#default_value'];
      if (!isset($category[0]) || $category[0] !== 'Community') {
        $form['field_recommended_access_res']['#access'] = FALSE;
      }
      if (!isset($category[0]) || $category[0] !== 'ACCESS_RP') {
        $form['field_cider_resources']['#access'] = FALSE;
      }
    }


  } elseif ($form_id == 'webform_submission_affinity_group_contact_add_form') {
    $form_allowed = FALSE;
    $coordinator = FALSE;
    // Allow this form only if the node is an affinity group.
    if (isset($form['elements']['nid']['#default_value'])) {
      $node = $form['elements']['nid']['#default_value'] == NULL ?
        0 :
        Node::load($form['elements']['nid']['#default_value']);
      $node_type = $node == NULL ? 0 : $node->getType();
      $form_allowed = $node_type == 'affinity_group' ? TRUE : FALSE;
      if ($form_allowed) {
        $coordinator = $node->get('field_coordinator')->getValue();
      }
    }
    // Get current user roles.
    $user = \Drupal::currentUser();
    $roles = $user->getRoles();
    if (in_array('administrator', $roles) && $form_allowed) {
      $form_allowed = TRUE;
    } elseif ($form_allowed) {
      $is_coordinator = FALSE;
      $form['elements']['name']['#access'] = FALSE;
      if ($coordinator) {
        $uid = $user->id();
        foreach ($coordinator as $c) {
          if ($c['target_id'] == $uid) {
            $is_coordinator = TRUE;
          }
        }
      }
      if (!$is_coordinator) {
        $form_allowed = FALSE;
      }
    }
    if ($form_allowed) {
      $node_title = $node->getTitle();
      $cc_list_id = $node->get('field_list_id')->getValue();
      $form['elements']['affinity_group']['#default_value'] = $node_title;
      $form['elements']['cc_list_id']['#default_value'] = $cc_list_id[0]['value'];
      $form['actions']['submit']['#submit'][] = 'webform_submission_affinity_group_affinity_contact';
      $form['#validate'][] = 'webform_submission_affinity_group_affinity_contact_validate';
    } else {
      \Drupal::messenger()->addMessage(t('It doesn\'t appear you came here from an affinity group page. Please go to an affinity group page and click the \'Contact Group\' link to send a message to that affinity group.'), 'warning');
      $form['actions']['submit']['#disabled'] = TRUE;
    }
  }
}

/**
 * Ajax callback function to replace the section with '#markup'.
 */
function access_affinitygroup_replace_section_callback(array &$form, FormStateInterface $form_state) {
  $raw_data = $form_state->getUserInput();
  $body = $raw_data['body'][0]['value'];
  $body_filter = $body ? Xss::filter($body) : '';
  $suggested_tag_ids = '0';
  $tag_count = count($raw_data['field_tags'] ?? []);
  $tag_limit = 6;
  $tag_amount = $tag_limit - $tag_count;

  if ($tag_amount <= 0) {
    $form['field_tags_replace']['user_message'] = [
      '#markup' => "<div class='match-tag-list bg-blue-200 text-sky-900 my-5 p-5'>
      <strong class='text-sky-900'>You already have 6 tags</strong><br />
      You can remove some tags to get more suggestions.</div>",
    ];
  }
  elseif (strlen($body_filter) >= 100) {
    try {
      $llm = \Drupal::service('access_llm.ai_references_generator');
      $llm->generateTaxonomyPrompt('tags', 1, $body_filter);
      $suggestions = array_slice($llm->taxonomyIdSuggested(), 0, $tag_amount);
      $suggested_tag_ids = implode(', ', $suggestions);
      $form['field_tags_replace']['user_message'] = [
        '#markup' => "",
      ];
    }
    catch (\Throwable $e) {
      $form['field_tags_replace']['user_message'] = [
        '#markup' => "<div class='match-tag-list bg-yellow-200 text-yellow-900 my-5 p-5'>
        <strong class='text-yellow-900'>AI tag suggestions are not available</strong><br />
        Please select tags manually from the list below.</div>",
      ];
    }
  }
  else {
    $form['field_tags_replace']['user_message'] = [
      '#markup' => "<div class='match-tag-list bg-blue-200 text-sky-900 my-5 p-5'>
      <strong class='text-sky-900'>Fill in the description above to get suggested tags.</strong><br />
                    Your description must be over 100 characters to get a suggestion.</div>",
    ];
  }

  $form['field_tags_replace']['#attributes']['data-suggest'] = $suggested_tag_ids ;

  // Return the updated section.
  return $form['field_tags_replace'];
}

/**
 * Form submit handler for affinity group to flag group for new coordinator.
 */
function access_affinitygroup_edit_submit($form, FormStateInterface $form_state) {
  $coordinators = $form_state->getValue('field_coordinator');
  if ($coordinators) {
    $title = $form_state->getValue('title')[0]['value'];
    $vid = 'affinity_groups';

    // Lookup taxonomy term by title.
    $at_taxonomy = \Drupal::entityTypeManager()
              ->getStorage('taxonomy_term')
              ->loadByProperties([
                      'vid' => $vid,
                      'name' => $title
                  ]);
    $tid = array_key_first($at_taxonomy);

    $flag_service = \Drupal::service('flag');

    foreach ($coordinators as $coordinator) {
      if (!isset($coordinator['target_id'])) {
        continue;
      }
      // Load user.
      $user = User::load($coordinator['target_id']);

      // Load taxonomy entity by tid.
      $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid);

      // Grab flag service for ag.
      $flag = $flag_service->getFlagById('affinity_group');

      if (!$flag_service->getFlagging($flag, $term, $user)) {
        // Flag the affinity group term for this coordinator.
        $flag_service->flag($flag, $term, $user);
      }
    }
  }
}

/**
 * Hook_presave only for Recommended Cider field.
 */
function access_affinitygroup_node_presave(NodeInterface $node) {
  $type = $node->getType();
  if ($type == 'recommended_cider') {
    $node->setTitle('');
  }
}

/**
 * Implements hook_inline_entity_form_table_fields_alter().
 */
function access_affinitygroup_inline_entity_form_table_fields_alter(&$fields, $context) {
  if ($context['entity_type'] == 'node') {

    // Hide the status + title (aka 'label' here) fields
    // that Inline Entity Form usually displays.
    unset($fields['status']);
    unset($fields['label']);

    // Add the resource + description field to the table.
    $fields['field_cider_resource'] = [
      'type' => 'field',
      'label' => t('Resource'),
      'weight' => 100,
    ];

    $fields['body'] = [
      'type' => 'field',
      'label' => t('Description'),
      'weight' => 200,
    ];
  }
}

/**
 * When the user is editing a Recommened Resource, hide the title field.
 */
function access_affinitygroup_inline_entity_form_entity_form_alter(&$form, &$form_state) {
  $form['title']['#access'] = FALSE;
}

/**
 * Implements hook_entity_update().
 * Invalidate affinity group ci links block cache when ci link is updated.
 */
function access_affinitygroup_entity_update(EntityInterface $entity) {
  $type = $entity->bundle();
  if ($type == 'resource') {
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['affinity_group_ci_links']);
  }

  // Email any infrastructure news with the 'Email only subscribers' box checked.
  if ($type == 'infrastructure_news') {
    access_affinitygroup_infrastructure_news_cc($entity);
  }
}

/**
 * Implements hook_entity_insert().
 * Send constant contact notifications of infrastructure_news alert.
 */
function access_affinitygroup_entity_insert(EntityInterface $entity) {
  $type = $entity->bundle();
  // Email any infrastructure news with the 'Email only subscribers' box checked.
  if ($type == 'infrastructure_news') {
    access_affinitygroup_infrastructure_news_cc($entity);
  }
}


/**
 * Send constant contact notifications of infrastructure_news alert.
 */
function access_affinitygroup_infrastructure_news_cc($entity) {
  $inf_title = $entity->get('title')->getValue()[0]['value'];
  $inf_body = '';
  if ($entity->get('body') !== NULL || $entity->get('body') !== 0) {
    if (isset($entity->get('body')->getValue()[0])) {
      $inf_body =$entity->get('body')->getValue()[0]['value'];
    }
  }
  $doEmailSubscribers = $entity->get('field_do_email_subscribers')->getValue();
  if ($doEmailSubscribers[0]['value']) {
    $affectedInfrastructure = $entity->get('field_affected_infrastructure')->getValue();
    $entity_id = $entity->id();
    $host = \Drupal::request()->getSchemeAndHttpHost();
    $email_link = $host . '/node/' . $entity_id;
    $ag_nodes = [];
    foreach ($affectedInfrastructure as $ais) {
      $query = \Drupal::entityQuery('node');
      $node_ids = $query
        ->condition('type', 'affinity_group')
        ->condition('field_cider_resources', $ais['target_id'])
        ->accessCheck(FALSE)
        ->execute();
      foreach ($node_ids as $nid) {
        $ag_nodes[$nid] = $nid;
      }
    }
    foreach ($ag_nodes as $ag_node) {
      $node = \Drupal::entityTypeManager()->getStorage('node')->load($ag_node);
      $ccListIds = [$node->get('field_list_id')->getValue()[0]['value']];
      $agNames = [$node->getTitle()];
      $pubDate = date('m/d/Y');
      emailToAffinityGroups($inf_body, "$inf_title", $pubDate, $agNames, $email_link, $ccListIds, 1, NULL);
    }
  }
}

/**
 * FAPI validation handler.
 */
function webform_submission_affinity_group_affinity_contact_validate(&$form, FormStateInterface $form_state) {
  // Add form error stating that the form is not yet implemented.
  // $form_state->setErrorByName('affinity_group', t('This form is not yet implemented.'));.
}

/**
 * FAPI #submit handler. Execute PHP submit handling.
 */
function webform_submission_affinity_group_affinity_contact(&$form, FormStateInterface $form_state) {
  $affinity_group = $form['elements']['affinity_group']['#value'];
  $agNames = [$affinity_group];
  $cc_list_id = $form['elements']['cc_list_id']['#value'];
  $ccListIds = [$cc_list_id];
  $subject = $form['elements']['subject']['#value'];
  $message = "<p>$subject</p>\n\n";
  $message .= $form['elements']['message']['value']['#value'];
  $message .= '<p>Sent by ' . $form['elements']['name']['#value'] . '</p>';
  $pubDate = date('m/d/Y');
  emailToAffinityGroups($message, "$subject", $pubDate, $agNames, NULL, $ccListIds, 1, NULL);
}

/**
 * Validate fields before saving an affinity group.
 * Slug (Short Name) field must be unique among affinity groups.
 */
function access_affinitygroup_edit_validate(&$form, FormStateInterface $form_state) {
  $slug = $form_state->getValue('field_group_slug')[0]['value'];
  $slug = strtolower(trim($slug));
  $thisNid = $form_state->getformObject()->getEntity()->id();
  $nidArray = \Drupal::entityQuery('node')
    ->condition('field_group_slug', $slug)
    ->condition('nid', $thisNid, '<>')
    ->accessCheck(FALSE)
    ->execute();

  if (!empty($nidArray)) {
    $nidArray = array_values($nidArray);
    $ag = Node::load($nidArray[0]);
    $form_state->setErrorByName('field_group_slug', "The Short Name must be unique, but $slug is already in use by " . $ag->getTitle());
  }
}

/**
 * Implements hook_entity_access().
 */
function access_affinitygroup_entity_access(EntityInterface $entity, $operation, AccountInterface $account) {
  if ($entity->getEntityTypeId() == 'node' && $entity->bundle() == 'affinity_group') {
    $ag_private = $entity->get('field_ag_private')->getValue();
    $access = 1;

    if (!empty($ag_private)) {
      // If private is set, deny access.
      if ($ag_private[0]['value']) {
        $access = 0;

        $ag_private_users = $entity->get('field_ag_private_users')->getValue();

        $current_user = \Drupal::currentUser();
        $current_uid = $current_user->id();

        // Give access to users in the private users field.
        foreach ($ag_private_users as $user) {
          $uid = $user['target_id'];
          if ($uid == $current_uid) {
            $access = 1;
          }
        }

        $ag_coordinator = $entity->get('field_coordinator')->getValue();

        // Give access to users in the coordinators field.
        foreach ($ag_coordinator as $user) {
          if (isset($user['target_id'])) {
            $uid = $user['target_id'];
            if ($uid == $current_uid) {
              $access = 1;
            }
          }
        }
      }
    }

    if ($access) {
      return AccessResult::neutral();
    } else {
      return AccessResult::forbidden();
    }
  }

  if ($entity->getEntityTypeId() == 'webform_submission' && $operation === 'update') {
    if ($entity->getWebform()->id() != 'resource') {
      return AccessResult::neutral();
    }

    $affinity_group = $entity->getElementData('affinity_group');

    $query = \Drupal::database()->select('taxonomy_index', 'ti');
    $query->condition('ti.tid', $affinity_group);
    $query->fields('ti', ['nid']);
    $affinity_group_nid = $query->execute()->fetchCol();

    $coordinator = [];
    foreach ($affinity_group_nid as $nid) {
      $node = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
      if ($node->getType() == 'affinity_group') {
        $coordinator = $node->get('field_coordinator')->getValue();
        break;
      }
    }
    if (empty($coordinator)) {
      return AccessResult::neutral();
    }
    else {
      $current_user = \Drupal::currentUser();
      $current_uid = $current_user->id();

      // Give access to users in the coordinators field.
      foreach ($coordinator as $user) {
        $uid = $user['target_id'];
        if ($uid == $current_uid) {
          return AccessResult::allowed();
        }
      }
    }
  }

}
