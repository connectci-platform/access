/**
 * Implements hook_views_pre_view() for node templates.
 *
 * @phpstan-param array<int, mixed> $args
 */
function access_news_views_pre_view(ViewExecutable $view, string $display_id, array &$args): void {
  // Only process News and Announcements views.
  if (!in_array($view->id(), ['access_news', 'access_announcements'])) {
    return;
  }

  $current_display = $display_id;

  // Define which displays need domain filtering.
  $domain_filtered_displays = [
    'block_1' => SiteTools::DOMAIN_CURRENT,
    'latest_news_block' => SiteTools::DOMAIN_CURRENT,
    'mrollup_list_block' => SiteTools::DOMAIN_ACCESS_SUPPORT,
    'rest_export_1' => SiteTools::DOMAIN_CURRENT,
    'rest_export_2' => SiteTools::DOMAIN_CURRENT,
  ];

  // Apply domain filtering if this display is in our list.
  if (isset($domain_filtered_displays[$current_display])) {
    $view_filters = $view->display_handler->getOption('filters');

    // Determine which domain to use.
    $domain = ($domain_filtered_displays[$current_display] === SiteTools::DOMAIN_CURRENT)
      ? \Drupal::service('access_misc.sitetools')->getDomainId()
      : $domain_filtered_displays[$current_display];

    // Use appropriate field name based on view type.
    $domain_field = ($view->id() == 'access_announcements') ? 'field_domain_access' : 'field_domain_access_target_id';

    // Only apply filtering if the domain field exists.
    if (isset($view_filters[$domain_field])) {
      // Handle different filter value structures.
      if (is_array($view_filters[$domain_field]['value'])) {
        // If it's an array structure (like min/max/value), preserve
        // the structure.
        if (isset($view_filters[$domain_field]['value']['value'])) {
          $view_filters[$domain_field]['value']['value'] = $domain;
        }
        else {
          // If it's a simple associative array.
          $view_filters[$domain_field]['value'] = [$domain => $domain];
        }
      }
      else {
        // If it's a simple string value.
        $view_filters[$domain_field]['value'] = $domain;
      }

      $view->display_handler->setOption('filters', $view_filters);
    }
  }
}

/**
 * Implements hook_form_alter().
 *
 * @phpstan-param array<string, mixed> $form
 */
function access_news_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $domain = \Drupal::service('access_misc.sitetools')->getDomain();

  if ($domain != 'access-support' && ($form_id == 'node_access_news_form' || $form_id == 'node_access_news_edit_form')) {
    $form['field_affiliation']['#access'] = FALSE;
    unset($form['field_choose_where_to_share_this']['widget']['#options']['in_the_access_support_bi_weekly_digest']);
  }

  // Suggest tags for announcements.
  if ($form_id == 'node_access_news_edit_form' || $form_id == 'node_access_news_form') {

    // A11y fixes.
    // Force h2 on titles.
    $form['field_affinity_group_node']['widget']['#title'] = Markup::create('<h2 class="label mb-0">' . $form['field_affinity_group_node']['widget']['#title'] . '</h2>');
    $form['field_affiliation']['widget']['#title'] = Markup::create('<h2 class="label">' . $form['field_affiliation']['widget']['#title'] . '</h2>');
    $form['field_choose_where_to_share_this']['widget']['#title'] = Markup::create('<h2 class="label">' . $form['field_choose_where_to_share_this']['widget']['#title'] . '</h2>');
    $form['field_news_external_link']['widget'][0]['#title'] = Markup::create('<h2 class="label mb-0">' . $form['field_news_external_link']['widget']['#title'] . '</h2>');

    // Replace title of 'Affiliation' and 'Choose where to share this
    // Announcment' with h4.
    $fields = ['field_affiliation', 'field_choose_where_to_share_this'];

    foreach ($fields as $field) {
      $title = $form[$field]['widget']['#title'];
      $form[$field]['widget']['#title'] = "<span class='text-xl font-bold text-dark-teal'>$title</span>";
    }

    // Replace title of 'External Link' with h4.
    $el_title = $form['field_news_external_link']['widget'][0]['#title'];
    $form['field_news_external_link']['widget'][0]['#title'] = "<span class='text-xl font-bold text-dark-teal'>$el_title</span>";

    // Field is hidden and replaced with custom UI.
    // Element validation ensures proper error messages are shown.
    $form['field_tags']['widget']['#element_validate'][] = 'access_news_tags_validate_element';

    $form['field_tags_replace'] = [
      '#type' => 'container',
      '#attributes' => [
        'id' => 'field-tags-replace',
        'data-suggest' => '0',
      ],
      '#weight' => 1,
    ];
    $form['field_tags_replace']['field_suggest'] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => [
          'bg-light-teal',
          'my-5',
          'p-5',
        ],
      ],
    ];
    $form['field_tags_replace']['field_suggest']['tag_list'] = [
      '#markup' => "<div id='match-tag-list' class='mb-3'>Get tag suggestions based on your description and then curate as necessary. Limited to 6 tags.</div>",
    ];
    $form['field_tags_replace']['field_suggest']['replace_button'] = [
      '#type' => 'button',
      '#value' => t('Suggest Tags'),
      '#limit_validation_errors' => [],
      '#attributes' => [
        'class' => [
          'ml-0',
        ],
      ],
      '#ajax' => [
        'callback' => 'access_affinitygroup_replace_section_callback',
        'wrapper' => 'field-tags-replace',
      ],
    ];
    $form['field_tags_replace']['user_message'] = [
      '#markup' => "",
    ];
    $add_tags = \Drupal::service('access_misc.addtags');
    $output = $add_tags->getView();
    $form['custom_tags'] = [
      '#markup' => "<div id='tag-suggestions'></div><details open class='tags'><summary><label class='js-form-required form-required'>Select relevant tags</label></summary>$output</details>",
      '#weight' => 1,
      '#allowed_tags' => [
        'ul',
        'li',
        'button',
        'details',
        'summary',
        'label',
        'span',
        'div',
        'h2',
      ],
    ];
    // Attach javascript.
    $form['#attached']['library'][] = 'access_misc/node_add_tags';

    $form['#validate'][] = 'access_news_ag_validate';
  }

  if ($form_id == 'eventseries_default_add_form' || $form_id == 'eventseries_default_edit_form') {
    $form['field_event_speakers']['widget']['add_more']['#value'] = t('Add another Speaker');
  }

  // Both announcements and events use the custom validation function.
  if ($form_id == 'node_access_news_edit_form' || $form_id == 'node_access_news_form' || $form_id == 'eventseries_default_add_form' || $form_id == 'eventseries_default_edit_form') {
    $form['#validate'][] = 'access_news_validate';
  }

  if ($form['#id'] == 'views-exposed-form-access-news-block-1') {
    $domain = \Drupal::service('access_misc.sitetools')->getDomainId();

    $entity_query = \Drupal::entityQuery('node')
      ->condition('type', 'affinity_group')
      ->condition('field_domain_access', $domain)
      ->condition('status', 1)
      ->accessCheck(FALSE);
    $ag_ids = $entity_query->execute();

    $ag_list = [];
    $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($ag_ids);
    foreach ($nodes as $ag_id => $node) {
      $title = $node->getTitle();

      if ($node !== NULL) {
        $title = $node->getTitle();
        $ag_list[$ag_id] = $title;
      }
    }

    asort($ag_list);
    $ag_list = ['' => t('All Affinity Groups')] + $ag_list;

    $form['field_affinity_group_node_target_id'] = [
      '#type' => 'select',
      '#options' => $ag_list,
      '#default_value' => '',
    ];
  }
}

/**
 * Add AI Suggested Tags to the form.
 *
 * Ajax callback function to replace the section with '#markup'.
 *
 * @param array<string, mixed> $form
 *   The form render array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current state of the form.
 *
 * @return array<string, mixed>
 *   The 'field_tags_replace' render array section.
 */
function access_news_replace_section_callback(array &$form, FormStateInterface $form_state): array {
  $raw_data = $form_state->getUserInput();
  $body = $raw_data['body'][0]['value'];
  $body_filter = $body ? Xss::filter($body) : '';
  $suggested_tag_ids = '0';
  $tag_count = count($raw_data['field_tags'] ?? []);
  $tag_limit = 6;
  $tag_amount = $tag_limit - $tag_count;

  $form['field_tags_replace']['user_message'] = [
    '#markup' => "",
  ];

  if ($tag_amount <= 0) {
    $form['field_tags_replace']['user_message'] = [
      '#markup' => "<div class='match-tag-list bg-blue-200 text-sky-900 my-5 p-5'>
      <strong class='text-sky-900'>You already have 6 tags</strong><br />
      You can remove some tags to get more suggestions.</div>",
    ];
  }
  elseif (strlen($body_filter) >= 100) {
    try {
      $llm = \Drupal::service('access_llm.ai_references_generator');
      $llm->generateTaxonomyPrompt('tags', 1, $body_filter);
      $suggestions = array_slice($llm->taxonomyIdSuggested(), 0, $tag_amount);
      $suggested_tag_ids = implode(', ', $suggestions);
      $form['field_tags_replace']['user_message'] = [
        '#markup' => "",
      ];
    }
    catch (\Throwable $e) {
      $form['field_tags_replace']['user_message'] = [
        '#markup' => "<div class='match-tag-list bg-yellow-200 text-yellow-900 my-5 p-5'>
        <strong class='text-yellow-900'>AI tag suggestions are not available</strong><br />
        Please select tags manually from the list below.</div>",
      ];
    }
  }
  else {
    $form['field_tags_replace']['user_message'] = [
      '#markup' => "<div class='match-tag-list bg-blue-200 text-sky-900 my-5 p-5'>
      <strong class='text-sky-900'>Fill in the description above to get suggested tags.</strong><br />
                    Your description must be over 100 characters to get a suggestion.</div>",
    ];
  }

  $form['field_tags_replace']['#attributes']['data-suggest'] = $suggested_tag_ids;

  // Return the updated section.
  return $form['field_tags_replace'];
}

/**
 * Element validation callback for field_tags.
 *
 * Validates that at least one tag is selected and no more than 6.
 *
 * @param array<string, mixed> $element
 *   The form element being validated.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current state of the form.
 * @param array<string, mixed> $form
 *   The complete form.
 */
function access_news_tags_validate_element(array $element, FormStateInterface $form_state, array $form): void {
  $values = $form_state->getValue('field_tags');

  // Count non-empty tag values.
  $tag_count = 0;
  if (is_array($values)) {
    foreach ($values as $tag) {
      if (is_array($tag) && !empty($tag['target_id'])) {
        $tag_count++;
      }
    }
  }

  // Check if at least one tag is selected.
  if ($tag_count === 0) {
    $form_state->setError($element, t('Please select at least one tag from the list below. Tags help others find your announcement.'));
  }
  // Check maximum of 6 tags.
  elseif ($tag_count > 6) {
    $form_state->setError($element, t('You can only select up to 6 tags. Please remove @count tags.', ['@count' => $tag_count - 6]));
  }
}

/**
 * Custom validation callback.
 *
 * Make sure AG is selected with proper checkboxes.
 *
 * @param array<string, mixed> $form
 *   The complete form.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current state of the form.
 */
function access_news_ag_validate(array &$form, FormStateInterface $form_state): void {
  // Get the value of the field_choose_where_to_share_this field.
  $values = $form_state->getValues();
  $share_options = $values['field_choose_where_to_share_this'] ?? [];
  $ag = $values['field_affinity_group_node'] ?? [];

  $no_ag = TRUE;
  foreach ($ag as $value) {
    if (is_array($value) && !empty($value['target_id'])) {
      $no_ag = FALSE;
    }
  }

  if ($no_ag) {
    foreach ($share_options as $value) {
      if ($value['value'] == 'email_to_your_affinity_group' || $value['value'] == 'on_your_affinity_group_page') {
        $form_state->setErrorByName('field_affinity_group_node', t('You must select at least one Affinity Group when choosing to email your Affinity Groups or place the announcement on your Affinity Group Page.'));
      }
    }
  }

}

/**
 * Custom validation callback.
 *
 * Require that the person adding an Affinity Group
 * is a Coordinator of that Affinity Group.
 *
 * Also, check that the Affinity Group taxonomy term exists.
 *
 * @param array<string, mixed> $form
 *   The complete form.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current state of the form.
 */
function access_news_validate(array &$form, FormStateInterface $form_state): void {
  // Require that the person saving is an Affinity Group Coordinator
  // if an Affinity Group is selected for ACCESS News.
  $user = User::load(\Drupal::currentUser()->id());
  $ag_node_array = $form_state->getValue('field_affinity_group_node') ?? [];
  // Valid values are arrays with non-null 'target-id' value.
  foreach ($ag_node_array as $ag_node) {
    if (is_array($ag_node)) {
      $nid = $ag_node['target_id'];
      if ($nid) {
        $authorized = FALSE;
        $n = Node::load($nid);
        // Administrator or news_pm role can assign ACCESS News to any
        // Affinity Group.
        if (
          in_array('administrator', \Drupal::currentUser()->getRoles()) ||
          in_array('news_pm', \Drupal::currentUser()->getRoles())
        ) {
          $authorized = TRUE;
        }
        else {
          // Load coordinator(s) for the Affinity Group.
          $coordinator_field = $n->get('field_coordinator');
          $coordinators = $coordinator_field->getValue();
          foreach ($coordinators as $coordinator) {
            if ($coordinator['target_id'] == $user->get('uid')->value) {
              $authorized = TRUE;
            }
          }
        }
        // Check that the Affinity Group term exists.
        $name = $n->get('title')->value;
        $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['name' => $name]);
        if (!$term) {
          $form_state->setErrorByName('access_news', t('The Affinity Group taxonomy term @name does not exist. Please contact an administrator.', ['@name' => $name]));
        }
        if (!$authorized) {
          $form_state->setErrorByName('access_news', t('You are not a Coordinator for the @title Affinity Group.', ['@title' => $n->get('title')->value]));
        }
      }
    }
  }

  // Note: Tag validation (min 1, max 6) is handled by
  // access_news_tags_validate_element().
}

/**
 * Implements hook_node_presave().
 *
 * Set the Affinity Group taxonomy term based on the
 * Affinity Group node so people only have to select it once.
 */
function access_news_node_presave(Node $node): void {
  $type = $node->bundle();
  if ($type == 'access_news') {
    access_news_update_affinity_group($node);
  }
}

/**
 * Implements hook_entity_presave().
 *
 * Set the Affinity Group taxonomy term based on the
 * Affinity Group node so people only have to select it once.
 */
function access_news_entity_presave(EntityInterface $entity): void {
  $type = $entity->getEntityTypeId();
  if ($type == 'eventseries') {
    /** @var \Drupal\Core\Entity\ContentEntityInterface $entity */
    access_news_update_affinity_group($entity);
  }
}

/**
 * Implements hook_preprocess_field().
 *
 * Hides the registration link on the eventinstance registration field
 * if the event is past.
 *
 * @phpstan-param array<string, mixed> $variables
 */
function access_news_preprocess_field(array &$variables): void {
  if ($variables['entity_type'] == 'eventinstance' && $variables['field_name'] == 'registration') {
    $event = $variables['element']['#object'];
    $eventDate = $event->get('date')->value;
    $eventDate = new DrupalDateTime($eventDate, 'UTC');
    $now = new DrupalDateTime('now', 'UTC');
    if ($eventDate < $now) {
      $variables['items'] = NULL;
    }
  }
}

/**
 * Set Affinity Group taxonomy terms based on the Affinity Group node field.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $node
 *   The ACCESS News node or EventSeries entity being saved.
 */
function access_news_update_affinity_group(ContentEntityInterface $node): void {
  $ag_node_array = $node->get('field_affinity_group_node');
  $node->set('field_affinity_group', NULL);
  foreach ($ag_node_array as $ag_node) {
    // Get the Affinity Group node.
    $nid = $ag_node->getValue()['target_id'];
    $ag = Node::load($nid);
    $name = $ag->get('title')->value;
    // Get the term with the same name as the Affinity Group.
    $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['name' => $name]);
    $node->get('field_affinity_group')->appendItem(array_key_first($term));
  }
}

/**
 * Implements hook_node_insert().
 *
 * Provide message that approval is required.
 */
function access_news_node_insert(Node $node): void {
  $type = $node->bundle();
  if ($type == 'access_news') {
    // Send admins a message if an ACCESS News node is created
    // and needs approval for publication.
    if (!$node->isPublished()) {
      $allowed_roles = ['administrator', 'affinity_group_leader'];
      if (!in_array($allowed_roles, \Drupal::currentUser()->getRoles())) {
        $message = t('Thank you for submitting your news. Please change the state to "Ready for Review" when you would like to publish it.');
        \Drupal::messenger()->addMessage($message);
      }
    }
    else {
      // For published news: Check if broadcast to listed AGs desired,
      // do it if so.
      access_news_affinity_group_broadcast($node, TRUE);
    }
  }
}

/**
 * Implements hook_module_implements_alter().
 *
 * Move our entity_insert/entity_update handlers to the END of the hook list
 * so access_news_affinity_group_broadcast() runs AFTER recurring_events has
 * populated `event_instances` on the EventSeries. Otherwise the broadcast
 * email would link to the series URL (e.g. /events/series/914) instead of
 * the single instance URL, since `getInstanceCount()` returns 0 before the
 * contrib module's eventseries_insert hook fires to create instances.
 *
 * Module implementations are invoked alphabetically by default;
 * "access_news" sorts before "recurring_events", so we reorder explicitly.
 *
 * @phpstan-param array<string, mixed> $implementations
 */
function access_news_module_implements_alter(array &$implementations, string $hook): void {
  if (in_array($hook, ['entity_insert', 'entity_update'], TRUE)
    && isset($implementations['access_news'])) {
    $impl = $implementations['access_news'];
    unset($implementations['access_news']);
    $implementations['access_news'] = $impl;
  }
}

/**
 * Implements hook_entity_insert().
 *
 * Provide message that approval is required.
 */
function access_news_entity_insert(EntityInterface $entity): void {

  $type = $entity->getEntityTypeId();
  if ($type == 'eventseries') {
    /** @var \Drupal\recurring_events\Entity\EventSeries $entity */
    if (!$entity->isPublished()) {
      $allowed_roles = ['affinity_group_leader'];
      if (!in_array($allowed_roles, \Drupal::currentUser()->getRoles())) {
        $message = t('Thank you for submitting your event. Please change the state to "Ready for Review" when you would like to publish it.');
        \Drupal::messenger()->addMessage($message);
      }
    }
    else {
      // For published event: Check if broadcast to listed AGs desired,
      // do it if so.
      access_news_affinity_group_broadcast($entity, FALSE);
    }
  }
}

/**
 * Implements hook_entity_update().
 *
 * Broadcasts published ACCESS News and Event Series to their Affinity
 * Groups, if requested.
 */
function access_news_entity_update(EntityInterface $node): void {

  $type = $node->bundle();
  if ($type != 'access_news') {
    $type = $node->getEntityTypeId();
  }
  // @todo possible want to allow broadcast on an individual event as well.
  // if ($type == 'access_news' || $type == 'eventseries'
  // || $type == 'eventinstance') {
  if ($type == 'access_news' || $type == 'eventseries') {
    /** @var \Drupal\Core\Entity\ContentEntityInterface&\Drupal\Core\Entity\EntityPublishedInterface $node */
    if ($node->isPublished()) {
      access_news_affinity_group_broadcast($node, $type);
    }
  }
}

/**
 * Sends email to constant contact email list of chosen Affinity Groups.
 *
 * Sends only if both:
 * 1) option to BroadcastToAffinityGroup is checked.
 * 2) at least one affinity group specified.
 *
 * Should also be in published state, but that is checked before we get here.
 * After send attempt, uncheck the broadcast option.
 * Meant to be used by both News items and Events Series.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $node
 *   The ACCESS News node or EventSeries entity being broadcast.
 * @param bool|string $newsType
 *   'Eventseries' or 'access_news' (or tdb: eventinstance); may also be
 *   passed as a boolean by some callers (loosely compared below).
 */
function access_news_affinity_group_broadcast(ContentEntityInterface $node, $newsType): void {
  $getFields = $node->getFields();
  $broadcastArray = $getFields['field_choose_where_to_share_this']->getValue();
  $broadcast = 0;
  foreach ($broadcastArray as $key => $value) {
    if ($value['value'] == 'email_to_your_affinity_group') {
      $broadcast = 1;
      unset($broadcastArray[$key]);
    }
  }
  if (!$broadcast) {
    return;
  }
  $broadcastToAGs = $broadcastArray[0]['value'];
  $useCommunityTemplate = NULL;

  // Find the node ids for the AGs.  If AGs have been specified, get the
  // corresponding Constant Contact email list ids from the nodes.
  if ($broadcastToAGs) {
    $agNodes = $node->get('field_affinity_group_node');
    if (count($agNodes)) {
      $ccListIdArray = [];
      $agNames = [];
      $logoUrl = NULL;
      $currentDomainId = NULL;

      // Get the current domain (where the broadcast is being initiated from)
      // to use for URLs in the email.
      // Note: DomainNegotiatorInterface::getActiveDomain() is documented as
      // always returning a DomainInterface, but the implementation can
      // return NULL if no domain has been negotiated, so the type is
      // corrected here.
      /** @var \Drupal\domain\DomainInterface|null $current_domain */
      $current_domain = \Drupal::service('domain.negotiator')->getActiveDomain();
      if ($current_domain) {
        $currentDomainId = $current_domain->id();
      }

      // Collect ag name and cc email list id.
      foreach ($agNodes as $agNode) {

        $nid = $agNode->getValue()['target_id'];
        $ag = Node::load($nid);

        $name = $ag->get('title')->value;
        $agNames[] = $name;

        $ccListId = $ag->get('field_list_id')->value;
        $ccListIdArray[] = $ccListId;

        // We decide which email template to use (community or access)
        // looking at the type of the first AG only in send list.
        if ($useCommunityTemplate == NULL) {
          $agCat = $ag->get('field_affinity_group_category')->value;
          $useCommunityTemplate = ($agCat == 'Community');

          // Get logo image url for use in community template.
          if ($useCommunityTemplate) {
            /** @var \Drupal\file\FileInterface|null $logo_file */
            $logo_file = $ag->get('field_image')->entity;
            if (!empty($logo_file)) {
              $uri = $logo_file->getFileUri();
              $logoUrl = \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
            }
          }
        }
      }

      if (!count($ccListIdArray)) {
        showStatus("Missing Constant Contact Email List Id for Affinity Group");
      }
      else {
        // Gather items to insert into the email template.
        $titleArray = $getFields['title']->getValue();
        $title = $titleArray[0]['value'];

        // Make link to item, including utm for analytics.
        // Use the current domain for the URL.
        $newsUrl = _access_news_build_url_for_domain($node, $currentDomainId);
        $utmCampaign = filter_var($agNames[0], FILTER_SANITIZE_URL) . '-' . date('mdy');
        $newsUrl = access_news_append_utm_cc($newsUrl, $utmCampaign);

        // Set pubDate and body; news / eventseries different.
        if ($newsType == 'access_news') {
          $pubDateArray = $getFields['field_published_date']->getValue();
          $pubDate = $pubDateArray[0]['value'];
          $date = date_create_from_format('Y-m-d', $pubDate);
          // Reverse the date.
          $pubDate = date_format($date, 'F j, Y');

          // check_markup applies all the filters that are set for the
          // basic_html for security and also to add host to img src,
          // for example.
          // We don't use the renderer because we need to separate the
          // title.
          $bodyArray = $getFields['body']->getValue();
          $body = check_markup($bodyArray[0]['value'], 'basic_html');
        }
        else {
          // Newstype is eventseries.
          /** @var \Drupal\recurring_events\Entity\EventSeries $node */
          $pubDate = NULL;

          // If there's only one event instance, link to that instance
          // instead of the series.
          if ($node->getInstanceCount() == 1) {
            $instances = $node->get('event_instances')->referencedEntities();
            if (!empty($instances)) {
              $first_instance = reset($instances);
              $newsUrl = _access_news_build_url_for_domain($first_instance, $currentDomainId);
              $newsUrl = access_news_append_utm_cc($newsUrl, $utmCampaign);
            }
          }
          elseif ($node->getInstanceCount() > 1) {
            // Multiple instances - don't include a link button.
            $newsUrl = NULL;
          }

          // Body set using a custom view mode: ccemail.
          $view_builder = \Drupal::entityTypeManager()->getViewBuilder('eventseries');
          $renderArray = $view_builder->view($node, 'ccemail');
          $body = \Drupal::service('renderer')->renderInIsolation($renderArray);

          $body = str_replace('Event Instances', 'Event Date & Time', $body);

          // Un-obfuscate email addresses for email broadcast.
          // Convert "contact [at] example.com" back to "contact@example.com".
          $body = preg_replace('/\s*\[at\]\s*/', '@', $body);

          // Make field labels bold in the email (case-insensitive).
          $body = preg_replace(
            '/<div class="field__label">([^<]+)<\/div>/i',
            '<div class="field__label"><strong>$1</strong></div>',
            $body
          );

          // Transform relative URLs to absolute using the current domain.
          if (!empty($body)) {
            /** @var \Drupal\domain\Entity\Domain|null $domain */
            $domain = \Drupal::entityTypeManager()->getStorage('domain')->load($currentDomainId);
            if ($domain) {
              // Build base URL: scheme + hostname.
              // getScheme() returns 'https://' or 'http://' with the
              // separator included.
              $domain_url = $domain->getScheme() . $domain->getHostname();
              $body = Html::transformRootRelativeUrlsToAbsolute($body, $domain_url);
            }
          }
          else {
            // Body is empty - something went wrong with rendering.
            \Drupal::logger('access_news')->error('Event series @id rendered empty body, skipping email broadcast', ['@id' => $node->id()]);
            return;
          }

        }

        // Check if body is empty before sending.
        if (empty($body)) {
          \Drupal::logger('access_news')->error('News/Event @id has empty body, skipping email broadcast', ['@id' => $node->id()]);
          return;
        }

        // Now emailing the group; set option broadcast off. If user
        // wants to email again after and edit, they will need to
        // check the box again.
        $node->set('field_choose_where_to_share_this', $broadcastArray);
        $node->save();

        emailToAffinityGroups(
          $body,
          $title,
          $pubDate,
          $agNames,
          $newsUrl,
          $ccListIdArray,
          $useCommunityTemplate,
          $logoUrl
              );
      }
    }
  }
}

/**
 * WeeklyNewsReport()
 *
 *  Roll up all the news from the past week and events for the coming month.
 *  Make html display of these items for Constant Contact email.
 *  Set up the Constant Contact campaign, but don't send it.
 *
 *  noSend: if true, only creates the campaign; otherwise sends a preliminary
 *  email @todo to ??
 *
 * @param bool $noSend
 *   If true, only creates the campaign; otherwise sends a preliminary
 *   email.
 */
function access_news_weekly_news_report(bool $noSend): void {

  try {
    // Gather all news published from 14 days ago until today.
    // need to make dates for searching on published_date (not date+time)
    $dtLastWeek = new \DateTime('-14 days');
    $dtToday = new \DateTime('today');
    $dtDigestDate = new \DateTime('today');
    $utmCampaign = 'Digest-' . $dtDigestDate->format('mdy');

    $d1 = DrupalDateTime::createFromDateTime($dtLastWeek)
      ->format(DateTimeItemInterface::DATE_STORAGE_FORMAT);
    $d2 = DrupalDateTime::createFromDateTime($dtToday)
      ->format(DateTimeItemInterface::DATE_STORAGE_FORMAT);

    $wrapper = new EmailWrapper();
    $newsHTML = access_news_news_range_view($d1, $d2, $utmCampaign);
    $mainHeader = $wrapper->mainHeadHTML("The ACCESS Digest // " . $dtDigestDate->format('F j, Y'));
    $sectionHeader = $wrapper->sectionHeadHTML(t('Announcements'));
    $newsHTML = $newsHTML != '' ? $mainHeader . $sectionHeader . $newsHTML : $mainHeader;
    Drupal::logger('cron_accessnews')->notice('Digest: news from: ' . $d1 . ' to: ' . $d2);

    // Gather all upcoming events for the next month (today to +1 month)
    $timezone = new \DateTimeZone(DateTimeItemInterface::STORAGE_TIMEZONE);
    $dtCurrent = new \DateTime('today', $timezone);
    $dtNextMonth = new \DateTime('today+1 month + 1 day', $timezone);

    $d1 = DrupalDateTime::createFromDateTime($dtCurrent)
      ->format(DateTimeItemInterface::DATETIME_STORAGE_FORMAT);
    $d2 = DrupalDateTime::createFromDateTime($dtNextMonth)
      ->format(DateTimeItemInterface::DATETIME_STORAGE_FORMAT);

    Drupal::logger('cron_accessnews')->notice('Digest: events from: ' . $d1 . ' to: ' . $d2);
    $conference = access_news_events_range_view($d1, $d2, 'Conference', t('Conferences'), $utmCampaign);
    $trainings = access_news_events_range_view($d1, $d2, 'Training', t('Training'), $utmCampaign);
    $other = access_news_events_range_view($d1, $d2, 'zz_other', t('Other Events'), $utmCampaign);
    $office_hours = access_news_events_range_view($d1, $d2, 'Office Hours', t('Office Hours'), $utmCampaign);

    $eventHTML = $conference . $trainings . $office_hours . $other;

    $emailHTML = $wrapper->ccNewsRollupHTML($newsHTML, $eventHTML);

    // Create constant contact campaign. this does not send it.
    $campaignName = uniqid('Access Digest: ' . $dtDigestDate->format('n/j/y') . ' ', FALSE);

    $ccResponse = setupEmailCampaign('The ACCESS Digest // ' . $dtDigestDate->format('F j, Y'), $emailHTML, $campaignName);
    if (!$ccResponse) {
      \Drupal::logger('cron_accessnews')->error('access_news_weekly_news_report: error setting up campaign. Make sure Constant Contact calls are not disabled.');
    }
  }
  catch (Exception $e) {
    \Drupal::logger('cron_accessnews')->error('access_news_weekly_news_report: ' . $e->getMessage());
  }
  // Possible todo: if !nosend, send email to xx saying the draft is
  // ready. Or perhaps send a CC test mail to the person.
}

/**
 * OfficeHours type returned.
 *
 * @param array<int|string, mixed> $ids
 *   Event series IDs mapped to their upcoming instance data.
 * @param string|null $utmCampaign
 *   Text for utm_campaign=.
 *
 * @return string
 *   Rendered HTML for the recurring office hours events.
 */
function access_news_office_hours(array $ids, $utmCampaign = NULL): string {
  $wrapper = new EmailWrapper();
  $eventseries_office_hours = [];

  foreach ($ids as $entity_id => $entities) {
    /** @var \Drupal\recurring_events\Entity\EventSeries $entity */
    $entity = \Drupal::entityTypeManager()->getStorage('eventseries')->load($entity_id);

    $title = $entity->get('title')->value;
    $recur_type = $entity->get('recur_type')->value;

    $weekly_recurring_day = $entity->get('weekly_recurring_date')->__get('days');
    // $weekly_recurring_time = $entity->get('weekly_recurring_date')
    // ->__get('time');
    $monthly_occurance = $entity->get('monthly_recurring_date')->__get('day_occurrence');
    $monthly_days = $entity->get('monthly_recurring_date')->__get('days');

    $body = '<p>' . $entity->get('field_summary')->value . '</p>';
    if ($body == NULL) {
      $body = $entity->get('body')->view('list');
      $body = $body[0] != NULL ? $body[0] : '';
      $body = \Drupal::service('renderer')->renderInIsolation($body);
    }

    $n = 0;
    $time = '';
    foreach ($entities as $entity) {
      $date = $entity['date'];
      $url = $entity['url'];
      $body .= "<p><a href='$url'>$date</a></p>";
      if ($n == 0) {
        $time = preg_replace('/\d+\/\d+\/\d+/', '', $date);
        $time = ltrim($time);
      }
      $n++;
    }

    // Add space after comma.
    $monthly_occurance = str_replace(',', ', ', $monthly_occurance);

    $eventseries_office_hours[$entity_id] = [
      'title' => $title,
      'recur_type' => $recur_type,
      'day_of_week' => ucfirst($weekly_recurring_day),
      'time' => $time,
      'monthly_occurance' => ucfirst($monthly_occurance),
      'monthly_days' => ucfirst($monthly_days),
      'body' => $body,
    ];

  }

  $recurring_events = '';
  $recurring_events_exists = 0;
  foreach ($eventseries_office_hours as $event) {
    $recurring_events_exists = 1;

    if ($event['day_of_week']) {
      $recurring_events .= $wrapper->eventItemHTML($event['title'], "{$event['day_of_week']}s at {$event['time']}", $event['body'], NULL);
    }
    else {
      $recurring_events .= $wrapper->eventItemHTML($event['title'], "{$event['monthly_occurance']} {$event['monthly_days']} at {$event['time']}", $event['body'], NULL);
    }
  }

  if ($recurring_events_exists == 0) {
    $recurring_events = '';
  }

  return $recurring_events;
}

/**
 * Returns html list of news in this date range.
 *
 * Each item shows Title, date, time, excerpt, location, link to news
 * item. utmCampaign: text for utm_campaign=.
 *
 * @param string $fromDate
 *   The start of the date range, in storage format.
 * @param string $toDate
 *   The end of the date range, in storage format.
 * @param string $utmCampaign
 *   Text for utm_campaign=.
 *
 * @return string
 *   Rendered HTML list of news items.
 */
function access_news_news_range_view(string $fromDate, string $toDate, string $utmCampaign): string {

  $listDisplay = '';
  $wrapper = new EmailWrapper();
  try {
    $nids = \Drupal::entityQuery('node')
      ->condition('status', 1)
      ->condition('field_published_date.value', $fromDate, '>=')
      ->condition('field_published_date.value', $toDate, '<=')
      ->condition('type', 'access_news')
      ->condition('field_domain_access', SiteTools::DOMAIN_ACCESS_SUPPORT)
      ->condition('field_choose_where_to_share_this', 'in_the_access_support_bi_weekly_digest')
      ->accessCheck(FALSE)
      ->execute();

    $nodes = Node::loadMultiple($nids);
    foreach ($nodes as $node) {

      try {
        $title = $node->getTitle();

        // Gets format Apr 03, 2023; want 4/3/2023.
        /** @var \Drupal\Core\Field\FieldItemInterface $published_date_item */
        $published_date_item = $node->field_published_date[0];
        $pubDate = $published_date_item->view('alt_teaser');
        $pubDateDisp = \Drupal::service('renderer')->renderInIsolation($pubDate);
        $pubDate = date_create_from_format('M d, Y', $pubDateDisp);
        $pubDateDisp = $pubDate->format('n/j/Y');

        // For body section, meant to be a snippet, this will return
        // either a nicely truncated version of the body (the length
        // is configured on site via
        // /admin/structure/types/manage/access_news/display/alt_teaser)
        // or, if the user has set the "custom summary", will return
        // that instead.
        // @todo The body is returned with <p>body</p> markup, but the
        // summary is not. (need to distiguish because the news items
        // with and without custom summary will have different
        // spacing in the digest. Or do something with css)
        if ($node->body[0] != NULL) {
          /** @var \Drupal\Core\Field\FieldItemInterface $body_item */
          $body_item = $node->body[0];
          $body = $body_item->view('teaser');
          $bodyRendered = \Drupal::service('renderer')->renderInIsolation($body);
          $bodyDisp = "<p>$bodyRendered</p>";
        }
        else {
          $bodyDisp = '<p></p>';
        }

        $newsUrl = AccessNewsInterface::SUPPORT_URL . $node->toUrl()->toString();
        $newsUrl = access_news_append_utm_cc($newsUrl, $utmCampaign);

        $itemDisplay = $wrapper->newsItemHTML($title, $pubDateDisp, $bodyDisp, $newsUrl);
      }
      catch (Exception $e) {
        $itemDisplay = 'Error retrieving news item: ' . $e->getMessage();
      }

      $listDisplay = $listDisplay . $itemDisplay;
    } // end for
  }
  catch (Exception $e) {
    $listDisplay = 'Error retrieving news: ' . $e->getMessage();
  }
  return $listDisplay;
}

/**
 * Returns html list of events in this date range.
 *
 * Note: the date/times should have 0 for time for the end date; if
 * not the date should be +1 from needed date. utmCampaign: text for
 * utm_campaign=.
 *
 * @param string $fromDate
 *   The start of the date range, in storage format.
 * @param string $toDate
 *   The end of the date range, in storage format.
 * @param string $type
 *   The event type to filter on (e.g. 'Conference', 'Training').
 * @param string|\Drupal\Core\StringTranslation\TranslatableMarkup $type_title
 *   The human-readable section title for this event type.
 * @param string $utmCampaign
 *   Text for utm_campaign=.
 *
 * @return string
 *   Rendered HTML list of events.
 */
function access_news_events_range_view(string $fromDate, string $toDate, string $type, $type_title, string $utmCampaign): string {

  $listDisplay = '';
  $wrapper = new EmailWrapper();

  $weekly_id = [];
  $monthly_id = [];

  try {
    $eids = \Drupal::entityQuery('eventinstance')
      ->condition('status', 1)
      ->condition('date.value', $fromDate, '>=')
      ->condition('date.value', $toDate, '<')
      ->condition('domain_access', SiteTools::DOMAIN_ACCESS_SUPPORT)
      ->sort('date.value', 'ASC')
      ->accessCheck(TRUE)
      ->execute();

    $eventNodes = EventInstance::loadMultiple($eids);
    foreach ($eventNodes as $enode) {
      try {
        $series = $enode->getEventSeries();
        $series_id = $series->id();
        // @todo Replace with new where to share checkbox soon.
        // $no_share = $series->get('field_event_no_listing')->value;
        $where_share = $series->get('field_choose_where_to_share_this');
        $no_share = 1;
        foreach ($where_share as $ws) {
          if ($ws->get('value')->getValue() == 'in_the_access_support_bi_weekly_digest') {
            $no_share = 0;
          }
        }

        $recur_type = $series->get('recur_type')->value;

        if ($series->get('field_event_type')->value != $type) {
          continue;
        }

        // Show only if marked to share in digest.
        if ($no_share) {
          continue;
        }

        $fields = $enode->getFields();
        $titleArray = $fields['title']->getValue();
        $title = $titleArray[0]['value'];

        $eventUrl = AccessNewsInterface::SUPPORT_URL . $enode->toUrl()->toString();
        $eventUrl = access_news_append_utm_cc($eventUrl, $utmCampaign);

        // Event date-time is stored as array of 'value' and
        // 'end_value' in UTC format.
        $startDateTime = $enode->date[0]->getValue()['value'];
        $endDateTime = $enode->date[0]->getValue()['end_value'];

        // @todo what is required to show for timezone-- zone of the event?
        // Times are stored in UTC.
        $startEvent = new DrupalDateTime($startDateTime, 'UTC');
        $startEvent->setTimezone(new \DateTimeZone('America/New_York'));

        $endEvent = new DrupalDateTime($endDateTime, 'UTC');
        $endEvent->setTimezone(new \DateTimeZone('America/New_York'));

        if ($startEvent->format('dmy') == $endEvent->format('dmy')) {
          $endDisplay = $endEvent->format('g:i a');
        }
        else {
          $endDisplay = $endEvent->format('n/j/Y g:i a');
        }

        // Include end date only if different
        // display ex: 2/21/2023 4:00 PM - 6:30 PM EST.
        $date = new DateTime("now", new DateTimeZone("America/New_York"));
        // EST or EDT.
        $tz = $date->format('T');

        $dateTimeDisp = $startEvent->format('n/j/Y g:i a')
          . ' - ' . $endDisplay . " " . $tz;

        // Inheritance computed field — instance override falls back to series.
        $summary = $enode->get('event_summary')->value;
        if ($summary == NULL) {
          if (empty($enode->description[0])) {
            $body = '';
          }
          else {
            /** @var \Drupal\Core\Field\FieldItemInterface $description_item */
            $description_item = $enode->description[0];
            $body = $description_item->view('rollup_list');
          }
          $body = \Drupal::service('renderer')->renderInIsolation($body);
        }
        else {
          $body = '<p>' . $summary . '</p>';
        }
        $bodyDisp = $body;

        // $location = empty($enode->location[0]) ? '' :
        // $enode->location[0]->view('rollup_list');
        // $locationDisp = \Drupal::service('renderer')
        // ->renderInIsolation($location);
        if ($recur_type == 'weekly_recurring_date') {
          $weekly_id[$series_id][] = [
            'title' => $title,
            'date' => $dateTimeDisp,
            'url' => $eventUrl,
          ];
          continue;
        }

        if ($recur_type == 'monthly_recurring_date') {
          $monthly_id[$series_id][] = [
            'title' => $title,
            'date' => $dateTimeDisp,
            'url' => $eventUrl,
          ];
          continue;
        }

        $itemDisplay = $wrapper->eventItemHTML($title, $dateTimeDisp, $bodyDisp, $eventUrl);
      }
      catch (Exception $e) {
        // kint("EXCEPTION  at $eCount: ". $e->getMessage());
        $itemDisplay = 'Error retrieving event item ' . $e->getMessage();
      }

      $listDisplay = $listDisplay . $itemDisplay;
    } // end for
    if (count($weekly_id)) {
      $listDisplay .= $wrapper->sectionSubHeadHTML(t("Weekly"));
      $listDisplay .= access_news_office_hours($weekly_id, $utmCampaign);
    }

    if (count($monthly_id)) {
      $listDisplay .= $wrapper->sectionSubHeadHTML(t("Monthly"));
      $listDisplay .= access_news_office_hours($monthly_id, $utmCampaign);
    }

    $sectionHeader = $wrapper->sectionHeadHTML($type_title);
    $listDisplay = $listDisplay != "" ? $sectionHeader . $listDisplay : '';
  }
  catch (Exception $e) {
    $listDisplay = 'Error retrieving events: ' . $e->getMessage();
  }
  return $listDisplay;
}

/**
 * Appends Constant Contact utm_campaign tracking parameters to a URL.
 *
 * @param string $url
 *   The URL to append tracking parameters to.
 * @param string $utmCampaign
 *   Text for utm_campaign=.
 *
 * @return string
 *   The URL with tracking parameters appended.
 */
function access_news_append_utm_cc(string $url, string $utmCampaign): string {
  return ($url . '?utm_source=constantcontact&utm_medium=email&utm_campaign=' . $utmCampaign);
}

/**
 * Implements hook_cron().
 *
 * Do the weekly news and events rollup if it's time.
 */
function access_news_cron(): void {
  try {
    if (access_news_cron_should_run()) {

      // Ny timezone.
      $currentTime = \Drupal::time()->getCurrentTime();
      \Drupal::state()->set('access_news.crontime-rollupnews', $currentTime);
      access_news_weekly_news_report(FALSE);
    }
  }
  catch (Exception $e) {
    \Drupal::logger('cron_accessnews')->error('exception: ' . $e->getMessage());
  }
}

/**
 * Returns true if it's time to run the news+events rollup.
 *
 * Want to run on 1st and 3rd Mondays of the month after 3 am.
 * We assume the calling cron job runs every hour.
 */
function access_news_cron_should_run(): bool {

  // UTC timestamp.
  $currentTime = \Drupal::time()->getCurrentTime();
  $hour = intval(date('H', $currentTime));
  $dayOfMonth = date('j', $currentTime);
  $firstMon = date('j', strtotime("first monday of this month"));
  $thirdMon = date('j', strtotime("third monday of this month"));

  if (($dayOfMonth == $firstMon || $dayOfMonth == $thirdMon) && $hour > 7) {

    $lastRun = \Drupal::state()->get('access_news.crontime-rollupnews', 0);
    $hoursDiff = round(($currentTime - $lastRun) / 3600, 1);

    // Run if it hasn't been run this day already.
    if ($hoursDiff > 24) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Helper function to build a URL for an entity using a specific domain.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity (node, eventseries, or eventinstance) to get the URL for.
 * @param string|null $domain_id
 *   The domain ID to use for building the URL.
 *
 * @return string
 *   The full URL with domain.
 */
function _access_news_build_url_for_domain(EntityInterface $entity, ?string $domain_id): string {
  $path = $entity->toUrl()->toString();

  // Under Domain Source, toString() may already be an absolute URL (rewritten
  // to the entity's source domain). Return it unchanged so the host is not
  // prepended twice (e.g. https://ccmnet.orghttps://ccmnet.org/...).
  if (UrlHelper::isExternal($path)) {
    return $path;
  }

  try {
    /** @var \Drupal\domain\Entity\Domain|null $domain */
    $domain = \Drupal::entityTypeManager()
      ->getStorage('domain')
      ->load($domain_id);

    if ($domain) {
      return $domain->buildUrl($path);
    }

    // Fallback to ACCESS Support URL if domain load fails.
    return AccessNewsInterface::SUPPORT_URL . $path;
  }
  catch (\Exception $e) {
    \Drupal::logger('access_news')
      ->error('Error building URL for domain: ' . $e->getMessage());
    return AccessNewsInterface::SUPPORT_URL . $path;
  }
}

/**
 * Implements hook_theme().
 *
 * @phpstan-param array<string, mixed> $existing
 * @phpstan-return array<string, mixed>
 */
function access_news_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'requestnews_block' => [
      'variables' => [''],
    ],
    'newsandevents_block' => [
      'variables' => [
        'latest_news_block' => NULL,
        'latest_events_block' => NULL,
      ],
    ],
  ];
}
