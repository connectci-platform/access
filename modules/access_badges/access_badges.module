<?php

/**
 * @file
 * Access Badges hooks.
 */

use Drupal\Core\Url;
use Drupal\user\Entity\User;
use Drupal\Core\Form\FormStateInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_form_alter().
 *
 * @phpstan-param array<string, mixed> $form
 */
function access_badges_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id == 'user_form' || $form_id == 'user_register_form') {
    // Check if user is an administator.
    $user = User::load(\Drupal::currentUser()->id());
    $roles = $user->getRoles();
    if (!in_array('administrator', $roles)) {
      $form['#attached']['library'][] = 'access_badges/hide_ief_button';
      $form['field_user_badges']['widget']['#field_title'] = '';
      $form['field_user_badges']['widget']['actions']['ief_add_existing']['#access'] = FALSE;
    }
  }
}

/**
 * Implements hook_user_presave().
 */
function access_badges_user_presave(UserInterface $user): void {
  \Drupal::service('access_badges.badge_sorter')->sortUserBadges($user);
}

/**
 * Implements hook_cron().
 */
function access_badges_cron(): void {
  // Run this cron job every day at 4am.
  $currentTime = \Drupal::time()->getCurrentTime();
  $hour = date('H', $currentTime);
  $min = date('i', $currentTime);

  // Cron runs every 10 minutes.
  if ($hour == 4 && $min < 20) {
    $badge_tools = \Drupal::service('access_badges.badgeTools');
    // Get 'New to ACCESS' term id.
    $new_to_access = $badge_tools->getBadgeTid('New to ACCESS');

    // User entity lookup that were created 90 days or less ago and has
    // access-ci.org in their name.
    $users = $badge_tools->getAccessUsers();

    // Set badges for users.
    $badge_tools->setBadges($new_to_access, $users);

    // Get 'Affinity Group Coordinator' term id.
    $ag_group_coordinator = $badge_tools->getBadgeTid('Affinity Group Coordinator');

    // Lookup users with 'affinity_group_leader' role.
    $ag_users = $badge_tools->getAgRoleUsers();

    // Set badges for ag_users.
    $badge_tools->setBadges($ag_group_coordinator, $ag_users);

    // Lookup users that have submitted the CSSN webform in the last 90 days.
    $submission_users = $badge_tools->getNewCssnUsers();

    // Get 'New to CSSN' term id.
    $new_to_cssn = $badge_tools->getBadgeTid('New to CSSN');

    // Set badges for submission_users.
    $badge_tools->setBadges($new_to_cssn, $submission_users);

  }
}

/**
 * Implements hook_user_insert().
 *
 * Auto-assigns badges from pending queue when a new user registers
 * with a matching email address (exact match, case-insensitive via collation).
 */
function access_badges_user_insert(UserInterface $account): void {
  $email = $account->getEmail();
  if (empty($email)) {
    return;
  }

  $database = \Drupal::database();
  $pending_rows = $database->select('access_badges_pending', 'p')
    ->fields('p')
    ->condition('p.email', $email)
    ->execute()
    ->fetchAll();

  if (empty($pending_rows)) {
    return;
  }

  $badge_tools = \Drupal::service('access_badges.badgeTools');

  foreach ($pending_rows as $row) {
    $assigned = $badge_tools->assignBadgeToUser($account->id(), $row->badge_tid, $row->vocabulary);
    if ($assigned) {
      $database->delete('access_badges_pending')
        ->condition('id', $row->id)
        ->execute();
      \Drupal::logger('access_badges')->info('Auto-assigned badge @tid to user @uid via pending email match.', [
        '@tid' => $row->badge_tid,
        '@uid' => $account->id(),
      ]);
    }
    else {
      \Drupal::logger('access_badges')->warning('Badge @tid assignment failed for user @uid; pending row @id retained.', [
        '@tid' => $row->badge_tid,
        '@uid' => $account->id(),
        '@id' => $row->id,
      ]);
    }
  }
}

/**
 * Implements hook_mail().
 *
 * @phpstan-param array<string, mixed> $message
 * @phpstan-param array<string, mixed> $params
 */
function access_badges_mail(string $key, array &$message, array $params): void {
  if ($key === 'pending_match_digest') {
    $message['subject'] = t('Badge Assignments: New matches need review');

    $lines = [];
    $lines[] = t('The following pending badge assignments have new user matches:');
    $lines[] = '';

    foreach ($params['matches'] as $match) {
      $lines[] = t('- @csv_name (@csv_email) matched to @matched_name (@strength)', [
        '@csv_name' => $match['csv_name'],
        '@csv_email' => $match['csv_email'],
        '@matched_name' => $match['matched_name'],
        '@strength' => $match['strength'],
      ]);
    }

    $lines[] = '';
    $review_url = Url::fromRoute('access_badges.review', [], ['absolute' => TRUE])->toString();
    $lines[] = t('Review these matches at: @url', ['@url' => $review_url]);

    $message['body'] = $lines;
  }
}
